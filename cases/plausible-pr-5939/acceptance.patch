diff --git a/test/benchmark_regression_test.exs b/test/benchmark_regression_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_regression_test.exs
@@ -0,0 +1,24 @@
+defmodule Plausible.Benchmark.DomainPermissionTest do
+  use PlausibleWeb.ConnCase, async: false
+  import Phoenix.LiveViewTest
+
+  setup [:create_user, :log_in]
+
+  test "guest viewers cannot mount the domain-change form", %{conn: conn, user: user} do
+    site = new_site()
+    add_guest(site, user: user, role: :viewer)
+    assert_raise Ecto.NoResultsError, fn -> live(conn, "/#{site.domain}/change-domain") end
+    assert Plausible.Repo.reload!(site).domain == site.domain
+  end
+
+  test "team viewers cannot mount the domain-change form", %{conn: conn, user: user} do
+    site = new_site()
+    add_member(site.team, user: user, role: :viewer)
+    assert_raise Ecto.NoResultsError, fn -> live(conn, "/#{site.domain}/change-domain") end
+  end
+
+  test "an unrelated user cannot mount the domain-change form", %{conn: conn} do
+    site = new_site()
+    assert_raise Ecto.NoResultsError, fn -> live(conn, "/#{site.domain}/change-domain") end
+  end
+end
