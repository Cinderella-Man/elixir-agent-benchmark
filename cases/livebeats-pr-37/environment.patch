diff --git a/test/benchmark/server.exs b/test/benchmark/server.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark/server.exs
@@ -0,0 +1,49 @@
+# Local browser fixture: real application, endpoint, session signing and database.
+Application.put_env(:live_beats, LiveBeatsWeb.Endpoint,
+  Keyword.merge(Application.get_env(:live_beats, LiveBeatsWeb.Endpoint),
+    server: true, check_origin: false, http: [ip: {127, 0, 0, 1}, port: 4002]))
+{:ok, _} = Application.ensure_all_started(:live_beats)
+Logger.configure(level: :warning)
+Ecto.Adapters.SQL.Sandbox.mode(LiveBeats.Repo, :auto)
+import Plug.Conn
+alias LiveBeats.{Repo, Accounts.User, MediaLibrary.Song}
+Repo.delete_all(Song)
+Repo.delete_all(LiveBeats.Accounts.Identity)
+Repo.delete_all(User)
+
+uploads = Path.dirname(LiveBeats.MediaLibrary.local_filepath("fixture.wav"))
+File.mkdir_p!(uploads)
+# Two minutes of generated PCM audio, with no external content or codecs.
+samples = :binary.copy(<<0::little-signed-16>>, 8_000 * 120)
+size = byte_size(samples)
+wav = <<"RIFF", (size + 36)::little-32, "WAVEfmt ", 16::little-32, 1::little-16,
+  1::little-16, 8_000::little-32, 16_000::little-32, 2::little-16, 16::little-16,
+  "data", size::little-32, samples::binary>>
+{:ok, ip} = EctoNetwork.INET.cast("127.0.0.1")
+
+cookie_for = fn user ->
+  conn = Plug.Test.conn(:get, "/")
+  |> Map.put(:secret_key_base, LiveBeatsWeb.Endpoint.config(:secret_key_base))
+  |> Plug.Session.call(Plug.Session.init(store: :cookie, key: "_live_beats_key_v1", signing_salt: "9OALgV62"))
+  |> fetch_session()
+  |> LiveBeatsWeb.UserAuth.log_in_user(user)
+  conn.resp_cookies["_live_beats_key_v1"].value
+end
+
+profiles = for n <- 1..6 do
+  user = Repo.insert!(%User{username: "listener#{n}", email: "listener#{n}@example.test",
+    name: "Local listener #{n}", profile_tagline: "Local songs", songs_count: 2,
+    avatar_url: "/favicon.ico", external_homepage_url: "http://127.0.0.1:4002/"})
+  songs = for {title, artist, index} <- [{"Morning Glass", "Lena North", 1}, {"Evening River", "Orion South", 2}] do
+    filename = "fixture-#{n}-#{index}.wav"
+    filepath = LiveBeats.MediaLibrary.local_filepath(filename)
+    File.write!(filepath, wav)
+    song = Repo.insert!(%Song{user_id: user.id, artist: artist, title: title, duration: 120,
+      mp3_url: "http://127.0.0.1:4002/files/#{filename}", mp3_filename: filename,
+      mp3_filepath: filepath, mp3_filesize: byte_size(wav), server_ip: ip, status: :stopped})
+    %{id: song.id, title: title, artist: artist, filename: filename}
+  end
+  %{username: user.username, cookie: cookie_for.(user), songs: songs}
+end
+IO.puts("EAB_BROWSER_READY " <> Jason.encode!(%{profiles: profiles}))
+Process.sleep(:infinity)
diff --git a/test/benchmark/browser_helpers.mjs b/test/benchmark/browser_helpers.mjs
new file mode 100644
--- /dev/null
+++ b/test/benchmark/browser_helpers.mjs
@@ -0,0 +1,79 @@
+import {spawn, execFileSync} from 'node:child_process';
+import {once} from 'node:events';
+import assert from 'node:assert/strict';
+const {chromium} = await import(process.env.EAB_BROWSER_MODULE);
+
+export async function startFixture() {
+  // Rebuild edited JavaScript after the grader has applied the submitted patch.
+  execFileSync('mix', ['esbuild', 'default'], {timeout:60000, stdio:'pipe'});
+  const server = spawn('mix', ['run', '--no-start', 'test/benchmark/server.exs'], {detached:true, stdio:['ignore','pipe','pipe']});
+  let output = '';
+  const ready = new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('Local application setup did not become ready: ' + output.slice(-6000))), 60000);
+    server.stdout.on('data', data => {
+      output += data;
+      const line = output.split('\n').find(x => x.startsWith('EAB_BROWSER_READY '));
+      if (line) {clearTimeout(timer); resolve(JSON.parse(line.slice('EAB_BROWSER_READY '.length)));}
+    });
+    server.stderr.on('data', data => {output += data;});
+    server.once('exit', code => {clearTimeout(timer); reject(new Error(`Application setup exited ${code}: ${output.slice(-6000)}`));});
+  });
+  let browser;
+  const close = async () => {
+    if (browser) await browser.close();
+    if (server.exitCode === null) {
+      const exited = once(server, 'exit');
+      try {process.kill(-server.pid, 'SIGTERM');} catch(error) {if(error.code !== 'ESRCH') throw error;}
+      await exited;
+    }
+  };
+  try {
+    const data = await ready;
+    browser = await chromium.launch({headless:true, args:['--no-sandbox']});
+    let next = 0;
+    return {browser, data, close, async page({mediaSession = true, profileIndex} = {}) {
+      const profile = data.profiles[profileIndex ?? next++];
+      assert.ok(profile, 'Fixture profile exists');
+      const context = await browser.newContext();
+      if (!mediaSession) await context.addInitScript(() => {delete Navigator.prototype.mediaSession;});
+      // External avatar/region imagery is unrelated to the local product workflow.
+      await context.route('**/*', route => {
+        const url = new URL(route.request().url());
+        return ['127.0.0.1','localhost'].includes(url.hostname) ? route.continue() : route.abort();
+      });
+      await context.addCookies([{name:'_live_beats_key_v1',value:profile.cookie,url:'http://127.0.0.1:4002'}]);
+      const page = await context.newPage();
+      page.setDefaultTimeout(10000);
+      const errors = [];
+      page.on('pageerror', error => errors.push(error.message));
+      await page.goto(`http://127.0.0.1:4002/${profile.username}`);
+      await page.waitForSelector('#player.phx-connected');
+      await page.waitForSelector('[data-phx-main].phx-connected');
+      await page.locator(`#song-${profile.songs[0].id}`).waitFor();
+      return {page, context, profile, errors};
+    }};
+  } catch(error) {await close(); throw error;}
+}
+
+export async function playSong(page, song) {
+  await page.locator(`#song-${song.id} td`).first().click();
+  // The ordinary click triggers LiveView -> PubSub -> player -> real audio.
+  await page.waitForFunction(filename => {
+    const audio = document.querySelector('#audio-player audio');
+    const prompt = document.querySelector('#enable-audio-confirm');
+    return audio?.src.includes(filename) && ((!audio.paused && audio.readyState >= 2) || (prompt && prompt.getClientRects().length > 0));
+  }, song.filename);
+  const listen = page.getByRole('button', {name:'Listen Now', exact:true});
+  if (await listen.isVisible()) await listen.click();
+  await page.waitForFunction(filename => {
+    const audio = document.querySelector('#audio-player audio');
+    return audio && audio.src.includes(filename) && !audio.paused && audio.readyState >= 2;
+  }, song.filename);
+}
+export async function stopListening(page) {
+  await page.getByRole('button', {name:'Stop Listening', exact:true}).click();
+  await page.waitForFunction(() => {
+    const audio = document.querySelector('#audio-player audio');
+    return audio.paused && audio.currentTime === 0 && !document.querySelector('#audio-player h2').textContent.trim();
+  });
+}
diff --git a/test/benchmark/preservation.mjs b/test/benchmark/preservation.mjs
new file mode 100644
--- /dev/null
+++ b/test/benchmark/preservation.mjs
@@ -0,0 +1,41 @@
+import {before, after, test} from 'node:test';
+import assert from 'node:assert/strict';
+import {startFixture, playSong, stopListening} from './browser_helpers.mjs';
+let fixture;
+before(async () => {fixture = await startFixture();});
+after(async () => {if(fixture) await fixture.close();});
+
+test('ordinary audio can play pause resume and stop', async () => {
+  const {page, context, profile, errors} = await fixture.page();
+  try {
+    await playSong(page, profile.songs[0]);
+    await page.locator('#audio-player').getByRole('button', {name:'Pause',exact:true}).click();
+    await page.waitForFunction(() => document.querySelector('#audio-player audio').paused);
+    await page.locator('#audio-player').getByRole('button', {name:'Play',exact:true}).click();
+    await page.waitForFunction(() => !document.querySelector('#audio-player audio').paused);
+    await stopListening(page);
+    assert.deepEqual(errors, []);
+  } finally {await context.close();}
+});
+
+test('profiles require a session and other listeners cannot control the owner songs', async () => {
+  const anonymous = await fixture.browser.newContext();
+  try {
+    const page = await anonymous.newPage();
+    await page.goto(`http://127.0.0.1:4002/${fixture.data.profiles[0].username}`);
+    assert.equal(new URL(page.url()).pathname, '/signin');
+  } finally {await anonymous.close();}
+  const {page, context, errors} = await fixture.page();
+  try {
+    const owner = fixture.data.profiles[5];
+    await page.goto(`http://127.0.0.1:4002/${owner.username}`);
+    await page.waitForSelector('#player.phx-connected');
+    await page.locator(`#song-${owner.songs[0].id} td`).first().click();
+    // Roundtrip through the real view then inspect the local audio and row.
+    await page.getByRole('button', {name:'Listen',exact:true}).click();
+    await page.getByRole('button', {name:'Stop Listening',exact:true}).waitFor();
+    assert.equal(await page.evaluate(() => document.querySelector('#audio-player audio').paused), true);
+    assert.equal(await page.locator(`#song-${owner.songs[0].id} [aria-label="Playing"]`).count(), 0);
+    assert.deepEqual(errors, []);
+  } finally {await context.close();}
+});
