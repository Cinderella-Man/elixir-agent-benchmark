+    test "long ordered list with nested bullets" do
+      for {count, indent} <- [{9, "   "}, {10, "    "}, {100, "     "}] do
+        prefix = Enum.map_join(1..(count - 1), "\n", &"#{&1}. Item")
+
+        markdown = """
+        #{prefix}
+        #{count}. Parent
+        #{indent}* Child
+        #{indent}  * Grandchild\
+        """
+
+        assert markdown == reformat(markdown)
+      end
+    end
+
+    test "long ordered list with a code block" do
+      for {count, indent} <- [{9, "   "}, {10, "    "}, {100, "     "}] do
+        prefix = Enum.map_join(1..(count - 1), "\n\n", &"#{&1}. Item")
+
+        markdown = """
+        #{prefix}
+
+        #{count}. Code
+
+        #{indent}```elixir
+        #{indent}if true do
+        #{indent}  :ok
+
+        #{indent}end
+        #{indent}```\
+        """
+
+        assert markdown == reformat(markdown)
+      end
+    end
