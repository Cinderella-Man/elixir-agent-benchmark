       assert updated.id == shared_link.id
     end
 
+    test "keeps the secret URL fixed when editing", %{conn: conn, site: site, session: session} do
+      shared_link = insert(:shared_link, site: site, name: "Original Name")
+      original_url = Plausible.Sites.shared_link_url(site, shared_link)
+      lv = get_liveview(conn, session)
+
+      lv
+      |> element(~s/button[phx-click="edit-shared-link"][phx-value-slug="#{shared_link.slug}"]/)
+      |> render_click()
+
+      lv
+      |> find_form()
+      |> render_submit(%{shared_link: %{name: "Updated Name", slug: "replacement-secret"}})
+
+      assert render(lv) =~ "Shared link saved"
+      updated = Plausible.Repo.reload!(shared_link)
+      assert updated.name == "Updated Name"
+      assert updated.slug == shared_link.slug
+      assert Plausible.Sites.shared_link_url(site, updated) == original_url
+    end
+
+    for action <- [:create, :edit],
+        selection <- [:empty, :no_selection, :invalid, :out_of_range, :nonexistent, :other_site] do
+      @action action
+      @selection selection
+      test "#{action} saves other changes without a segment for #{selection} selections", %{
+        conn: conn,
+        site: site,
+        session: session
+      } do
+        segment_id =
+          case @selection do
+            :empty ->
+              ""
+
+            :no_selection ->
+              nil
+
+            :invalid ->
+              "not-an-id"
+
+            :out_of_range ->
+              "9223372036854775808"
+
+            :nonexistent ->
+              segment = insert(:segment, type: :site, site: site, name: "Deleted")
+              Plausible.Repo.delete!(segment)
+              to_string(segment.id)
+
+            :other_site ->
+              to_string(insert(:segment, type: :site, site: insert(:site), name: "Other").id)
+          end
+
+        shared_link =
+          if @action == :edit do
+            segment = insert(:segment, type: :site, site: site, name: "Original segment")
+            insert(:shared_link, site: site, segment: segment)
+          end
+
+        lv = get_liveview(conn, session)
+
+        if shared_link do
+          lv
+          |> element(
+            ~s/button[phx-click="edit-shared-link"][phx-value-slug="#{shared_link.slug}"]/
+          )
+          |> render_click()
+        else
+          lv |> element("button#add-shared-link-button") |> render_click()
+        end
+
+        lv
+        |> find_form()
+        |> render_submit(%{
+          shared_link: %{name: "Saved Link", password: "secret123", segment_id: segment_id}
+        })
+
+        assert render(lv) =~ "Shared link saved"
+
+        saved =
+          Plausible.Repo.get_by!(Plausible.Site.SharedLink, site_id: site.id, name: "Saved Link")
+
+        assert is_nil(saved.segment_id)
+        assert saved.password_hash
+        if shared_link, do: assert(saved.id == shared_link.id)
+      end
+    end
+
+    for selection <- [:new, :existing, :made_personal] do
+      @selection selection
+      test "editing preserves valid same-site segment selections: #{selection}", %{
+        conn: conn,
+        site: site,
+        session: session
+      } do
+        segment = insert(:segment, type: :site, site: site, name: "Selected segment")
+
+        shared_link =
+          if @selection == :new do
+            insert(:shared_link, site: site)
+          else
+            insert(:shared_link, site: site, segment: segment)
+          end
+
+        if @selection == :made_personal do
+          segment |> Ecto.Changeset.change(type: :personal) |> Plausible.Repo.update!()
+        end
+
+        lv = get_liveview(conn, session)
+
+        lv
+        |> element(~s/button[phx-click="edit-shared-link"][phx-value-slug="#{shared_link.slug}"]/)
+        |> render_click()
+
+        lv
+        |> find_form()
+        |> render_submit(%{
+          shared_link: %{name: "Updated Name", segment_id: to_string(segment.id)}
+        })
+
+        assert render(lv) =~ "Shared link saved"
+        updated = Plausible.Repo.reload!(shared_link)
+        assert updated.name == "Updated Name"
+        assert updated.segment_id == segment.id
+      end
+    end
+
