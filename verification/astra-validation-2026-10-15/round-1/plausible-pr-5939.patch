       assert html =~ "Change your website domain"
     end
 
+    for membership_type <- [:team, :guest] do
+      test "#{membership_type} editors can change a site's domain", %{conn: conn, user: user} do
+        site = new_site()
+
+        case unquote(membership_type) do
+          :team -> add_member(site.team, user: user, role: :editor)
+          :guest -> add_guest(site, user: user, role: :editor)
+        end
+
+        original_domain = site.domain
+        new_domain = "new.#{original_domain}"
+        {:ok, lv, html} = live(conn, "/#{original_domain}/change-domain")
+        assert html =~ "Change your website domain"
+
+        lv
+        |> element("form")
+        |> render_submit(%{site: %{domain: new_domain}})
+
+        assert_patch(lv, "/#{URI.encode_www_form(new_domain)}/change-domain/success")
+        assert render_async(lv, 500) =~ "Domain Changed Successfully"
+
+        site = Repo.reload!(site)
+        assert site.domain == new_domain
+        assert site.domain_changed_from == original_domain
+      end
+    end
+
