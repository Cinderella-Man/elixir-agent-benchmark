diff --git a/lib/livebook/runtime/evaluator.ex b/lib/livebook/runtime/evaluator.ex
index 2343b84..644a887 100644
--- a/lib/livebook/runtime/evaluator.ex
+++ b/lib/livebook/runtime/evaluator.ex
@@ -468,8 +468,20 @@ defmodule Livebook.Runtime.Evaluator do
           identifiers_used = :unknown
           identifiers_defined = %{}
           identifier_definitions = []
-          # Empty context
+          # Discard changes from the failed evaluation, but preserve imports
+          # and process dictionary, which are stored in full rather than diffed.
           new_context = initial_context()
+
+          new_context = %{
+            new_context
+            | env: %{
+                new_context.env
+                | functions: context.env.functions,
+                  macros: context.env.macros
+              },
+              pdict: context.pdict
+          }
+
           {new_context, result, identifiers_used, identifiers_defined, identifier_definitions}
       end
 
