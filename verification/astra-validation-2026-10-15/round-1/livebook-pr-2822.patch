--- a/test/livebook/runtime/evaluator_test.exs
+++ b/test/livebook/runtime/evaluator_test.exs
@@ -362,6 +362,60 @@ defmodule Livebook.Runtime.EvaluatorTest do
                       metadata()}
     end
 
+    test "preserves imports from successful cells after an error", %{evaluator: evaluator} do
+      code1 = """
+      import Integer, only: [digits: 1, is_even: 1]
+      """
+
+      code2 = """
+      import Integer, only: []
+      raise "failed"
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, _, %{errored: false}}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      code3 = "if is_even(42), do: hd(digits(42))"
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(ansi_number(4)),
+                      metadata()}
+    end
+
+    test "preserves process dictionary from successful cells after an error",
+         %{evaluator: evaluator} do
+      code1 = """
+      Process.put(:x, 1)
+      Process.put(:y, 2)
+      """
+
+      code2 = """
+      Process.put(:x, 3)
+      Process.delete(:y)
+      Process.put(:z, 4)
+      raise "failed"
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, _, %{errored: false}}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      code3 = """
+      {1, 2, nil} = {Process.get(:x), Process.get(:y), Process.get(:z)}
+      42
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(ansi_number(42)),
+                      metadata()}
+    end
+
