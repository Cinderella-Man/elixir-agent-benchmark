diff --git a/test/livebook_web/live/app_session_live_test.exs b/test/livebook_web/live/app_session_live_test.exs
index f3a6df8..20a5055 100644
--- a/test/livebook_web/live/app_session_live_test.exs
+++ b/test/livebook_web/live/app_session_live_test.exs
@@ -114,6 +114,47 @@ defmodule LivebookWeb.AppSessionLiveTest do
     Livebook.App.close(app.pid)
   end
 
+  test "renders inputs introduced by a frame update immediately", %{conn: conn, test: test} do
+    slug = Utils.random_short_id()
+    app_settings = %{Notebook.AppSettings.new() | slug: slug}
+    frame = %{type: :frame, ref: "frame1", outputs: [], placeholder: true}
+    cell = %{Notebook.Cell.new(:code) | source: source_for_output(frame)}
+    section = %{Notebook.Section.new() | cells: [cell]}
+    notebook = %{Notebook.new() | app_settings: app_settings, sections: [section]}
+
+    Apps.subscribe()
+    {:ok, app_pid} = Apps.deploy(notebook)
+    on_exit(fn -> App.close(app_pid) end)
+
+    assert_receive {:app_updated,
+                    %{
+                      pid: ^app_pid,
+                      sessions: [
+                        %{id: session_id, pid: session_pid, app_status: %{execution: :executed}}
+                      ]
+                    }}
+
+    {:ok, view, _} = live(conn, ~p"/apps/#{slug}/#{session_id}")
+    assert render(view) =~ "Nothing here..."
+
+    input = %{
+      type: :input,
+      ref: "input_ref1",
+      id: "input1",
+      destination: test,
+      attrs: %{type: :text, default: "Initial value", label: "Name"}
+    }
+
+    output = %{type: :frame_update, ref: "frame1", update: {:replace, [input]}}
+    send(session_pid, {:runtime_evaluation_output, cell.id, output})
+    Livebook.SessionHelpers.wait_for_session_update(session_pid)
+
+    # Render once, so that frame send_update is processed.
+    _ = render(view)
+
+    assert has_element?(view, ~s/input[value="Initial value"]/)
+  end
+
   test "shows an error message when session errors", %{conn: conn, test: test} do
     slug = Livebook.Utils.random_short_id()
     app_settings = %{Livebook.Notebook.AppSettings.new() | slug: slug}
