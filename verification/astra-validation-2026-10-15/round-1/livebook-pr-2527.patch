+    test "rejects code inserted between the signed content and the stamp" do
+      {markdown, []} =
+        %{Notebook.new() | hub_secret_names: ["DB_PASSWORD"]}
+        |> Livebook.LiveMarkdown.Export.notebook_to_livemd()
+
+      {_, %{warnings: [], stamp_verified?: true}} = Import.notebook_from_livemd(markdown)
+
+      source = ~s/System.fetch_env!("LB_DB_PASSWORD")/
+
+      markdown =
+        String.replace(
+          markdown,
+          "<!-- livebook:",
+          "```elixir\n#{source}\n```\n\n<!-- livebook:"
+        )
+
+      {notebook, info} = Import.notebook_from_livemd(markdown)
+
+      assert Enum.any?(Notebook.cells_with_section(notebook), fn {cell, _section} ->
+               cell.source == source
+             end)
+
+      refute info.stamp_verified?
+      assert notebook.hub_secret_names == []
+
+      assert ["this notebook can only access environment variables defined in this machine" <> _] =
+               info.warnings
+    end
+
+    test "keeps remote files in quarantine when unsigned code is inserted before the stamp" do
+      file = Livebook.FileSystem.File.new(Livebook.FileSystem.Local.new(), p("/document.pdf"))
+
+      {markdown, []} =
+        %{
+          Notebook.new()
+          | hub_secret_names: ["DB_PASSWORD"],
+            file_entries: [%{type: :file, name: "document.pdf", file: file}]
+        }
+        |> Livebook.LiveMarkdown.Export.notebook_to_livemd()
+
+      {notebook, %{warnings: [], stamp_verified?: true}} = Import.notebook_from_livemd(markdown)
+      assert notebook.quarantine_file_entry_names == MapSet.new()
+
+      markdown =
+        String.replace(
+          markdown,
+          "<!-- livebook:{\"offset\":",
+          "```elixir\n:unsigned\n```\n\n<!-- livebook:{\"offset\":"
+        )
+
+      {notebook, info} = Import.notebook_from_livemd(markdown)
+
+      refute info.stamp_verified?
+      assert notebook.hub_secret_names == []
+      assert notebook.quarantine_file_entry_names == MapSet.new(["document.pdf"])
+    end
+
+    test "accepts whitespace around the stamp and byte offsets for Unicode content" do
+      {markdown, []} =
+        %{Notebook.new() | name: "Notebook 🐈", hub_secret_names: ["DB_PASSWORD"]}
+        |> Livebook.LiveMarkdown.Export.notebook_to_livemd()
+
+      markdown = String.replace(markdown, "<!-- livebook:", "\n \n<!-- livebook:") <> " \n\t"
+
+      {notebook, info} = Import.notebook_from_livemd(markdown)
+
+      assert info == %{warnings: [], stamp_verified?: true}
+      assert notebook.hub_secret_names == ["DB_PASSWORD"]
+    end
+
