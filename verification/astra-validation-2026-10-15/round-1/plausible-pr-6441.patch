+        response = json_response(conn, 200)
+
+        assert response["results"] == [
+                 %{"dimensions" => expected_dimensions, "metrics" => metrics}
+               ]
+
+        assert response["meta"]["imports_included"] == true
+        refute response["meta"]["imports_warning"]
+      end
+    end
+  end
