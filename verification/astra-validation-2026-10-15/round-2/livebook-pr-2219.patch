       refute content =~ "In frame"
     end
 
+    for update_type <- [:replace, :append] do
+      @tag update_type: update_type
+      test "frame #{update_type} renders new input values immediately", %{
+        conn: conn,
+        session: session,
+        update_type: update_type
+      } do
+        Session.subscribe(session.id)
+        evaluate_setup(session.pid)
+
+        section_id = insert_section(session.pid)
+        frame = %{type: :frame, ref: "frame", outputs: [], placeholder: true}
+        cell_id = insert_cell_with_output(session.pid, section_id, frame)
+
+        {:ok, view, _} = live(conn, ~p"/sessions/#{session.id}")
+        assert render(view) =~ "Nothing here..."
+
+        input = %{
+          type: :input,
+          ref: "input_ref",
+          id: "input",
+          destination: self(),
+          attrs: %{type: :text, default: "Initial value", label: "Name"}
+        }
+
+        frame_update = %{
+          type: :frame_update,
+          ref: "frame",
+          update: {update_type, [input]}
+        }
+
+        send(session.pid, {:runtime_evaluation_output, cell_id, frame_update})
+        wait_for_session_update(session.pid)
+        # Render once, so that frame send_update is processed.
+        _ = render(view)
+
+        assert has_element?(view, ~s/[data-el-outputs-container] input[value="Initial value"]/)
+
+        view
+        |> element(~s/[data-el-outputs-container] form/)
+        |> render_change(%{"html_value" => "Updated value"})
+
+        assert %{input_infos: %{"input" => %{value: "Updated value"}}} =
+                 Session.get_data(session.pid)
+
+        assert_receive {:event, "input_ref", %{value: "Updated value", type: :change}}
+      end
+    end
+
