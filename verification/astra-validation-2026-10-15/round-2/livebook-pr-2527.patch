diff --git a/test/livebook/live_markdown/import_test.exs b/test/livebook/live_markdown/import_test.exs
index 928fadc..a553fad 100644
--- a/test/livebook/live_markdown/import_test.exs
+++ b/test/livebook/live_markdown/import_test.exs
@@ -1165,6 +1165,52 @@ defmodule Livebook.LiveMarkdown.ImportTest do
       assert %Notebook{hub_secret_names: ["DB_PASSWORD"]} = notebook
     end
 
+    test "does not authorize code added after the signed source" do
+      file = Livebook.FileSystem.File.new(Livebook.FileSystem.Local.new(), p("/document.pdf"))
+
+      {markdown, []} =
+        %{
+          Notebook.new()
+          | name: "My Notebook",
+            hub_secret_names: ["DB_PASSWORD"],
+            file_entries: [%{type: :file, name: "document.pdf", file: file}]
+        }
+        |> Livebook.LiveMarkdown.Export.notebook_to_livemd()
+
+      {notebook, %{stamp_verified?: true}} = Import.notebook_from_livemd(markdown)
+      assert notebook.hub_secret_names == ["DB_PASSWORD"]
+      assert notebook.quarantine_file_entry_names == MapSet.new()
+
+      [source, stamp] = String.split(markdown, "<!-- livebook:{\"offset\":")
+      stamp = "<!-- livebook:{\"offset\":" <> stamp
+      code = "\n## Added section\n\n```elixir\nSystem.get_env(\"LB_DB_PASSWORD\")\n```\n\n"
+
+      for tampered <- [source <> code <> stamp, markdown <> code <> stamp, markdown <> code] do
+        {notebook, %{stamp_verified?: verified?}} = Import.notebook_from_livemd(tampered)
+
+        assert [%{cells: [%Cell.Code{source: "System.get_env(\"LB_DB_PASSWORD\")"}]}] =
+                 notebook.sections
+
+        refute verified?
+        assert notebook.hub_secret_names == []
+        assert notebook.quarantine_file_entry_names == MapSet.new(["document.pdf"])
+      end
+    end
+
+    test "accepts whitespace around the stamp and byte offsets for Unicode source" do
+      {markdown, []} =
+        %{Notebook.new() | name: "My Notebook 🐈", hub_secret_names: ["DB_PASSWORD"]}
+        |> Livebook.LiveMarkdown.Export.notebook_to_livemd()
+
+      markdown =
+        String.replace(markdown, "\n<!-- livebook:{\"offset\":", "\n\n<!-- livebook:{\"offset\":")
+
+      markdown = markdown <> "\n \t\r\n"
+
+      {notebook, %{warnings: [], stamp_verified?: true}} = Import.notebook_from_livemd(markdown)
+      assert notebook.hub_secret_names == ["DB_PASSWORD"]
+    end
+
