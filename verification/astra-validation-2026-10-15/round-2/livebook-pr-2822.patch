+    test "preserves inherited imports after a failed evaluation", %{evaluator: evaluator} do
+      code1 = """
+      import Integer, only: [is_even: 1]
+      import Enum, only: [sum: 1]
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, _, %{errored: false}}
+
+      code2 = """
+      import Integer, only: []
+      import Enum, only: []
+      raise "failure"
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      code3 = "if is_even(2), do: sum([1, 2, 3]), else: 0"
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(ansi_number(6)),
+                      metadata()}
+    end
+
+    test "preserves inherited process dictionary after a failed evaluation",
+         %{evaluator: evaluator} do
+      code1 = """
+      Process.put(:x, 1)
+      Process.put(:y, 2)
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, _, %{errored: false}}
+
+      code2 = """
+      Process.put(:x, 3)
+      Process.delete(:y)
+      Process.put(:z, 4)
+      raise "failure"
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      code3 = "{Process.get(:x), Process.get(:y), Process.get(:z)}"
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(result), metadata()}
+      assert clean_message(result) == "{1, 2, nil}"
+    end
+
