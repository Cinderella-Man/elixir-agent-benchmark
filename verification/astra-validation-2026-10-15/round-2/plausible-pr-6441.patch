+    end
+
+    for goal <- ["All event", "All page"] do
+      test "still includes imports for #{goal}", %{conn: conn, site: site} do
+        response =
+          conn
+          |> post("/api/v2/query", %{
+            "site_id" => site.domain,
+            "date_range" => "all",
+            "metrics" => ["visitors", "events"],
+            "dimensions" => ["event:goal"],
+            "filters" => [["is", "event:goal", [unquote(goal)]]],
+            "include" => %{"imports" => true}
+          })
+          |> json_response(200)
+
+        assert response["results"] == [
+                 %{"dimensions" => [unquote(goal)], "metrics" => [12, 22]}
+               ]
+
+        assert response["meta"]["imports_included"]
+      end
+    end
+  end
