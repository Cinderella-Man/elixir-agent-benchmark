+    on_ce do
+      test "serves cached scripts after creating and updating their configuration", %{conn: conn} do
+        site = new_site()
+        config = Tracker.get_or_create_tracker_script_configuration!(site)
+        original_script = Tracker.build_script(config)
+
+        patch_env(Plausible.Cache, enabled: true)
+
+        on_exit(fn ->
+          Plausible.Cache.Adapter.delete(PlausibleWeb.TrackerScriptCache.name(), config.id)
+        end)
+
+        assert eventually(fn ->
+                 {PlausibleWeb.TrackerScriptCache.get(config.id) == original_script, :ok}
+               end)
+
+        assert get(conn, "/js/#{config.id}.js") |> response(200) == original_script
+
+        updated_config =
+          Tracker.update_script_configuration!(site, @example_config, :installation)
+
+        # Broadcasts run asynchronously. Wait for the cache to change before requesting the script.
+        assert eventually(fn ->
+                 {PlausibleWeb.TrackerScriptCache.get(config.id) != original_script, :ok}
+               end)
+
+        updated_script = get(conn, "/js/#{config.id}.js") |> response(200)
+        assert updated_script == Tracker.build_script(updated_config)
+        assert updated_script =~ "formSubmissions:!0"
+        refute updated_script == original_script
+      end
+    end
