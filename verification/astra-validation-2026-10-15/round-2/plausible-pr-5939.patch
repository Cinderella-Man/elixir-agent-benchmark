+    for membership <- [:guest, :team] do
+      test "#{membership} editors can change the domain", %{conn: conn, site: site} do
+        editor =
+          case unquote(membership) do
+            :guest -> add_guest(site, role: :editor)
+            :team -> add_member(Repo.preload(site, :team).team, role: :editor)
+          end
+
+        {:ok, conn: conn} = log_in(%{conn: conn, user: editor})
+        original_domain = site.domain
+        new_domain = "new.#{original_domain}"
+
+        {:ok, lv, html} = live(conn, "/#{original_domain}/change-domain")
+        assert html =~ "Change your website domain"
+
+        lv
+        |> element("form")
+        |> render_submit(%{site: %{domain: new_domain}})
+
+        success_path = "/#{URI.encode_www_form(new_domain)}/change-domain/success"
+        assert_patch(lv, success_path)
+        assert render_async(lv, 500) =~ "Domain Changed Successfully"
+
+        updated_site = Repo.reload!(site)
+        assert updated_site.domain == new_domain
+        assert updated_site.domain_changed_from == original_domain
+
+        {:ok, success_lv, _html} = live(conn, success_path)
+        assert render_async(success_lv, 500) =~ "Domain Changed Successfully"
+      end
+    end
