{
  "test_files": [
    "test/benchmark_frame_contract_test.exs"
  ],
  "command": "mix test test/benchmark_frame_contract_test.exs",
  "mutants": [
    {
      "name": "numeric-inputs-only",
      "rationale": "The existing acceptance only uses a number input; text and nested inputs must also initialize.",
      "replacements": [
        {
          "path": "lib/livebook/notebook/cell.ex",
          "before": "Enum.flat_map(new_outputs, &find_inputs_in_output/1)",
          "after": "Enum.flat_map(new_outputs, &find_inputs_in_output/1) |> Enum.filter(&(&1.attrs.type == :number))",
          "count": 1
        }
      ]
    }
  ]
}
