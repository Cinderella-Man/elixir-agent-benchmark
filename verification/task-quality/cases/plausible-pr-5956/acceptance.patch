diff --git a/test/benchmark_audit_test.exs b/test/benchmark_audit_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_audit_test.exs
@@ -0,0 +1,47 @@
+defmodule Plausible.Benchmark.AuditTrackerUpdateTest do
+  use PlausibleWeb.ConnCase, async: false
+  alias PlausibleWeb.Tracker
+  alias Plausible.Cache.Adapter
+
+  setup do
+    previous = Application.fetch_env!(:plausible, Plausible.Cache)
+    Application.put_env(:plausible, Plausible.Cache, Keyword.put(previous, :enabled, true))
+    on_exit(fn -> Application.put_env(:plausible, Plausible.Cache, previous) end)
+    :ok
+  end
+
+  test "dedicated scripts follow successful writes without an external cache refresh", %{conn: conn} do
+    first_site = new_site()
+    second_site = new_site()
+    first = Tracker.get_or_create_tracker_script_configuration!(first_site, %{
+      installation_type: :manual, file_downloads: false, outbound_links: false
+    })
+    second = Tracker.get_or_create_tracker_script_configuration!(second_site, %{
+      installation_type: :manual, file_downloads: false, outbound_links: true
+    })
+
+    on_exit(fn ->
+      Adapter.delete(:tracker_script_cache, first.id)
+      Adapter.delete(:tracker_script_cache, second.id)
+    end)
+
+    assert_script(conn, first.id, first_site.domain, false, false)
+    assert_script(conn, second.id, second_site.domain, false, true)
+
+    for enabled <- [true, false, true] do
+      Tracker.update_script_configuration!(first_site, %{file_downloads: enabled}, :installation)
+      assert_script(conn, first.id, first_site.domain, enabled, false)
+      assert_script(conn, second.id, second_site.domain, false, true)
+    end
+  end
+
+  defp assert_script(conn, id, domain, downloads?, outbound?) do
+    script = get(conn, "/js/#{id}.js") |> response(200)
+    assert script =~ "window.plausible"
+    assert script =~ "domain:\"#{domain}\""
+    assert String.contains?(script, "fileDownloads:!0") == downloads?
+    assert String.contains?(script, "outboundLinks:!0") == outbound?
+    {syntax_output, syntax_status} = System.cmd("node", ["-e", "new Function(process.argv[1])", script], stderr_to_stdout: true)
+    assert syntax_status == 0, "dedicated script must parse as JavaScript: #{syntax_output}"
+  end
+end
