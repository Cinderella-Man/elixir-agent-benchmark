diff --git a/test/benchmark_list_structure_test.exs b/test/benchmark_list_structure_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_list_structure_test.exs
@@ -0,0 +1,29 @@
+defmodule Livebook.Benchmark.ListStructureTest do
+  use ExUnit.Case, async: true
+  alias Livebook.LiveMarkdown.MarkdownHelpers
+
+  test "nested content retains its AST across decimal boundaries and repeated round trips" do
+    source = Enum.map_join(1..105, "\n", fn n ->
+      indent = String.duplicate(" ", byte_size(Integer.to_string(n)) + 2)
+      parent = "#{n}. Parent #{n}"
+      cond do
+        n in [9, 99] -> parent <> "\n#{indent}* Nested child #{n}\n#{indent}  * Grandchild #{n}"
+        n in [10, 100] -> parent <> "\n#{indent}```elixir\n#{indent}IO.puts(#{n})\n#{indent}```"
+        true -> parent
+      end
+    end)
+
+    {:ok, original_ast, []} = MarkdownHelpers.markdown_to_block_ast(source)
+    first = MarkdownHelpers.markdown_from_ast(original_ast)
+    {:ok, first_ast, []} = MarkdownHelpers.markdown_to_block_ast(first)
+    assert semantic_ast(first_ast) == semantic_ast(original_ast)
+    second = MarkdownHelpers.markdown_from_ast(first_ast)
+    assert second == first
+    {:ok, second_ast, []} = MarkdownHelpers.markdown_to_block_ast(second)
+    assert semantic_ast(second_ast) == semantic_ast(original_ast)
+  end
+
+  defp semantic_ast(nodes) when is_list(nodes), do: Enum.map(nodes, &semantic_ast/1)
+  defp semantic_ast({tag, attrs, children, _metadata}), do: {tag, attrs, semantic_ast(children)}
+  defp semantic_ast(text), do: text
+end
