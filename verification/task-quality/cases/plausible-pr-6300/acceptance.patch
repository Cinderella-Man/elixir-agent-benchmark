diff --git a/test/benchmark_audit_test.exs b/test/benchmark_audit_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_audit_test.exs
@@ -0,0 +1,34 @@
+defmodule Plausible.Benchmark.AuditComparisonLeapYearTest do
+  use Plausible.DataCase
+  alias Plausible.Stats.{QueryBuilder, Comparisons}
+
+  setup [:create_user, :create_site]
+
+  test "short-period weekday comparisons account for leap years", %{site: site} do
+    for {period, first, last} <- [
+          {:day, ~U[2023-03-17 00:00:00Z], ~U[2023-03-17 18:30:00Z]},
+          {:"24h", ~U[2023-03-16 18:30:00Z], ~U[2023-03-17 18:30:00Z]}
+        ] do
+      query = QueryBuilder.build!(site,
+        metrics: [:visitors], input_date_range: period,
+        include: [compare: :year_over_year, compare_match_day_of_week: true],
+        now: ~U[2024-03-15 18:30:00Z]
+      )
+      comparison = Comparisons.get_comparison_query(query)
+      assert comparison.utc_time_range.first == first
+      assert comparison.utc_time_range.last == last
+    end
+  end
+
+  test "weekday matching preserves local day boundaries east of UTC" do
+    site = insert(:site, timezone: "Asia/Kolkata")
+    query = QueryBuilder.build!(site,
+      metrics: [:visitors], input_date_range: :day,
+      include: [compare: :year_over_year, compare_match_day_of_week: true],
+      now: ~U[2024-03-15 00:30:00Z]
+    )
+    comparison = Comparisons.get_comparison_query(query)
+    assert comparison.utc_time_range.first == ~U[2023-03-16 18:30:00Z]
+    assert comparison.utc_time_range.last == ~U[2023-03-17 00:30:00Z]
+  end
+end
diff --git a/test/reference_challenge_test.exs b/test/reference_challenge_test.exs
new file mode 100644
--- /dev/null
+++ b/test/reference_challenge_test.exs
@@ -0,0 +1,19 @@
+defmodule Plausible.Benchmark.AuditComparisonDstChallengeTest do
+  use Plausible.DataCase
+  alias Plausible.Stats.{QueryBuilder, Comparisons}
+
+  test "Today weekday matching remains on Monday across unequal DST transition dates" do
+    site = insert(:site, timezone: "US/Eastern")
+    query = QueryBuilder.build!(site,
+      metrics: [:visitors], input_date_range: :day,
+      include: [compare: :year_over_year, compare_match_day_of_week: true],
+      now: ~U[2023-03-13 18:30:00Z]
+    )
+    comparison = Comparisons.get_comparison_query(query)
+
+    # March 13, 2023 is Monday; the corresponding Monday is March 14, 2022.
+    # Both dates are in EDT. Preserve the site's midnight-to-14:30 range.
+    assert comparison.utc_time_range.first == ~U[2022-03-14 04:00:00Z]
+    assert comparison.utc_time_range.last == ~U[2022-03-14 18:30:00Z]
+  end
+end
