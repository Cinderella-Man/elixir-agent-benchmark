diff --git a/test/benchmark_stamp_contract_test.exs b/test/benchmark_stamp_contract_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_stamp_contract_test.exs
@@ -0,0 +1,37 @@
+defmodule Livebook.Benchmark.StampContractTest do
+  use ExUnit.Case, async: true
+  alias Livebook.LiveMarkdown.{Export, Import}
+  alias Livebook.Notebook
+
+  setup do
+    cell = %{Notebook.Cell.new(:code) | source: "IO.puts(\"original\")"}
+    section = %{Notebook.Section.new() | name: "Original section", cells: [cell]}
+    notebook = %{Notebook.new() | name: "Café notebook", sections: [section], hub_secret_names: ["AUDIT_SECRET"]}
+    {source, []} = Export.notebook_to_livemd(notebook)
+    [body, stamp] = String.split(source, "<!-- livebook:{\"offset\":", parts: 2)
+    %{source: source, body: body, stamp: "<!-- livebook:{\"offset\":" <> stamp}
+  end
+
+  test "a freshly signed unicode notebook and harmless stamp whitespace verify",
+       %{source: source, body: body, stamp: stamp} do
+    for candidate <- [source, body <> "\n \t\n" <> stamp] do
+      {notebook, info} = Import.notebook_from_livemd(candidate)
+      assert info.stamp_verified?
+      assert info.warnings == []
+      assert notebook.hub_secret_names == ["AUDIT_SECRET"]
+    end
+  end
+
+  for {language, added_source} <- [{"elixir", "IO.puts(:added)"}, {"erlang", "io:format(\"added\")."}] do
+    test "inserted #{language} code is imported without retaining stamp authorization",
+         %{body: body, stamp: stamp} do
+      addition = "\n```" <> unquote(language) <> "\n" <> unquote(added_source) <> "\n```\n\n"
+      {notebook, info} = Import.notebook_from_livemd(body <> addition <> stamp)
+      refute info.stamp_verified?
+      assert notebook.hub_secret_names == []
+      assert Enum.any?(info.warnings, &String.contains?(&1, "this notebook can only access environment variables"))
+      cells = Enum.flat_map(notebook.sections, & &1.cells)
+      assert Enum.any?(cells, &(is_struct(&1, Notebook.Cell.Code) and &1.source == unquote(added_source)))
+    end
+  end
+end
