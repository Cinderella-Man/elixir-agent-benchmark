diff --git a/test/benchmark_s3_validation_test.exs b/test/benchmark_s3_validation_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_s3_validation_test.exs
@@ -0,0 +1,41 @@
+defmodule Livebook.Benchmark.S3ValidationTest do
+  use LivebookWeb.ConnCase, async: true
+  import Phoenix.LiveViewTest
+  import Livebook.HubHelpers
+  alias Livebook.Hubs
+
+  setup do
+    %{hub: Hubs.fetch_hub!(Hubs.Personal.id())}
+  end
+
+  test "missing displayed credentials keeps the form invalid and does not save",
+       %{conn: conn, hub: hub} do
+    bypass = Bypass.open()
+    file_system = build_bypass_file_system(bypass)
+    attrs = %{file_system: %{bucket_url: file_system.bucket_url, region: "auto", access_key_id: "audit-access", secret_access_key: ""}}
+    {:ok, view, _} = live(conn, ~p"/hub/#{hub.id}/file-systems/new")
+    view |> element("#file-systems-form") |> render_change(attrs)
+    assert has_element?(view, "#file-systems-form button[disabled]")
+    assert render(view) =~ "be blank"
+    refute Enum.any?(Hubs.get_file_systems(hub), &(&1.id == file_system.id))
+  end
+
+  test "failed S3 connectivity displays an error without persisting storage",
+       %{conn: conn, hub: hub} do
+    bypass = Bypass.open()
+    file_system = build_bypass_file_system(bypass)
+    attrs = %{file_system: Map.take(Map.from_struct(file_system), [:bucket_url, :region, :access_key_id, :secret_access_key])}
+    Bypass.expect_once(bypass, "GET", "/mybucket", fn conn ->
+      conn
+      |> Plug.Conn.put_resp_content_type("application/xml")
+      |> Plug.Conn.resp(403, "<Error><Code>AccessDenied</Code><Message>Audit denied</Message></Error>")
+    end)
+    {:ok, view, _} = live(conn, ~p"/hub/#{hub.id}/file-systems/new")
+    view |> element("#file-systems-form") |> render_change(attrs)
+    refute has_element?(view, "#file-systems-form button[disabled]")
+    view |> element("#file-systems-form") |> render_submit(attrs)
+    assert render(view) =~ "Connection test failed"
+    assert has_element?(view, "#file-systems-form")
+    refute Enum.any?(Hubs.get_file_systems(hub), &(&1.id == file_system.id))
+  end
+end
