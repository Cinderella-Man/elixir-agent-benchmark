{
  "test_files": [
    "test/benchmark_s3_validation_test.exs"
  ],
  "command": "mix test test/benchmark_s3_validation_test.exs",
  "mutants": [
    {
      "name": "ignore-s3-connectivity-failure",
      "rationale": "The success-only original tests cannot reject a form that saves storage after a failed connection.",
      "replacements": [
        {
          "path": "lib/livebook_web/live/hub/file_system_form_component.ex",
          "before": "{:error, message} -> {:error, \"Connection test failed: \" <> message}",
          "after": "{:error, _message} -> :ok",
          "count": 1
        }
      ]
    },
    {
      "name": "skip-secret-field-validation",
      "rationale": "The current form suite has no invalid-credential case.",
      "replacements": [
        {
          "path": "lib/livebook/file_system/s3.ex",
          "before": "_ -> validate_required(changeset, [:access_key_id, :secret_access_key])",
          "after": "_ -> validate_required(changeset, [:access_key_id])",
          "count": 1
        }
      ]
    }
  ]
}
