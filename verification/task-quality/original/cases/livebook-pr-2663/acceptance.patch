diff --git a/test/benchmark_long_list_test.exs b/test/benchmark_long_list_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_long_list_test.exs
@@ -0,0 +1,15 @@
+defmodule Livebook.Benchmark.LongListTest do
+  use ExUnit.Case, async: true
+  alias Livebook.LiveMarkdown.MarkdownHelpers
+
+  test "three-digit numbered parents retain nested bullets and code over repeated formatting" do
+    markdown = Enum.map_join(1..99, "\n", fn n -> "#{n}. Item #{n}" end) <>
+      "\n100. Item 100\n     * Nested child\n101. Item 101\n     ```\n     IO.puts(:ok)\n     ```"
+
+    {:ok, ast, []} = MarkdownHelpers.markdown_to_block_ast(markdown)
+    rendered = MarkdownHelpers.markdown_from_ast(ast)
+    assert rendered == markdown
+    {:ok, reloaded, []} = MarkdownHelpers.markdown_to_block_ast(rendered)
+    assert MarkdownHelpers.markdown_from_ast(reloaded) == rendered
+  end
+end
