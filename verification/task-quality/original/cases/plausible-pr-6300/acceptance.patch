diff --git a/test/benchmark_regression_test.exs b/test/benchmark_regression_test.exs
new file mode 100644
--- /dev/null
+++ b/test/benchmark_regression_test.exs
@@ -0,0 +1,28 @@
+defmodule Plausible.Benchmark.DateComparisonTest do
+  use Plausible.DataCase
+  alias Plausible.Stats.QueryBuilder
+
+  setup [:create_user, :create_site]
+
+  test "weekday comparison returns the matching day's stored visitors", %{site: site} do
+    populate_stats(site, [
+      build(:pageview, user_id: 1, timestamp: ~N[2023-03-15 12:00:00]),
+      build(:pageview, user_id: 2, timestamp: ~N[2022-03-15 12:00:00]),
+      build(:pageview, user_id: 3, timestamp: ~N[2022-03-16 12:00:00]),
+      build(:pageview, user_id: 4, timestamp: ~N[2022-03-16 13:00:00]),
+      build(:pageview, user_id: 5, timestamp: ~N[2022-03-16 19:00:00])
+    ])
+
+    for {match?, expected} <- [{true, 2}, {false, 1}] do
+      query = QueryBuilder.build!(site,
+        metrics: [:visitors],
+        input_date_range: :day,
+        include: [compare: :year_over_year, compare_match_day_of_week: match?],
+        now: ~U[2023-03-15 18:30:00Z]
+      )
+
+      assert %{results: %{visitors: %{value: 1, comparison_value: ^expected}}} =
+        Plausible.Stats.aggregate(site, query, [:visitors])
+    end
+  end
+end
