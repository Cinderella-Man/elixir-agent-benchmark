     {:ok, [access_token: access_token, user: user, project: project, revision: revision, language: french_language]}
   end
 
+  for {requested, expected, literal} <- [
+        {"~> 1.1", "v1.10.0", nil},
+        {"~> 1.1", "~> 1.1", "~> 1.1"},
+        {"master", "master", nil},
+        {nil, nil, nil}
+      ] do
+    test "merge selects #{inspect(requested)} with literal #{inspect(literal)}", context do
+      %{conn: conn, project: project, revision: revision, user: user, language: language, access_token: access_token} = context
+      {document, translations} = AccentTest.VersionFixtures.translations(project, revision, user, unquote(literal))
+      selected = translations[unquote(expected)]
+      body = %{file: file(), merge_type: "force", project_id: project.id, language: language.slug, document_format: document.format, document_path: document.path}
+      body = if unquote(requested), do: Map.put(body, :version, unquote(requested)), else: body
+
+      expect(Accent.Hook.BroadcasterMock, :notify, fn %{event: "merge"} -> :ok end)
+
+      response =
+        conn
+        |> put_req_header("authorization", "Bearer #{access_token.token}")
+        |> post(merge_path(conn, []), body)
+
+      assert response.status == 200
+      assert Repo.get!(Translation, selected.id).corrected_text == "F"
+
+      for {_tag, translation} <- translations, translation.id != selected.id do
+        assert Repo.get!(Translation, translation.id) == translation
+      end
+
+      assert Repo.aggregate(Translation, :count, :id) == map_size(translations)
+    end
+  end
+
+  for requested <- ["~> 3.0", "~> 1.99", "not a requirement"] do
+    test "merge rejects unmatched version #{requested}", context do
+      %{conn: conn, project: project, revision: revision, user: user, language: language, access_token: access_token} = context
+      {document, translations} = AccentTest.VersionFixtures.translations(project, revision, user)
+      body = %{version: unquote(requested), file: file(), project_id: project.id, language: language.slug, document_format: document.format, document_path: document.path}
+
+      response =
+        conn
+        |> put_req_header("authorization", "Bearer #{access_token.token}")
+        |> post(merge_path(conn, []), body)
+
+      assert response.status == 422
+      assert response.resp_body == "unknown version"
+      assert Repo.all(Operation) == []
+      assert MapSet.new(Repo.all(Translation)) == MapSet.new(Map.values(translations))
+    end
+  end
+
   test "merge default", %{user: user, access_token: access_token, conn: conn, project: project, revision: revision, language: language} do
     document = %Document{project_id: project.id, path: "test2", format: "json"} |> Repo.insert!()
