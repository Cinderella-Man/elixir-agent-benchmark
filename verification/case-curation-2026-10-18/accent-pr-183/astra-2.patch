diff --git a/lib/accent/version_resolver.ex b/lib/accent/version_resolver.ex
new file mode 100644
index 0000000..7dd5905
--- /dev/null
+++ b/lib/accent/version_resolver.ex
@@ -0,0 +1,56 @@
+defmodule Accent.VersionResolver do
+  alias Accent.Repo
+  alias Accent.Scopes.Version, as: VersionScope
+
+  @doc """
+  Finds an exact project tag first, then the highest version matching a semantic
+  version requirement. A leading `v` is ignored only when parsing stored tags.
+  Invalid requirements and unmatched requirements return nil.
+  """
+  def resolve(project_id, tag) do
+    query = VersionScope.from_project(Accent.Version, project_id)
+
+    query
+    |> VersionScope.from_tag(tag)
+    |> Repo.one()
+    |> case do
+      nil -> find_compatible(query, tag)
+      version -> version
+    end
+  end
+
+  defp find_compatible(query, tag) when is_binary(tag) do
+    case Version.parse_requirement(tag) do
+      {:ok, requirement} ->
+        query
+        |> Repo.all()
+        |> Enum.reduce(nil, fn version, highest ->
+          with {:ok, parsed} <- parse_tag(version.tag),
+               true <- Version.match?(parsed, requirement) do
+            highest_version({version, parsed}, highest)
+          else
+            _ -> highest
+          end
+        end)
+        |> case do
+          nil -> nil
+          {version, _parsed} -> version
+        end
+
+      :error ->
+        nil
+    end
+  end
+
+  defp find_compatible(_query, _tag), do: nil
+
+  defp parse_tag("v" <> tag), do: Version.parse(tag)
+  defp parse_tag(tag) when is_binary(tag), do: Version.parse(tag)
+  defp parse_tag(_tag), do: :error
+
+  defp highest_version(candidate, nil), do: candidate
+
+  defp highest_version({_, parsed} = candidate, {_, highest} = current) do
+    if Version.compare(parsed, highest) == :gt, do: candidate, else: current
+  end
+end
