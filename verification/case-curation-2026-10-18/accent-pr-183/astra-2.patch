diff --git a/test/support/version_fixtures.ex b/test/support/version_fixtures.ex
new file mode 100644
index 0000000..569a25b
--- /dev/null
+++ b/test/support/version_fixtures.ex
@@ -0,0 +1,40 @@
+defmodule AccentTest.VersionFixtures do
+  alias Accent.{Document, Project, Repo, Revision, Translation, Version}
+
+  def translations(project, revision, user, literal_tag \\ nil) do
+    document = Repo.insert!(%Document{project_id: project.id, path: "versions", format: "json"})
+    tags = [nil, "1.1.0", "1.9.0", "v1.10.0", "2.0.0", "master"]
+    tags = if literal_tag, do: tags ++ [literal_tag], else: tags
+
+    translations =
+      Enum.map(tags, fn tag ->
+        version = tag && Repo.insert!(%Version{project_id: project.id, user_id: user.id, name: tag, tag: tag})
+        {tag, translation(document, revision, version)}
+      end)
+
+    other_project = Repo.insert!(%Project{name: "Other project", main_color: "#000"})
+    other_revision = Repo.insert!(%Revision{project_id: other_project.id, language_id: revision.language_id, master: true})
+    other_document = Repo.insert!(%Document{project_id: other_project.id, path: document.path, format: document.format})
+
+    other_translations =
+      Enum.map(["v1.99.0", "~> 1.1"], fn tag ->
+        version = Repo.insert!(%Version{project_id: other_project.id, user_id: user.id, name: tag, tag: tag})
+        {{:other_project, tag}, translation(other_document, other_revision, version)}
+      end)
+
+    translations = Map.new(translations ++ other_translations, fn {tag, translation} -> {tag, Repo.get!(Translation, translation.id)} end)
+    {document, translations}
+  end
+
+  defp translation(document, revision, version) do
+    Repo.insert!(%Translation{
+      document_id: document.id,
+      revision_id: revision.id,
+      version_id: version && version.id,
+      key: "test",
+      corrected_text: "initial #{version && version.tag}",
+      proposed_text: "initial #{version && version.tag}",
+      conflicted: false
+    })
+  end
+end
