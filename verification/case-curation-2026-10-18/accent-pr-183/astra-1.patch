diff --git a/lib/accent/versions/version_resolver.ex b/lib/accent/versions/version_resolver.ex
new file mode 100644
index 0000000..bd25f47
--- /dev/null
+++ b/lib/accent/versions/version_resolver.ex
@@ -0,0 +1,52 @@
+defmodule Accent.VersionResolver do
+  alias Accent.Repo
+  alias Accent.Scopes.Version, as: VersionScope
+
+  @doc """
+  Resolves a project's literal tag first, then its highest semantic version
+  matching the requirement. Stored tags may have a leading `v`; non-version
+  tags are ignored when matching requirements.
+  """
+  def resolve(project_id, tag) do
+    query = VersionScope.from_project(Accent.Version, project_id)
+
+    query
+    |> VersionScope.from_tag(tag)
+    |> Repo.one()
+    |> case do
+      nil -> compatible_version(query, tag)
+      version -> version
+    end
+  end
+
+  defp compatible_version(query, tag) when is_binary(tag) do
+    case Version.parse_requirement(tag) do
+      {:ok, requirement} ->
+        query
+        |> Repo.all()
+        |> Enum.reduce(nil, fn version, best ->
+          with {:ok, parsed} <- Version.parse(String.replace_prefix(version.tag, "v", "")),
+               true <- Version.match?(parsed, requirement) do
+            newest({parsed, version}, best)
+          else
+            _ -> best
+          end
+        end)
+        |> case do
+          nil -> nil
+          {_parsed, version} -> version
+        end
+
+      :error ->
+        nil
+    end
+  end
+
+  defp compatible_version(_query, _tag), do: nil
+
+  defp newest(candidate, nil), do: candidate
+
+  defp newest({parsed, _version} = candidate, {best_parsed, _best_version} = best) do
+    if Version.compare(parsed, best_parsed) == :gt, do: candidate, else: best
+  end
+end
