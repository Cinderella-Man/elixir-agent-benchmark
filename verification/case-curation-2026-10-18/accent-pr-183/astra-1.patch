diff --git a/test/support/version_selection.ex b/test/support/version_selection.ex
new file mode 100644
index 0000000..3374723
--- /dev/null
+++ b/test/support/version_selection.ex
@@ -0,0 +1,40 @@
+defmodule AccentTest.VersionSelection do
+  alias Accent.{Document, Project, Repo, Revision, Translation, Version}
+
+  def fixtures(%{project: project, revision: revision, user: user}) do
+    document = Repo.insert!(%Document{project_id: project.id, path: "versions", format: "json"})
+
+    translations =
+      for tag <- [nil, "v1.10.0", "1.9.0", "v1.9.0", "1.1.5", "2.0.0", "release", "~> 1.0"], into: %{} do
+        version = tag && Repo.insert!(%Version{project_id: project.id, user_id: user.id, name: tag, tag: tag})
+        {tag, translation(document, revision, version, tag || "unversioned")}
+      end
+
+    other_project = Repo.insert!(%Project{name: "Other project", main_color: "#000"})
+    other_revision = Repo.insert!(%Revision{project_id: other_project.id, language_id: revision.language_id, master: true})
+    other_document = Repo.insert!(%Document{project_id: other_project.id, path: document.path, format: "json"})
+
+    other_translations =
+      for tag <- ["1.99.0", "~> 1.1"] do
+        version = Repo.insert!(%Version{project_id: other_project.id, user_id: user.id, name: tag, tag: tag})
+        translation(other_document, other_revision, version, "other project")
+      end
+
+    %{document: document, translations: translations, other_translations: other_translations}
+  end
+
+  defp translation(document, revision, version, text) do
+    translation =
+      Repo.insert!(%Translation{
+        document_id: document.id,
+        revision_id: revision.id,
+        version_id: version && version.id,
+        key: "test",
+        corrected_text: text,
+        proposed_text: text,
+        conflicted: true
+      })
+
+    Repo.get!(Translation, translation.id)
+  end
+end
