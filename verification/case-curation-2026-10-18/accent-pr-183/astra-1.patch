@@ -36,6 +36,55 @@ defmodule AccentTest.MergeController do
     {:ok, [access_token: access_token, user: user, project: project, revision: revision, language: french_language]}
   end
 
+  for {requested, selected} <- [
+        {"~> 1.1", "v1.10.0"},
+        {">= 1.1.0 and < 1.9.0", "1.1.5"},
+        {"~> 1.0", "~> 1.0"},
+        {"1.9.0", "1.9.0"},
+        {"release", "release"},
+        {nil, nil}
+      ] do
+    test "merge selects only version #{inspect(requested)}", context do
+      %{conn: conn, project: project, language: language, access_token: access_token} = context
+      %{document: document, translations: translations, other_translations: other_translations} = AccentTest.VersionSelection.fixtures(context)
+      selected = translations[unquote(selected)]
+      untouched = Enum.reject(Map.values(translations), &(&1.id == selected.id)) ++ other_translations
+
+      body = %{file: file(), project_id: project.id, language: language.slug, document_format: document.format, document_path: document.path}
+      body = if unquote(requested), do: Map.put(body, :version, unquote(requested)), else: body
+      expect(Accent.Hook.BroadcasterMock, :notify, fn %{event: "merge"} -> :ok end)
+
+      response =
+        conn
+        |> put_req_header("authorization", "Bearer #{access_token.token}")
+        |> post(merge_path(conn, []), body)
+
+      assert response.status == 200
+      assert Repo.get!(Translation, selected.id).proposed_text == "F"
+      for translation <- untouched, do: assert(Repo.get!(Translation, translation.id) == translation)
+      assert length(Repo.all(Translation)) == map_size(translations) + length(other_translations)
+    end
+  end
+
+  for requested <- ["missing", "~> 3.0", "~> invalid"] do
+    test "merge rejects unmatched version #{requested} without changing translations", context do
+      %{conn: conn, project: project, language: language, access_token: access_token} = context
+      %{document: document} = AccentTest.VersionSelection.fixtures(context)
+      before = Repo.all(from(t in Translation, order_by: t.id))
+      body = %{version: unquote(requested), file: file(), project_id: project.id, language: language.slug, document_format: document.format, document_path: document.path}
+
+      response =
+        conn
+        |> put_req_header("authorization", "Bearer #{access_token.token}")
+        |> post(merge_path(conn, []), body)
+
+      assert response.status == 422
+      assert response.resp_body == "unknown version"
+      assert Repo.all(from(t in Translation, order_by: t.id)) == before
+      assert Repo.all(Operation) == []
+    end
+  end
+
   test "merge default", %{user: user, access_token: access_token, conn: conn, project: project, revision: revision, language: language} do
     document = %Document{project_id: project.id, path: "test2", format: "json"} |> Repo.insert!()
