+for (const mediaSession of [true, false]) {
+  test(`now-playing details follow playback (Media Session ${mediaSession ? 'available' : 'unavailable'})`, async () => {
+    const {page, context, profile, errors} = await fixture.page({mediaSession});
+    try {
+      const ordinaryTitle = await page.title();
+      assert.equal(await page.evaluate(() => 'mediaSession' in navigator), mediaSession);
+      const expectSong = async song => {
+        await page.waitForFunction(({title, artist, mediaSession}) => {
+          const metadata = navigator.mediaSession?.metadata;
+          return document.title.includes(title) && document.title.includes(artist) &&
+            (!mediaSession || (metadata?.title === title && metadata?.artist === artist));
+        }, {...song, mediaSession});
+      };
+      const expectStopped = async () => {
+        await page.waitForFunction(title => document.title === title, ordinaryTitle);
+        if (mediaSession) assert.equal(await page.evaluate(() => navigator.mediaSession.metadata), null);
+      };
+
+      await playSong(page, profile.songs[0]);
+      await expectSong(profile.songs[0]);
+      await page.locator('#audio-player').getByRole('button', {name:'Pause', exact:true}).click();
+      await page.waitForFunction(() => document.querySelector('#audio-player audio').paused);
+      await expectStopped();
+      await page.locator('#audio-player').getByRole('button', {name:'Play', exact:true}).click();
+      await page.waitForFunction(() => !document.querySelector('#audio-player audio').paused);
+      await expectSong(profile.songs[0]);
+
+      await page.locator('#audio-player').getByRole('button', {name:'Next', exact:true}).click();
+      await page.waitForFunction(filename => {
+        const audio = document.querySelector('#audio-player audio');
+        return audio.src.includes(filename) && !audio.paused && audio.readyState >= 2;
+      }, profile.songs[1].filename);
+      await expectSong(profile.songs[1]);
+      assert.ok(!(await page.title()).includes(profile.songs[0].title));
+      await stopListening(page);
+      await expectStopped();
+      assert.deepEqual(errors, []);
+    } finally {await context.close();}
+  });
+}
