+for (const mediaSession of [true, false]) {
+  test(`now-playing details follow playback (Media Session ${mediaSession ? 'available' : 'unavailable'})`, async () => {
+    const {page, context, profile, errors} = await fixture.page({mediaSession});
+    try {
+      const ordinaryTitle = await page.title();
+      assert.equal(await page.evaluate(() => 'mediaSession' in navigator), mediaSession);
+      const assertNowPlaying = async song => {
+        await page.waitForFunction(({title, artist}) =>
+          document.title.includes(title) && document.title.includes(artist), song);
+        const title = await page.title();
+        assert.ok(title.includes(song.title), `Tab title should include ${song.title}: ${title}`);
+        assert.ok(title.includes(song.artist), `Tab title should include ${song.artist}: ${title}`);
+        if (mediaSession) {
+          assert.deepEqual(await page.evaluate(() => {
+            const metadata = navigator.mediaSession.metadata;
+            return metadata && {title: metadata.title, artist: metadata.artist};
+          }), {title: song.title, artist: song.artist});
+        }
+      };
+
+      await playSong(page, profile.songs[0]);
+      await assertNowPlaying(profile.songs[0]);
+      await page.locator('#audio-player').getByRole('button', {name:'Pause',exact:true}).click();
+      await page.waitForFunction(() => document.querySelector('#audio-player audio').paused);
+      assert.equal(await page.title(), ordinaryTitle);
+      await page.locator('#audio-player').getByRole('button', {name:'Play',exact:true}).click();
+      await page.waitForFunction(() => !document.querySelector('#audio-player audio').paused);
+      await assertNowPlaying(profile.songs[0]);
+
+      await playSong(page, profile.songs[1]);
+      await assertNowPlaying(profile.songs[1]);
+      // LiveView updates the page title on navigation, but the sticky player keeps playing.
+      await page.locator('#upload-btn').click();
+      await page.getByRole('heading', {name:/^Add Music/}).waitFor();
+      await assertNowPlaying(profile.songs[1]);
+      await page.getByRole('button', {name:'Cancel',exact:true}).filter({visible:true}).click();
+      await page.waitForURL(`http://127.0.0.1:4002/${profile.username}`);
+      await assertNowPlaying(profile.songs[1]);
+      await stopListening(page);
+      assert.equal(await page.title(), ordinaryTitle);
+      if (mediaSession) {
+        assert.equal(await page.evaluate(() => navigator.mediaSession.metadata), null);
+      }
+      assert.deepEqual(errors, []);
+    } finally {await context.close();}
+  });
+}
