@@ -0,0 +1,268 @@
+# SPDX-FileCopyrightText: 2019 ash contributors <https://github.com/ash-project/ash/graphs/contributors>
+#
+# SPDX-License-Identifier: MIT
+
+defmodule Ash.Test.CalculationArgumentsTest do
+  use ExUnit.Case, async: true
+
+  import Ash.Expr
+  require Ash.Query
+
+  defmodule Normalized do
+    use Ash.Type
+
+    def storage_type(_), do: :integer
+    def cast_input(:cast_error, _), do: :error
+    def cast_input(:message_error, _), do: {:error, message: "cannot cast this value"}
+    def cast_input(:constraint_error, _), do: {:ok, :constraint_error}
+    def cast_input(:bare_constraint_error, _), do: {:ok, :bare_constraint_error}
+    def cast_input(:constraint_nil, _), do: {:ok, :constraint_nil}
+    def cast_input(:nil_value, _), do: {:ok, nil}
+    def cast_input(nil, _), do: {:ok, nil}
+    def cast_input(value, _) when is_integer(value), do: {:ok, value + 1}
+
+    def cast_input(value, _) when is_binary(value) do
+      case Integer.parse(value) do
+        {value, ""} -> {:ok, value + 1}
+        _ -> :error
+      end
+    end
+
+    def cast_input(_, _), do: :error
+
+    def apply_constraints(:constraint_error, _),
+      do: {:error, [message: "constraint rejected value"]}
+
+    def apply_constraints(:bare_constraint_error, _), do: :error
+    def apply_constraints(:constraint_nil, _), do: {:ok, nil}
+    def apply_constraints(nil, _), do: {:ok, nil}
+    def apply_constraints(value, _), do: {:ok, value + 10}
+    def cast_stored(value, _), do: {:ok, value}
+    def dump_to_native(value, _), do: {:ok, value}
+  end
+
+  defmodule Item do
+    use Ash.Resource, domain: Ash.Test.Domain, data_layer: Ash.DataLayer.Ets
+
+    ets do
+      private? true
+    end
+
+    actions do
+      defaults [:read, create: :*]
+    end
+
+    attributes do
+      uuid_primary_key :id
+      attribute :target, Normalized, public?: true
+      attribute :enabled, :boolean, public?: true, default: true
+      attribute :numbers, {:array, :integer}, public?: true, default: [1, 2]
+    end
+
+    calculations do
+      calculate :matches, :boolean, expr(target == ^arg(:value) and ^arg(:toggle)) do
+        public? true
+        argument :value, Normalized, allow_nil?: false
+        argument :toggle, :boolean, allow_expr?: true, default: true
+      end
+
+      calculate :values, {:array, :integer}, expr(if(^arg(:toggle), ^arg(:values), [])) do
+        public? true
+        argument :values, {:array, Normalized}, allow_expr?: true, allow_nil?: false
+        argument :toggle, :boolean, allow_expr?: true, default: true
+      end
+
+      calculate :optional, :integer, expr(if(^arg(:toggle), ^arg(:value), nil)) do
+        public? true
+        argument :value, Normalized, allow_expr?: true
+        argument :toggle, :boolean, allow_expr?: true, default: true
+      end
+
+      calculate :required_default, :integer, expr(^arg(:value)) do
+        public? true
+        argument :value, Normalized, allow_nil?: false, default: 7
+        argument :toggle, :boolean, allow_expr?: true, default: true
+      end
+
+      calculate :defaulted, :integer, expr(^arg(:value)) do
+        public? true
+        argument :value, :integer, default: 7, allow_nil?: false
+      end
+    end
+  end
+
+  setup do
+    %{item: Ash.create!(Item, %{target: 1})}
+  end
+
+  test "normalized literals survive typed comparisons with and without expressions", %{item: item} do
+    other = Ash.create!(Item, %{target: 2})
+
+    for toggle <- [true, expr(enabled)], key <- [:value, "value"] do
+      args = %{key => "1", :toggle => toggle}
+      assert Ash.load!(item, matches: args).matches == true
+
+      assert [%{id: id}] =
+               Item |> Ash.Query.filter(%{matches: %{input: ^args, eq: true}}) |> Ash.read!()
+
+      assert id == item.id
+
+      assert [%{id: ^id}] =
+               Item |> Ash.Query.filter(^[matches: {args, [eq: true]}]) |> Ash.read!()
+
+      assert {:ok, sort} = Ash.Sort.parse_input(Item, matches: {args, :desc})
+      assert Enum.map(Item |> Ash.Query.sort(sort) |> Ash.read!(), & &1.id) == [item.id, other.id]
+
+      assert Enum.map(Item |> Ash.Query.sort(matches: {args, :asc}) |> Ash.read!(), & &1.id) ==
+               [other.id, item.id]
+
+      assert {:ok, calculation} =
+               Ash.Query.Calculation.from_resource_calculation(Item, :matches, args: args)
+
+      assert calculation.context.arguments.value == 12
+    end
+
+    # Keyword inputs use the same validation path as atom- and string-keyed maps.
+    assert {:ok, calculation} =
+             Ash.Query.Calculation.from_resource_calculation(Item, :matches,
+               args: [value: "1", toggle: expr(enabled)]
+             )
+
+    assert calculation.context.arguments.value == 12
+    assert Ash.load!(item, matches: [value: "1", toggle: expr(enabled)]).matches
+    assert Ash.load!(item, optional: %{value: expr(target)}).optional == 13
+
+    assert [%{id: id}] =
+             Item |> Ash.Query.filter(matches(value: "1", toggle: enabled)) |> Ash.read!()
+
+    assert id == item.id
+
+    args = %{"value" => "1", "toggle" => expr(enabled)}
+    assert [%{id: ^id}] = Item |> Ash.Query.filter(matches(^args)) |> Ash.read!()
+
+    assert [_] =
+             Item
+             |> Ash.Query.filter_input(%{
+               "matches" => %{"input" => %{"value" => "1"}, "eq" => true}
+             })
+             |> Ash.read!()
+  end
+
+  test "array literals and array expressions work beside scalar expressions", %{item: item} do
+    other = Ash.create!(Item, %{target: 2, enabled: false})
+
+    for values <- [["1", "2"], %{"0" => "1", "1" => "2"}],
+        key <- [:values, "values"] do
+      args = %{key => values, :toggle => expr(enabled)}
+      assert Ash.load!(item, values: args).values == [12, 13]
+      assert [_] = Item |> Ash.Query.filter(^[values: {args, [eq: [12, 13]]}]) |> Ash.read!()
+
+      assert [_] =
+               Item |> Ash.Query.filter(%{values: %{input: ^args, eq: [12, 13]}}) |> Ash.read!()
+
+      assert {:ok, sort} = Ash.Sort.parse_input(Item, values: {args, :asc})
+      assert Enum.map(Item |> Ash.Query.sort(sort) |> Ash.read!(), & &1.id) == [other.id, item.id]
+    end
+
+    # Expression arguments still use ordinary coercion, rather than input constraints.
+    assert Ash.load!(item, values: %{values: expr(numbers)}).values == [2, 3]
+    assert Ash.load!(item, values: %{values: %{"0" => expr(1 + 1), "1" => "3"}}).values == [3, 4]
+  end
+
+  test "invalid containers and unknown arguments return input errors" do
+    calc = Ash.Resource.Info.calculation(Item, :matches)
+
+    for args <- [nil, false, 1, "bad", [:bad], [{:value, 1}, :bad], %Ash.Query.Ref{}] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{}} =
+               Ash.Query.validate_calculation_arguments(calc, args)
+
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{}} =
+               Ash.Query.Calculation.from_resource_calculation(Item, calc, args: args)
+
+      assert %{valid?: false} = Ash.Query.load(Item, matches: args)
+      assert %{valid?: false} = Ash.Query.filter(Item, %{matches: %{input: ^args, eq: true}})
+      assert %{valid?: false} = Ash.Query.filter_input(Item, %{matches: %{input: args, eq: true}})
+      assert {:error, _} = Ash.Sort.parse_input(Item, matches: {args, :asc})
+
+      if not is_nil(args) do
+        assert %{valid?: false} = Ash.Query.filter(Item, ^[matches: {args, [eq: true]}])
+        assert %{valid?: false} = Ash.Query.filter_input(Item, matches: {args, [eq: true]})
+      end
+    end
+
+    for args <- [%{unknown: 1}, %{"unknown" => 1}] do
+      assert {:error, %Ash.Error.Invalid.NoSuchInput{}} =
+               Ash.Query.Calculation.from_resource_calculation(Item, calc, args: args)
+
+      assert %{valid?: false} = Ash.Query.load(Item, matches: args)
+      assert %{valid?: false} = Ash.Query.filter(Item, %{matches: %{input: ^args, eq: true}})
+      assert {:error, _} = Ash.Sort.parse_input(Item, matches: {args, :asc})
+    end
+  end
+
+  test "callback rejections retain useful messages" do
+    for {value, message} <- [
+          cast_error: "is invalid",
+          message_error: "cannot cast this value",
+          bare_constraint_error: "is invalid",
+          constraint_error: "constraint rejected value"
+        ] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{} = error} =
+               Ash.Query.Calculation.from_resource_calculation(Item, :matches,
+                 args: %{value: value}
+               )
+
+      assert Exception.message(error) =~ message
+      assert %{valid?: false} = Ash.Query.load(Item, matches: %{value: value})
+
+      assert %{valid?: false} =
+               Ash.Query.filter(Item, %{matches: %{input: %{value: ^value}, eq: true}})
+
+      assert {:error, _} = Ash.Sort.parse_input(Item, matches: {%{value: value}, :asc})
+
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{} = error} =
+               Ash.Query.Calculation.from_resource_calculation(Item, :values,
+                 args: %{values: [value]}
+               )
+
+      assert Exception.message(error) =~ message
+    end
+  end
+
+  test "filter_input rejects expressions in map and tuple forms" do
+    for expression <- [expr(enabled), Ash.Query.Function.Type.literal(true, Ash.Type.Boolean, [])],
+        args = %{value: 1, toggle: expression},
+        filter <- [%{matches: %{input: args, eq: true}}, [matches: {args, [eq: true]}]] do
+      assert %{valid?: false, errors: errors} = Ash.Query.filter_input(Item, filter)
+      assert Enum.any?(errors, &match?(%Ash.Error.Query.InvalidCalculationArgument{}, &1))
+    end
+  end
+
+  test "required, optional and default arguments retain nil semantics", %{item: item} do
+    assert Ash.load!(item, :defaulted).defaulted == 7
+    assert [_] = Item |> Ash.Query.filter(defaulted: {nil, [eq: 7]}) |> Ash.read!()
+    assert [_] = Item |> Ash.Query.filter_input(defaulted: {nil, [eq: 7]}) |> Ash.read!()
+    assert Ash.load!(item, optional: %{value: :nil_value}).optional == nil
+    assert Ash.load!(item, :optional).optional == nil
+
+    default =
+      Ash.Resource.Info.calculation(Item, :required_default).arguments
+      |> hd()
+      |> Map.fetch!(:default)
+
+    assert Ash.load!(item, :required_default).required_default == default
+
+    for value <- [nil, :nil_value, :constraint_nil], toggle <- [true, expr(enabled)] do
+      args = %{value: value, toggle: toggle}
+      assert Ash.load!(item, optional: args).optional == nil
+      assert %{valid?: false} = Ash.Query.load(Item, matches: args)
+      assert %{valid?: false} = Ash.Query.load(Item, required_default: args)
+    end
+
+    for args <- [%{}, %{value: nil}, %{value: :nil_value, toggle: expr(enabled)}] do
+      assert %{valid?: false} = Ash.Query.load(Item, matches: args)
+    end
+
+    assert %{valid?: false} = Ash.Query.load(Item, defaulted: %{value: nil})
+  end
+end
