diff --git a/test/calculations/calculation_arguments_test.exs b/test/calculations/calculation_arguments_test.exs
new file mode 100644
index 0000000..259558e
--- /dev/null
+++ b/test/calculations/calculation_arguments_test.exs
@@ -0,0 +1,308 @@
+# SPDX-FileCopyrightText: 2019 ash contributors <https://github.com/ash-project/ash/graphs/contributors>
+#
+# SPDX-License-Identifier: MIT
+
+defmodule Ash.Test.CalculationArgumentsTest do
+  use ExUnit.Case, async: true
+
+  require Ash.Query
+  import Ash.Expr
+
+  defmodule Normalized do
+    use Ash.Type
+
+    def storage_type(_), do: :string
+    def cast_input(nil, _), do: {:ok, nil}
+    def cast_input("cast_error", _), do: {:error, message: "cast was rejected"}
+    def cast_input(value, _), do: {:ok, value <> ":cast"}
+    def cast_stored(value, _), do: {:ok, value}
+    def dump_to_native(value, _), do: {:ok, value}
+    def apply_constraints("constraint_error:cast", _), do: :error
+
+    def apply_constraints("keyword_error:cast", _),
+      do: {:error, message: "constraint was rejected"}
+
+    def apply_constraints("list_error:cast", _),
+      do: {:error, [[message: "first rejection"], [message: "second rejection"]]}
+
+    def apply_constraints(nil, _), do: {:ok, nil}
+    def apply_constraints(value, _), do: {:ok, value <> ":constrained"}
+    def coerce(value, _), do: {:ok, value <> ":coerced"}
+    def cast_input_array(["array_error"], _), do: :error
+    def cast_input_array(values, constraints), do: super(values, constraints)
+  end
+
+  defmodule ArrayRejected do
+    use Ash.Type
+
+    def storage_type(_), do: :string
+    def cast_input(value, _), do: {:ok, value}
+    def cast_stored(value, _), do: {:ok, value}
+    def dump_to_native(value, _), do: {:ok, value}
+    def apply_constraints_array(["bare_error"], _), do: :error
+    def apply_constraints_array(["keyword_error"], _), do: {:error, message: "array was rejected"}
+    def apply_constraints_array(value, _), do: {:ok, value}
+  end
+
+  defmodule Item do
+    use Ash.Resource, domain: Ash.Test.Domain, data_layer: Ash.DataLayer.Ets
+
+    ets do
+      private? true
+    end
+
+    actions do
+      defaults [:read, create: :*]
+      default_accept :*
+    end
+
+    attributes do
+      uuid_primary_key :id
+      attribute :suffix, :string, public?: true
+      attribute :tags, {:array, :string}, public?: true
+    end
+
+    calculations do
+      calculate :combined, :string, expr(^arg(:literal) <> ^arg(:suffix)) do
+        public? true
+        argument :literal, Normalized, allow_nil?: false
+        argument :suffix, :string, allow_expr?: true, allow_nil?: false
+      end
+
+      calculate :joined, :string, expr(string_join(^arg(:values), ^arg(:suffix))) do
+        public? true
+        argument :values, {:array, Normalized}, allow_expr?: true, allow_nil?: false
+        argument :suffix, :string, allow_expr?: true, allow_nil?: false
+      end
+
+      calculate :array_rejected, {:array, :string}, expr(^arg(:values)) do
+        public? true
+        argument :values, {:array, ArrayRejected}
+      end
+
+      calculate :coerced, :string, expr(^arg(:value)) do
+        public? true
+        argument :value, Normalized, allow_expr?: true
+      end
+
+      calculate :nil_semantics, :string, expr(^arg(:value)) do
+        public? true
+        argument :value, :string, allow_nil?: false, default: "default"
+        argument :optional, :string
+        argument :expression, :string, allow_expr?: true
+      end
+    end
+  end
+
+  test "literals keep their cast and constrained values beside expressions" do
+    for literal_key <- [:literal, "literal"], suffix_key <- [:suffix, "suffix"] do
+      args = %{literal_key => "value", suffix_key => expr(suffix)}
+
+      assert {:ok, calculation} =
+               Ash.Query.Calculation.from_resource_calculation(Item, :combined, args: args)
+
+      assert calculation.context.arguments.literal == "value:cast:constrained"
+    end
+  end
+
+  test "loads, filters and sorts normalize literals exactly once" do
+    item = Ash.create!(Item, %{suffix: "!"})
+
+    for suffix <- ["!", expr(suffix)] do
+      args = %{"literal" => "value", "suffix" => suffix}
+      expected = "value:cast:constrained!"
+      assert Ash.load!(item, combined: args).combined == expected
+
+      assert [result] =
+               Item |> Ash.Query.filter(combined: %{input: args, eq: expected}) |> Ash.read!()
+
+      assert result.id == item.id
+
+      assert [result] = Item |> Ash.Query.filter(combined: {args, [eq: expected]}) |> Ash.read!()
+      assert result.id == item.id
+
+      assert [result] = Item |> Ash.Query.filter(combined(^args) == ^expected) |> Ash.read!()
+      assert result.id == item.id
+
+      assert [result] =
+               Item
+               |> Ash.Query.filter(combined(literal: "value", suffix: ^suffix) == ^expected)
+               |> Ash.read!()
+
+      assert result.id == item.id
+
+      query = Ash.Query.sort(Item, combined: {args, :asc})
+
+      assert [
+               {%Ash.Query.Calculation{
+                  context: %{arguments: %{literal: "value:cast:constrained"}}
+                }, :asc}
+             ] = query.sort
+
+      assert [result] = Ash.read!(query)
+      assert result.id == item.id
+    end
+  end
+
+  test "array literals and array expressions are valid calculation arguments" do
+    item = Ash.create!(Item, %{suffix: "!", tags: ["a", "b"]})
+
+    for values <- [["a", "b"], %{"0" => "a", "1" => "b"}] do
+      args = %{values: values, suffix: expr(suffix)}
+      assert Ash.load!(item, joined: args).joined == "a:cast:constrained!b:cast:constrained"
+    end
+
+    # Array references must not be enumerated as indexed input maps, and must
+    # still use expression coercion rather than input casting/constraints.
+    args = %{values: expr(tags), suffix: "!"}
+    assert Ash.load!(item, joined: args).joined == "a:coerced!b:coerced"
+
+    assert [result] =
+             Item
+             |> Ash.Query.filter(joined: %{input: args, eq: "a:coerced!b:coerced"})
+             |> Ash.read!()
+
+    assert result.id == item.id
+
+    assert Ash.load!(item, coerced: %{value: expr(suffix)}).coerced == "!:coerced"
+
+    args = %{values: %{"0" => expr(suffix), "1" => "b"}, suffix: "!"}
+    assert Ash.load!(item, joined: args).joined == "!:coerced!b:coerced"
+  end
+
+  test "sorting evaluates scalar and array expressions with normalized literals" do
+    first = Ash.create!(Item, %{suffix: "a", tags: ["a", "x"]})
+    second = Ash.create!(Item, %{suffix: "b", tags: ["b", "x"]})
+
+    for {name, args} <- [
+          {:combined, %{literal: "value", suffix: expr(suffix)}},
+          {:joined, %{"values" => ["a", "b"], "suffix" => expr(suffix)}},
+          {:joined, %{values: expr(tags), suffix: "!"}}
+        ] do
+      assert Enum.map(Item |> Ash.Query.sort([{name, {args, :asc}}]) |> Ash.read!(), & &1.id) == [
+               first.id,
+               second.id
+             ]
+
+      assert Enum.map(Item |> Ash.Query.sort([{name, {args, :desc}}]) |> Ash.read!(), & &1.id) ==
+               [second.id, first.id]
+    end
+  end
+
+  test "malformed containers and unknown arguments are structured errors" do
+    calc = Ash.Resource.Info.calculation(Item, :combined)
+
+    for args <- [nil, false, 42, "arguments", [:literal], [{"literal", "value"}], %URI{}] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{}} =
+               Ash.Query.validate_calculation_arguments(calc, args)
+    end
+
+    assert {:error, %Ash.Error.Invalid.NoSuchInput{input: "unknown"}} =
+             Ash.Query.validate_calculation_arguments(calc, %{"unknown" => 1})
+
+    for args <- [
+          nil,
+          false,
+          42,
+          "arguments",
+          [:literal],
+          %URI{},
+          %{unknown: 1},
+          %{literal: "cast_error", suffix: "!"}
+        ] do
+      for query <- [
+            Ash.Query.load(Item, combined: args),
+            Ash.Query.filter(Item, combined: %{input: args, eq: "anything"}),
+            Ash.Query.filter(Item, combined: {args, [eq: "anything"]}),
+            Ash.Query.filter_input(Item, [combined: %{input: args, eq: "anything"}],
+              ref_transformer: fn _, _ -> nil end
+            ),
+            Ash.Query.sort(Item, combined: {args, :asc}),
+            Ash.Query.sort_input(Item, combined: {args, :asc})
+          ] do
+        refute query.valid?
+        assert %Ash.Error.Invalid{} = Ash.Error.to_error_class(query.errors)
+      end
+    end
+  end
+
+  test "type callback rejections retain useful messages" do
+    calc = Ash.Resource.Info.calculation(Item, :combined)
+
+    for {value, message} <- [
+          {"cast_error", "cast was rejected"},
+          {"constraint_error", "is invalid"},
+          {"keyword_error", "constraint was rejected"},
+          {"list_error", "first rejection"}
+        ] do
+      assert {:error, error} =
+               Ash.Query.validate_calculation_arguments(calc, %{literal: value, suffix: "!"})
+
+      assert %Ash.Error.Query.InvalidCalculationArgument{} = error
+      assert Exception.message(error) =~ message
+    end
+
+    calc = Ash.Resource.Info.calculation(Item, :joined)
+
+    for value <- ["array_error", "cast_error", "constraint_error", "keyword_error", "list_error"] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{}} =
+               Ash.Query.validate_calculation_arguments(calc, %{values: [value], suffix: "!"})
+    end
+
+    calc = Ash.Resource.Info.calculation(Item, :array_rejected)
+
+    for {value, message} <- [
+          {"bare_error", "is invalid"},
+          {"keyword_error", "array was rejected"}
+        ] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{} = error} =
+               Ash.Query.validate_calculation_arguments(calc, %{values: [value]})
+
+      assert Exception.message(error) =~ message
+    end
+  end
+
+  test "filter_input rejects expression arguments in map and tuple forms" do
+    args = %{literal: "value", suffix: expr(suffix)}
+
+    for filter <- [
+          [combined: %{input: args, eq: "anything"}],
+          [combined: {args, [eq: "anything"]}]
+        ] do
+      query = Ash.Query.filter_input(Item, filter)
+      refute query.valid?
+
+      assert Enum.any?(
+               query.errors,
+               &match?(
+                 %Ash.Error.Query.InvalidCalculationArgument{
+                   message: "does not support expressions",
+                   field: :suffix
+                 },
+                 &1
+               )
+             )
+    end
+  end
+
+  test "defaults, optional arguments and normalized nil retain their semantics" do
+    calc = Ash.Resource.Info.calculation(Item, :nil_semantics)
+
+    assert {:ok, %{value: "default", optional: nil}} =
+             Ash.Query.validate_calculation_arguments(calc, %{})
+
+    for expression <- [nil, expr(suffix)], value <- [nil, "   "] do
+      assert {:error, %Ash.Error.Query.InvalidCalculationArgument{message: "is required"}} =
+               Ash.Query.validate_calculation_arguments(calc, %{
+                 value: value,
+                 expression: expression
+               })
+    end
+
+    assert {:ok, %{optional: nil}} =
+             Ash.Query.validate_calculation_arguments(calc, %{
+               optional: "   ",
+               expression: expr(suffix)
+             })
+  end
+end
