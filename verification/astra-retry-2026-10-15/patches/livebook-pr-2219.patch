+          id: "input1",
+          destination: test,
+          attrs: %{type: :number, default: 42, label: "New input"}
+        }
+
+        frame_update = %{
+          type: :frame_update,
+          ref: "frame1",
+          update: {@update_type, [input]}
+        }
+
+        send(session.pid, {:runtime_evaluation_output, cell_id, frame_update})
