+        |> render_change(%{"html_value" => "43"})
+
+        assert %{input_infos: %{"input1" => %{value: 43}}} = Session.get_data(session.pid)
+        assert_receive {:event, "input_ref1", %{value: 43, type: :change}}
+      end
+    end
