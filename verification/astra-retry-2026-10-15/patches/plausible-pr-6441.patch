@@ -117,6 +117,10 @@ defmodule Plausible.Stats.Goals do
     |> Map.new()
   end
 
+  defp imported_event_name(goal) do
+    if Plausible.Goal.has_custom_props?(goal), do: "", else: to_string(goal.event_name)
+  end
+
   defp event_name_by_type(:event, goal), do: goal.event_name
   defp event_name_by_type(:page, _goal), do: "pageview"
   defp event_name_by_type(:scroll, _goal), do: "engagement"
@@ -139,6 +143,20 @@ defmodule Plausible.Stats.Goals do
     goal_filters? and any_scroll_goals_preloaded?
   end
 
+  def custom_prop_goal_filters?(query) do
+    query.filters
+    |> Filters.all_leaf_filters()
+    |> Enum.any?(fn
+      [_, "event:goal" | _] = filter ->
+        query.preloaded_goals.all
+        |> goals_matching_any_clause(filter)
+        |> Enum.any?(&Plausible.Goal.has_custom_props?/1)
+
+      _ ->
+        false
+    end)
+  end
+
   defp filter_preloaded(goals, filter, clause) do
     Enum.filter(goals, fn goal -> matches?(goal, filter, clause) end)
   end
