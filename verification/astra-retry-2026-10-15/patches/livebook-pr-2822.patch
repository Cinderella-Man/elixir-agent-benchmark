                       metadata()}
     end
 
+    test "preserves inherited imports after an evaluation error", %{evaluator: evaluator} do
+      code1 = """
+      import Integer, only: [digits: 1, is_even: 1]
+      """
+
+      code2 = """
+      import Integer, only: []
+      raise ":<"
+      """
+
+      code3 = """
+      if is_even(2), do: Enum.sum(digits(123)), else: 0
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, terminal_text(_), metadata()}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(ansi_number(6)),
+                      metadata()}
+    end
+
+    test "preserves inherited process dictionary after an evaluation error",
+         %{evaluator: evaluator} do
+      code1 = """
+      Process.put(:x, 1)
+      Process.put(:y, 2)
+      """
+
+      code2 = """
+      Process.put(:x, 10)
+      Process.delete(:y)
+      Process.put(:z, 3)
+      raise ":<"
+      """
+
+      code3 = """
+      {Process.get(:x), Process.get(:y), Process.get(:z)}
+      """
+
+      Evaluator.evaluate_code(evaluator, :elixir, code1, :code_1, [])
+      assert_receive {:runtime_evaluation_response, :code_1, terminal_text(_), metadata()}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code2, :code_2, [:code_1])
+      assert_receive {:runtime_evaluation_response, :code_2, error(_), metadata()}
+
+      Evaluator.evaluate_code(evaluator, :elixir, code3, :code_3, [:code_2, :code_1])
+      assert_receive {:runtime_evaluation_response, :code_3, terminal_text(output), metadata()}
+      assert clean_message(output) == "{1, 2, nil}"
+    end
+
