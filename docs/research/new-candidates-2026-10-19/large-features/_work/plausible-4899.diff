+        assert json_response(conn, 403) == %{
+                 "error" => "Not enough permissions to edit segment"
+               }
+      end
+    end
+
+    for {filters, expected_errors} <- [
+          {[],
+           [
+             [
+               "segment_data",
+               "property \"filters\" must be an array with at least one member",
