+      ProductionBatchLot
+      |> Ash.Query.filter(production_batch_id == ^batch.id)
+      |> Ash.Query.load(lot: [:material])
+      |> Ash.read!(actor: actor)
+
+    lot_ids = Enum.map(usages, & &1.lot_id)
