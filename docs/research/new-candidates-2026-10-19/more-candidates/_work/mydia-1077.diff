+    {:ok, src} =
+      Mydia.Storage.source(loc, "Invented Film (2031)/Invented Film (2031) [1080p].mkv")
+
+    assert {:ok, %{size: 1}} = Mydia.Storage.stat(src)
+    assert {:ok, url} = Mydia.Storage.input(src)
+    assert {:ok, %{status: 200, body: "z"}} = Req.get(url)
+  end
+end
