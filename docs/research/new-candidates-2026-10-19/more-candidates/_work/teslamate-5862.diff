--- a/elixir/lib/teslamate/mqtt/pubsub/vehicle_subscriber.ex
+++ b/elixir/lib/teslamate/mqtt/pubsub/vehicle_subscriber.ex
@@ -130,6 +130,7 @@ defmodule TeslaMate.Mqtt.PubSub.VehicleSubscriber do
       |> add_car_latitude_longitude(summary)
       |> add_geofence(summary)
       |> add_active_route(summary)
+      |> keep_odometer_increasing(state.last_values)
 
     last_values = publish_values(values, state)
 
@@ -299,6 +300,16 @@ defmodule TeslaMate.Mqtt.PubSub.VehicleSubscriber do
     service_mode sun_roof_state sun_roof_installed sun_roof_percent_open download_perc install_perc
   )a
 
+  # While driving, the stream and the periodic vehicle data poll both set the
+  # odometer, and the polled value lags a few seconds behind. Never publish a
+  # smaller odometer than the last one, so it only goes up.
+  defp keep_odometer_increasing(%{odometer: odometer} = map, %{odometer: last})
+       when is_number(odometer) and is_number(last) and odometer < last do
+    Map.put(map, :odometer, last)
+  end
+
+  defp keep_odometer_increasing(map, _last_values), do: map
+
   defp add_simple_values(map, %Summary{} = summary) do
     Map.merge(map, Map.take(summary, @simple_values))
   end
diff --git a/elixir/test/teslamate/mqtt/pubsub/vehicle_subscriber_test.exs b/elixir/test/teslamate/mqtt/pubsub/vehicle_subscriber_test.exs
index e6eefd98b3..2beabdbf72 100644
--- a/elixir/test/teslamate/mqtt/pubsub/vehicle_subscriber_test.exs
+++ b/elixir/test/teslamate/mqtt/pubsub/vehicle_subscriber_test.exs
@@ -382,6 +382,25 @@ defmodule TeslaMate.Mqtt.PubSub.VehicleSubscriberTest do
     assert_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/version", "3", _}}
   end
 
+  test "never publishes a smaller odometer than before", %{test: name} do
+    {:ok, pid} = start_subscriber(name, 0)
+
+    assert_receive {VehiclesMock, {:subscribe_to_summary, 0}}
+
+    send(pid, %Summary{odometer: 18416.37, version: "1"})
+    assert_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/odometer", "18416.37", _}}
+    assert_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/version", "1", _}}
+
+    # A lagging poll reports a slightly smaller value: nothing is published
+    send(pid, %Summary{odometer: 18416.35, version: "2"})
+    assert_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/version", "2", _}}
+    refute_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/odometer", _, _}}
+
+    # The next larger value is published again
+    send(pid, %Summary{odometer: 18416.40, version: "3"})
+    assert_receive {MqttPublisherMock, {:publish, "teslamate/cars/0/odometer", "18416.4", _}}
+  end
+
   @tag :capture_log
   test "retries failed values until they are published successfully", %{test: name} do
     display_name_topic = "teslamate/cars/0/display_name"
