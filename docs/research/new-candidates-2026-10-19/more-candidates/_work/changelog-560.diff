+  defp active_hosts_for_slug(slug) do
+    from(podcast in public(),
+      join: host in assoc(podcast, :active_podcast_hosts),
+      join: person in assoc(host, :person),
+      where: podcast.slug == ^slug,
+      order_by: [asc: host.position, asc: host.id],
+      select: person
+    )
+    |> Repo.all()
