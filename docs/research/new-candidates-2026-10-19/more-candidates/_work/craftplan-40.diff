+      |> Ash.Query.sort(:lot_code)
+      |> Ash.read!(actor: actor)
+
+    assert Enum.map(lots, & &1.supplier_lot_code) == ["SPLIT-A", "SPLIT-B", "SPLIT-C"]
+
+    assert Enum.reduce(lots, Decimal.new(0), &Decimal.add(&1.received_quantity, &2)) ==
