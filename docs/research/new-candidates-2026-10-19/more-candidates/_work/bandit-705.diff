diff --git a/CHANGELOG.md b/CHANGELOG.md
index 73ed9d89..78cdddae 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -1,3 +1,12 @@
+## Unreleased
+
+### Fixes
+
+* Preserve independent error responses on HTTP/1 keep-alive and pipelined requests
+  by discarding completed requests' sent-response notifications
+* Explicitly frame empty HTTP/1 4xx/5xx error responses with `Content-Length: 0`
+  so response completion does not depend on a clean connection close
+
 ## 1.12.5 (20 Aug 2026)
 
 ### Changes
diff --git a/lib/bandit/http1/handler.ex b/lib/bandit/http1/handler.ex
index e258a970..357b91e7 100644
--- a/lib/bandit/http1/handler.ex
+++ b/lib/bandit/http1/handler.ex
@@ -34,6 +34,10 @@ defmodule Bandit.HTTP1.Handler do
   end
 
   defp maybe_keepalive(transport, state) do
+    # Sent notifications belong to the completed request, not the next request
+    # (which may already be buffered and processed without returning to the mailbox).
+    discard_sent_notifications()
+
     if !transport.close_after_response && transport.keepalive do
       if Keyword.get(state.opts.http_1, :clear_process_dict, true), do: clear_process_dict()
       requests_processed = Map.get(state, :requests_processed, 0) + 1
@@ -54,6 +58,14 @@ defmodule Bandit.HTTP1.Handler do
     end
   end
 
+  defp discard_sent_notifications do
+    receive do
+      {:plug_conn, :sent} -> discard_sent_notifications()
+    after
+      0 -> :ok
+    end
+  end
+
   defp request_limit_reached?(state) do
     requests_processed = Map.get(state, :requests_processed, 0) + 1
     request_limit = Keyword.get(state.opts.http_1, :max_requests, 0)
diff --git a/lib/bandit/http1/socket.ex b/lib/bandit/http1/socket.ex
index 5bd5d03f..a27e60ad 100644
--- a/lib/bandit/http1/socket.ex
+++ b/lib/bandit/http1/socket.ex
@@ -658,8 +658,13 @@ defmodule Bandit.HTTP1.Socket do
         0 ->
           status = error |> Plug.Exception.status() |> Plug.Conn.Status.code()
 
+          # Empty error responses finish at the headers, without relying on a clean
+          # EOF to delimit their body if the connection subsequently fails.
+          headers = [{"connection", "close"}]
+          headers = if status in 400..599, do: [{"content-length", "0"} | headers], else: headers
+
           try do
-            send_headers(socket, status, [{"connection", "close"}], :no_body)
+            send_headers(socket, status, headers, :no_body)
           rescue
             _e in [Bandit.TransportError, Bandit.HTTPError] -> :ok
           end
