diff --git a/lib/changelog_web/templates/news_item_comment/_edit_form.html.eex b/lib/changelog_web/templates/news_item_comment/_edit_form.html.eex
new file mode 100644
index 0000000000..71c38b89e9
--- /dev/null
+++ b/lib/changelog_web/templates/news_item_comment/_edit_form.html.eex
@@ -0,0 +1,21 @@
+<%= form_for @changeset,
+  Routes.news_item_comment_path(@conn, :create),
+  [class: "comment_form js-comment-form is-hidden", data: [ajax: true, context: "edit"]],
+  fn(f) -> %>
+
+  <%= hidden_input(f, :item_id, id: false) %>
+  <%= hidden_input(f, :comment_id, id: false, value: @comment.id) %>
+  <textarea class="comment_form-write" name="<%= input_name(f, :content) %>" rows="1">
+    <%= @comment.content %>
+  </textarea>
+
+  <div class="comment_form-preview richtext richtext--comment js-comment-preview-area"></div>
+
+  <div class="comment_form-toolbar">
+    <div class="comment_form-toolbar-toggle">
+      <button class="comment_form-toolbar-toggle-write js-comment-write is-active">Write</button> |
+      <button class="comment_form-toolbar-toggle-preview js-comment-preview">Preview</button>
+    </div>
+    <input type="submit" class="comment_form-toolbar-submit" value="Update">
+  </div>
+<% end %>
