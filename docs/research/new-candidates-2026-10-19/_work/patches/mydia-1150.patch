Subject: [PATCH 2/3] test(jobs): tighten the snooze source guard

Ignore snooze typespecs on wrapped @spec lines and also catch attempt < 2, per the omp review of #1150.
---
 test/mydia/jobs/startup_jitter_test.exs | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/test/mydia/jobs/startup_jitter_test.exs b/test/mydia/jobs/startup_jitter_test.exs
index 08c83435cd..bf2319d58c 100644
--- a/test/mydia/jobs/startup_jitter_test.exs
+++ b/test/mydia/jobs/startup_jitter_test.exs
@@ -70,7 +70,7 @@ defmodule Mydia.Jobs.StartupJitterTest do
             Path.expand(path) != @helper,
             source = File.read!(path),
             String.contains?(source, ["StartupJitter.delay", ":snooze"]),
-            Regex.match?(~r/attempt\s*(==|<=|<)\s*1\b/, source),
+            Regex.match?(~r/attempt\s*(==\s*1|<=\s*1|<\s*2)\b/, source),
             do: path
 
       assert offenders == [],
@@ -79,10 +79,12 @@ defmodule Mydia.Jobs.StartupJitterTest do
     end
   end
 
+  # A typespec names the snooze tuple without building one, including on the
+  # continuation line of a wrapped @spec.
   defp snooze_tuple?(line) do
     trimmed = String.trim_leading(line)
 
-    String.contains?(line, "{:snooze,") and not String.starts_with?(trimmed, ["@spec", "#"]) and
-      not Regex.match?(~r/^\s*\|/, line)
+    String.contains?(line, "{:snooze,") and not String.starts_with?(trimmed, ["@spec", "#", "|"]) and
+      not Regex.match?(~r/\{:snooze,\s*(pos_|non_neg_)?integer\(\)\}/, line)
   end
 end

From 26514c40378d2a487180915b82d25a564d26cf6c Mon Sep 17 00:00:00 2001
From: Alexandre Rosenfeld <arsfeld@gmail.com>
