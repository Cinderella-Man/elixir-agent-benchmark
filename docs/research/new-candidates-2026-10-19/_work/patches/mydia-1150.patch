     test "an unknown scope is cancelled rather than retried" do
       assert {:cancel, _reason} =
-               perform_job(AiringEpisodeRefresh, %{"scope" => "sometimes"}, attempt: 2)
+               perform_job(AiringEpisodeRefresh, %{"scope" => "sometimes"})
     end
   end
 
