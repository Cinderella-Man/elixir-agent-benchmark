From 59cf9e524dd7c8b3432453bdca2a971b35e1e994 Mon Sep 17 00:00:00 2001
From: adamstac <adam@stacoviak.com>
Date: Tue, 8 Sep 2026 16:27:17 -0500
Subject: [PATCH] Enforce unique episode-backed news item identities

Add a bounded transactional partial unique index for canonical episode object IDs across all podcasts and publish modes. Preserve historical namespaces and retain duplicate-read fallback coverage inside its test transaction.
---
 ...0_enforce_episode_news_item_uniqueness.exs | 23 ++++++
 .../changelog/schema/episode/episode_test.exs |  4 +
 .../episode_news_item_uniqueness_test.exs     | 77 +++++++++++++++++++
 3 files changed, 104 insertions(+)
 create mode 100644 priv/repo/migrations/20260908170000_enforce_episode_news_item_uniqueness.exs
 create mode 100644 test/changelog/schema/news/episode_news_item_uniqueness_test.exs

diff --git a/priv/repo/migrations/20260908170000_enforce_episode_news_item_uniqueness.exs b/priv/repo/migrations/20260908170000_enforce_episode_news_item_uniqueness.exs
new file mode 100644
index 0000000000..02dd510cad
--- /dev/null
+++ b/priv/repo/migrations/20260908170000_enforce_episode_news_item_uniqueness.exs
@@ -0,0 +1,23 @@
+defmodule Changelog.Repo.Migrations.EnforceEpisodeNewsItemUniqueness do
+  use Ecto.Migration
+
+  def up do
+    execute("SET LOCAL lock_timeout = '2s'")
+    execute("SET LOCAL statement_timeout = '20s'")
+
+    # Episode object IDs span every podcast and publish mode, not just audio rows.
+    create(
+      unique_index(:news_items, [:object_id],
+        name: :news_items_episode_object_id_unique,
+        where: "object_id ~ '^[1-9][0-9]*:[1-9][0-9]*$'"
+      )
+    )
+  end
+
+  def down do
+    execute("SET LOCAL lock_timeout = '2s'")
+    execute("SET LOCAL statement_timeout = '20s'")
+
+    drop(index(:news_items, [:object_id], name: :news_items_episode_object_id_unique))
+  end
+end
