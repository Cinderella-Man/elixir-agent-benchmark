From f8bf159bbcae2d76241b20cf4b481df42448ec25 Mon Sep 17 00:00:00 2001
From: Leandro Pereira <leandro@leandro.io>
Date: Wed, 4 Dec 2024 13:19:11 -0500
Subject: [PATCH 3/3] Update lib/beacon/loader.ex

Co-authored-by: Andrew Berrien <74077809+APB9785@users.noreply.github.com>
---
 lib/beacon/loader.ex | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/lib/beacon/loader.ex b/lib/beacon/loader.ex
index b866c4ff0..14b60f3a3 100644
--- a/lib/beacon/loader.ex
+++ b/lib/beacon/loader.ex
@@ -41,6 +41,8 @@ defmodule Beacon.Loader do
   rescue
     error ->
       if live_data_module?(module) do
+        # LiveData is user-provided code, which always has the possibility of errors.
+        # In this case, we want to ensure the original error is surfaced to the user for easier debugging.
         reraise error, __STACKTRACE__
       else
         raise_invoke_error(site, error, module, function, args, opts[:context], __STACKTRACE__)
