+  test "when batch function raises it emits an :exception telemetry event", %{test: test} do
+    doc = """
+    {raising}
+    """
+
+    :ok =
+      :telemetry.attach_many(
+        "#{test}",
+        [
+          [:absinthe, :middleware, :batch, :start],
+          [:absinthe, :middleware, :batch, :exception]
+        ],
