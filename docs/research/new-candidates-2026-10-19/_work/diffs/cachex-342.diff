+    assert Cachex.get!(cache, 1) == nil
+
+    # manually trigger a cache warming of all modules
+    assert Cachex.warm(cache, wait: true) == {:ok, [:manual_warmer2]}
+    assert Cachex.get!(cache, 1) == 1
+  end
