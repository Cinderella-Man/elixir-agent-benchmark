+            { :orelse,
+              { :==, :"$3", nil },
+              { :>, {:+, :"$2", :"$3" }, _now }
+            }
+          }
+        ],
+        [ :"$1" ]
+      }
+    ] = query2
+  end
+
+  # The `create_unexpired_query()` function is just a wrapper to `create_query`
