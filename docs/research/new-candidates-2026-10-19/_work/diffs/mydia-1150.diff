diff --git a/lib/mydia/jobs/startup_jitter.ex b/lib/mydia/jobs/startup_jitter.ex
new file mode 100644
index 000000000..22a0a281c
--- /dev/null
+++ b/lib/mydia/jobs/startup_jitter.ex
@@ -0,0 +1,40 @@
+defmodule Mydia.Jobs.StartupJitter do
+  @moduledoc """
+  Delays a cron job's first run by a random snooze, so self-hosted installs do
+  not all hit the shared metadata relay at the same crontab minute.
+
+  A job is on its first run when it has never been snoozed. That is read from
+  `meta["snoozed"]`, never from `attempt`: since Oban 2.24 a snooze rolls
+  `attempt` back, so a job that snoozes whenever `attempt == 1` sees
+  `attempt == 1` again on every wake and snoozes forever. That shipped once and
+  stalled `Mydia.Jobs.MetadataRefresh` and `Mydia.Jobs.AiringEpisodeRefresh`
+  on every install for a month.
+
+  Every `{:snooze, _}` in `lib/` goes through this module, which
+  `test/mydia/jobs/startup_jitter_test.exs` enforces.
+  """
+
+  require Logger
+
+  @doc """
+  Returns `{:snooze, seconds}` with `seconds` in `1..max_seconds` on the job's
+  first run, and `:run` once it has snoozed.
+
+  Pair it with `with` so the snooze passes straight through:
+
+      with :run <- StartupJitter.delay(job, 15 * 60), do: run_pass()
+  """
+  @spec delay(Oban.Job.t(), pos_integer()) :: {:snooze, pos_integer()} | :run
+  def delay(%Oban.Job{} = job, max_seconds) when is_integer(max_seconds) and max_seconds > 0 do
+    if snoozed?(job) do
+      :run
+    else
+      seconds = :rand.uniform(max_seconds)
+      Logger.info("#{job.worker} scheduled, snoozing #{seconds}s to spread relay load")
+      {:snooze, seconds}
+    end
+  end
+
+  defp snoozed?(%Oban.Job{meta: %{"snoozed" => count}}) when is_integer(count), do: count > 0
+  defp snoozed?(%Oban.Job{}), do: false
+end
diff --git a/priv/repo/migrations/20261015143712_cancel_snooze_looped_refresh_jobs.exs b/priv/repo/migrations/20261015143712_cancel_snooze_looped_refresh_jobs.exs
new file mode 100644
index 000000000..a24f8cab6
--- /dev/null
+++ b/priv/repo/migrations/20261015143712_cancel_snooze_looped_refresh_jobs.exs
@@ -0,0 +1,36 @@
+defmodule Mydia.Repo.Migrations.CancelSnoozeLoopedRefreshJobs do
+  use Ecto.Migration
+
+  @moduledoc """
+  Cancels the cron runs of `Mydia.Jobs.MetadataRefresh` and
+  `Mydia.Jobs.AiringEpisodeRefresh` that never ran.
+
+  Both workers snoozed whenever `attempt == 1`, and Oban 2.24 rolls `attempt`
+  back on snooze, so every cron run since that upgrade snoozed forever. Each
+  install holds one stuck row per missed run (120 airing refreshes on one
+  install after a month). With the snooze fixed they would all wake inside the
+  same few minutes and re-read the same seasons from the shared relay over and
+  over. One fresh run is enough: the next crontab tick inserts it.
+
+  Only `scheduled` rows that have snoozed are touched. `Mydia.Jobs.MetadataBackfill`
+  also inserts `scheduled` per-item `MetadataRefresh` rows, but those never
+  snooze, so they carry no `"snoozed"` key in `meta` and run as planned.
+  `meta` is TEXT on SQLite and jsonb on PostgreSQL; casting it to text makes
+  the key check portable.
+  """
+
+  def up do
+    execute("""
+    UPDATE oban_jobs
+    SET state = 'cancelled', cancelled_at = CURRENT_TIMESTAMP
+    WHERE worker IN ('Mydia.Jobs.MetadataRefresh', 'Mydia.Jobs.AiringEpisodeRefresh')
+      AND state = 'scheduled'
+      AND CAST(meta AS TEXT) LIKE '%"snoozed"%'
+    """)
+  end
+
+  def down do
+    # The cancelled rows were duplicates of a run the cron plugin inserts again.
+    :ok
+  end
+end
