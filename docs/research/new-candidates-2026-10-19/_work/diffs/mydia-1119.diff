+      |> render_submit()
+
+      render_async(view)
+      view
+    end
+
+    test "a result on the other provider sharing the current id stays pickable", %{conn: conn} do
+      {conn, _user} = register_and_log_in_user(conn)
+      shared_id = Mydia.MetadataStubProvider.series_tvdb_id()
