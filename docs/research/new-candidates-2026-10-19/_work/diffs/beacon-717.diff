+  @spec update_js_hook(JSHook.t(), map()) :: {:ok, JSHook.t()} | {:error, Changeset.t()}
+  def update_js_hook(js_hook, attrs) do
+    js_hook
+    |> JSHook.changeset(attrs)
+    |> repo(js_hook).update()
+    |> tap(&maybe_broadcast_updated_content_event(&1, :js_hook))
+  end
