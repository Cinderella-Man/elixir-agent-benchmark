+  @spec get_js_hook_by(Site.t(), keyword(), keyword()) :: JSHook.t() | nil
+  def get_js_hook_by(site, clauses, opts \\ []) when is_atom(site) and is_list(clauses) do
+    clauses = Keyword.put(clauses, :site, site)
