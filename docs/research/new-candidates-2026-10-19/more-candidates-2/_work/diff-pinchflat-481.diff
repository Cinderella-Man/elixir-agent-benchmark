+    ~H"""
+    <.table rows={@sources} table_class="text-white">
+      <:col :let={source} label="Name">
+        <.subtle_link href={~p"/sources/#{source.id}"}>
+          <%= StringUtils.truncate(source.custom_name || source.collection_name, 35) %>
+        </.subtle_link>
+      </:col>
