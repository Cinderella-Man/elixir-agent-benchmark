diff --git a/assets/app/components/avatar_list.scss b/assets/app/components/avatar_list.scss
index d350e08a33..73390ea835 100644
--- a/assets/app/components/avatar_list.scss
+++ b/assets/app/components/avatar_list.scss
@@ -1,13 +1,24 @@
 .avatar_list {
   display: flex;
+  flex-wrap: wrap;
   justify-content: center;
 
   &-item {
     display: block;
+    flex: 0 1 100px;
     font-size: 0.875em;
-    margin: 1em;
+    margin: 1em 0;
+    min-width: 70px;
     text-align: center;
 
+    .avatar_list--large & {
+      @include breakpoint(huge, max) {
+        flex: 0 1 50px;
+        min-width: 50px;
+      }
+    }
+
+
     &:hover {
       p { color: $white; }
     }
@@ -18,12 +29,27 @@
       display: block;
       font-size: 8px;
       margin: 0 auto;
+      width: 50px;
+      height: 50px;
+
+      .avatar_list--large & {
+        @include breakpoint(huge, max) {
+          width: 30px;
+          height: 30px;
+        }
+      }
     }
 
     p {
       color: $medium-grey;
       margin: 1em 0 0;
       transition: color 0.1s $base-easing;
+
+      .avatar_list--large & {
+        @include breakpoint(huge, max) {
+          display: none;
+        }
+      }
     }
   }
 }
diff --git a/lib/changelog_web/templates/episode/show.html.eex b/lib/changelog_web/templates/episode/show.html.eex
index c16dbaafca..95a2ac7f0c 100644
--- a/lib/changelog_web/templates/episode/show.html.eex
+++ b/lib/changelog_web/templates/episode/show.html.eex
@@ -20,7 +20,7 @@
 
       <div class="episode-header-guests">
         <h4 class="visually_hidden">Guests</h4>
-        <div class="avatar_list">
+        <div class="avatar_list<%= if Enum.count(@episode.guests) > 6 do %> avatar_list--large<% end %>">
           <%= for person <- @episode.guests do %>
             <%= link to: PersonView.external_url(person), class: "avatar_list-item", title: person.name, rel: "external" do %>
               <img src="<%= PersonView.avatar_url(person) %>" width=50 height=50 alt="<%= person.name %>"/>
