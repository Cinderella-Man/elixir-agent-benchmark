+      %FacetStatement{
+        items: ["phoenix", "liveview"],
+        logic: :and,
+        repr: :topic
+      },
+      :sub_facet_end,
+      %FacetStatement{items: ["changelog"], logic: :and, repr: :podcast}
+    ]
+  }
+
+  @samples [
+    %{
+      id: :weird_one,
+      podcast: "somethingelse",
