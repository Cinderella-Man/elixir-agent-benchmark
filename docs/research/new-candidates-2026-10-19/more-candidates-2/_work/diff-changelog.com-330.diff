+      %FacetStatement{items: ["code"], logic: :and, repr: :topic},
+      :sub_facet_end,
+      %FacetStatement{items: ["svelte"], logic: :and, repr: :topic},
+      %FacetStatement{
+        items: ["phoenix", "liveview"],
+        logic: :and,
+        repr: :topic
