+            <span class="font-medium text-base-50">{connection.workspace.team_name}</span>
+            <span class="text-sm text-base-400">
+              Connected by {if connection.connected_by, do: connection.connected_by.name, else: "a former member"} on
+              <.local_datetime at={connection.inserted_at} time_zone={@time_zone} format={:long_date} zone_label={false} />
+            </span>
+          </div>
+
+          <.button
+            :if={authorized?(:"slack_connection:delete", @current_scope)}
+            type="button"
+            phx-click="disconnect-slack"
+            phx-value-connection_id={connection.id}
+            data-confirm={"Disconnect the #{connection.workspace.team_name} Slack workspace? Its channels stop hearing from this organization."}
+          >
+            Disconnect
+          </.button>
+        </div>
+      </div>
+
       <div class="flex w-full flex-col rounded border border-base-700 bg-surface-raised">
         <div class="flex h-14 items-center justify-between border-b border-base-700 px-4">
           <div class="text-base font-medium text-base-50">Webhooks</div>
diff --git a/lib/nerves_hub_web/plugs/cache_raw_body.ex b/lib/nerves_hub_web/plugs/cache_raw_body.ex
new file mode 100644
index 000000000..afb3bbde2
--- /dev/null
+++ b/lib/nerves_hub_web/plugs/cache_raw_body.ex
@@ -0,0 +1,32 @@
+defmodule NervesHubWeb.Plugs.CacheRawBody do
+  @moduledoc """
+  A `Plug.Parsers` body reader that keeps a copy of the raw body, as
+  `conn.assigns.raw_body`, for requests whose signature covers it: those
+  other services send to `/integrations/`, such as Slack's (see
+  `NervesHubWeb.Integrations.Slack.VerifyRequest`).
+
+  Other requests are read as `Plug.Conn.read_body/2` would, and keep nothing,
+  so a large upload is not held in memory twice.
+  """
+
+  @paths ["/integrations/"]
+
+  @spec read_body(Plug.Conn.t(), keyword()) :: {:ok | :more, binary(), Plug.Conn.t()} | {:error, term()}
+  def read_body(conn, opts) do
+    case Plug.Conn.read_body(conn, opts) do
+      {status, body, conn} when status in [:ok, :more] ->
+        {status, body, keep(conn, body)}
+
+      error ->
+        error
+    end
+  end
+
+  defp keep(%Plug.Conn{request_path: path} = conn, body) do
+    if String.starts_with?(path, @paths) do
+      Plug.Conn.assign(conn, :raw_body, (conn.assigns[:raw_body] || "") <> body)
+    else
+      conn
+    end
+  end
+end
