diff --git a/lib/nerves_hub_web/controllers/api/schemas/webhook_schemas.ex b/lib/nerves_hub_web/controllers/api/schemas/webhook_schemas.ex
new file mode 100644
index 000000000..f96a3fb49
--- /dev/null
+++ b/lib/nerves_hub_web/controllers/api/schemas/webhook_schemas.ex
@@ -0,0 +1,207 @@
+defmodule NervesHubWeb.API.Schemas.WebhookSchemas do
+  alias NervesHub.Webhooks.Events
+  alias OpenApiSpex.Schema
+
+  require OpenApiSpex
+
+  defmodule Webhook do
+    require OpenApiSpex
+
+    OpenApiSpex.schema(%{
+      description: "An organization webhook, without its signing secret",
+      type: :object,
+      properties: %{
+        id: %Schema{type: :integer},
+        url: %Schema{type: :string, description: "Where events are sent"},
+        description: %Schema{type: :string, nullable: true, description: "What receives these events"},
+        events: %Schema{
+          type: :array,
+          items: %Schema{type: :string, enum: Events.types()},
+          description: "The event types delivered to this webhook"
+        },
+        all_products: %Schema{
+          type: :boolean,
+          description:
+            "Whether the webhook sends the events of every product in the organization, including products added later"
+        },
+        products: %Schema{
+          type: :array,
+          items: %Schema{type: :string},
+          description: "The names of the products whose events are sent, when `all_products` is false"
+        },
+        enabled: %Schema{type: :boolean, description: "Whether events are being sent"},
+        disabled_reason: %Schema{
+          type: :string,
+          nullable: true,
+          description: "Why NervesHub turned the webhook off, if it did. Cleared when it is turned back on."
+        },
+        failing_since: %Schema{
+          type: :string,
+          format: :"date-time",
+          nullable: true,
+          description: "When deliveries started failing, or null while the endpoint is accepting them"
+        },
+        last_error: %Schema{type: :string, nullable: true, description: "The most recent delivery failure"},
+        last_error_at: %Schema{type: :string, format: :"date-time", nullable: true},
+        inserted_at: %Schema{type: :string, format: :"date-time"},
+        updated_at: %Schema{type: :string, format: :"date-time"}
+      },
+      example: %{
+        "id" => 12,
+        "url" => "https://hooks.example.com/nerves-hub",
+        "description" => "Fleet dashboard",
+        "events" => ["device.connected", "device.disconnected"],
+        "all_products" => false,
+        "products" => ["thermostat"],
+        "enabled" => true,
+        "disabled_reason" => nil,
+        "failing_since" => nil,
+        "last_error" => nil,
+        "last_error_at" => nil,
+        "inserted_at" => "2026-10-13T09:00:00",
+        "updated_at" => "2026-10-13T09:00:00"
+      }
+    })
+  end
+
+  defmodule WebhookWithSecret do
+    require OpenApiSpex
+
+    OpenApiSpex.schema(%{
+      description:
+        "A webhook and its signing secret. Only returned when the webhook is created and when its secret is regenerated.",
+      allOf: [
+        Webhook,
+        %Schema{
+          type: :object,
+          properties: %{
+            secret: %Schema{
+              type: :string,
+              description: "The Standard Webhooks signing secret: `whsec_` followed by base64"
+            }
+          }
+        }
+      ],
+      example: %{
+        "id" => 12,
+        "url" => "https://hooks.example.com/nerves-hub",
+        "description" => "Fleet dashboard",
+        "events" => ["device.connected", "device.disconnected"],
+        "all_products" => false,
+        "products" => ["thermostat"],
+        "enabled" => true,
+        "disabled_reason" => nil,
+        "failing_since" => nil,
+        "last_error" => nil,
+        "last_error_at" => nil,
+        "inserted_at" => "2026-10-13T09:00:00",
+        "updated_at" => "2026-10-13T09:00:00",
+        "secret" => "whsec_[44 base64 characters]"
+      }
+    })
+  end
+
+  defmodule WebhookListResponse do
+    OpenApiSpex.schema(%{
+      description: "The organization's webhooks, oldest first",
+      type: :object,
+      properties: %{data: %Schema{type: :array, items: Webhook}}
+    })
+  end
+
+  defmodule WebhookResponse do
+    OpenApiSpex.schema(%{
+      description: "A webhook",
+      type: :object,
+      properties: %{data: Webhook}
+    })
+  end
+
+  defmodule WebhookWithSecretResponse do
+    OpenApiSpex.schema(%{
+      description: "A webhook and its signing secret",
+      type: :object,
+      properties: %{data: WebhookWithSecret}
+    })
+  end
+
+  defmodule WebhookCreateRequest do
+    OpenApiSpex.schema(%{
+      description: "POST body for adding a webhook to an organization",
+      type: :object,
+      properties: %{
+        url: %Schema{type: :string, description: "An `https://` or `http://` URL with no username or password"},
+        description: %Schema{type: :string, description: "Optional: what receives these events"},
+        events: %Schema{
+          type: :array,
+          items: %Schema{type: :string, enum: Events.types()},
+          description: "At least one event type"
+        },
+        all_products: %Schema{
+          type: :boolean,
+          description:
+            "Send the events of every product in the organization, including products added later. Defaults to true, or to false when `products` is given."
+        },
+        products: %Schema{
+          type: :array,
+          items: %Schema{type: :string},
+          description: "The names of the products whose events to send, instead of every product's"
+        },
+        enabled: %Schema{type: :boolean, default: true}
+      },
+      required: [:url, :events],
+      example: %{
+        "url" => "https://hooks.example.com/nerves-hub",
+        "description" => "Fleet dashboard",
+        "events" => ["device.connected", "device.disconnected"],
+        "products" => ["thermostat"]
+      }
+    })
+  end
+
+  defmodule WebhookUpdateRequest do
+    OpenApiSpex.schema(%{
+      description:
+        "PUT/PATCH body for changing a webhook. Omitted fields are left as they are. Turning a webhook on clears what failed deliveries recorded about it.",
+      type: :object,
+      properties: %{
+        url: %Schema{type: :string},
+        description: %Schema{type: :string},
+        events: %Schema{type: :array, items: %Schema{type: :string, enum: Events.types()}},
+        all_products: %Schema{
+          type: :boolean,
+          description: "Send every product's events. Given `products` without this, it is taken as false."
+        },
+        products: %Schema{
+          type: :array,
+          items: %Schema{type: :string},
+          description: "The names of the products whose events to send, replacing the current list"
+        },
+        enabled: %Schema{type: :boolean}
+      },
+      example: %{"events" => ["device.connected"], "all_products" => true, "enabled" => true}
+    })
+  end
+
+  defmodule WebhookTestResponse do
+    OpenApiSpex.schema(%{
+      description: "How the webhook's endpoint answered a `webhook.test` event",
+      type: :object,
+      properties: %{
+        data: %Schema{
+          type: :object,
+          properties: %{
+            delivered: %Schema{type: :boolean, description: "Whether the endpoint answered with a 2xx status"},
+            status: %Schema{
+              type: :integer,
+              nullable: true,
+              description: "The endpoint's response status, or null when there was no response"
+            },
+            error: %Schema{type: :string, nullable: true, description: "Why the delivery failed, if it did"}
+          }
+        }
+      },
+      example: %{"data" => %{"delivered" => false, "status" => 500, "error" => "HTTP 500"}}
+    })
+  end
+end
diff --git a/lib/nerves_hub_web/controllers/api/webhook_controller.ex b/lib/nerves_hub_web/controllers/api/webhook_controller.ex
new file mode 100644
index 000000000..32f91de65
--- /dev/null
+++ b/lib/nerves_hub_web/controllers/api/webhook_controller.ex
@@ -0,0 +1,163 @@
+defmodule NervesHubWeb.API.WebhookController do
+  @moduledoc """
+  An organization's webhooks: the endpoints its products' device events are
+  sent to. The same webhooks the organization's Integrations settings manage;
+  see `NervesHub.Webhooks` and `docs/webhooks.md`.
+
+  Every action needs the manage role, reading included. On the settings page,
+  view-only members see a webhook's host but not its URL, because some
+  receivers carry their credentials in the URL. An API response has no
+  halfway, so it is all or nothing.
+
+  The signing secret is returned when a webhook is created and when its
+  secret is regenerated, and never listed. A caller that has lost it
+  regenerates it.
+  """
+  use NervesHubWeb, :api_controller
+  use OpenApiSpex.ControllerSpecs
+
+  alias NervesHub.Webhooks
+  alias NervesHubWeb.API.OpenAPI.SchemaHelpers
+  alias NervesHubWeb.API.Schemas.ErrorSchemas
+  alias NervesHubWeb.API.Schemas.WebhookSchemas
+
+  security([%{"bearer_auth" => []}])
+  tags(["Webhooks"])
+
+  @auth_error_responses SchemaHelpers.auth_error_responses()
+
+  plug(:validate_role, org: :manage)
+
+  @org_path_parameters [
+    org_name: [in: :path, description: "Organization Name", type: :string, example: "example_org"]
+  ]
+
+  @webhook_path_parameters @org_path_parameters ++
+                             [id: [in: :path, description: "Webhook ID", type: :integer, example: 12]]
+
+  @not_found {"Not Found", "application/json", ErrorSchemas.ErrorResponse}
+  @unprocessable {"Unprocessable Entity", "application/json", ErrorSchemas.ChangesetErrorResponse}
+
+  operation(:index,
+    summary: "List an Organization's Webhooks",
+    description: "Lists the organization's webhooks, oldest first, without their signing secrets.",
+    parameters: @org_path_parameters,
+    responses:
+      [ok: {"Webhook list response", "application/json", WebhookSchemas.WebhookListResponse}] ++
+        @auth_error_responses
+  )
+
+  def index(%{assigns: %{current_scope: scope}} = conn, _params) do
+    render(conn, :index, webhooks: Webhooks.list_webhooks(scope.org))
+  end
+
+  operation(:show,
+    summary: "Get a Webhook",
+    description: "Includes the webhook's delivery state, such as when it started failing, but not its signing secret.",
+    parameters: @webhook_path_parameters,
+    responses:
+      [ok: {"Webhook response", "application/json", WebhookSchemas.WebhookResponse}, not_found: @not_found] ++
+        @auth_error_responses
+  )
+
+  def show(%{assigns: %{current_scope: scope}} = conn, %{"id" => id}) do
+    with {:ok, webhook} <- Webhooks.fetch_webhook(scope.org, id) do
+      render(conn, :show, webhook: webhook)
+    end
+  end
+
+  operation(:create,
+    summary: "Add a Webhook to an Organization",
+    description:
+      "Creates a webhook with a newly generated signing secret, returned once, in this response. It sends the events of every product in the organization, including products added later, unless `products` names the ones to send. An organization can have at most #{Webhooks.max_webhooks_per_org()} webhooks.",
+    parameters: @org_path_parameters,
+    request_body:
+      {"Webhook creation request body", "application/json", WebhookSchemas.WebhookCreateRequest, required: true},
+    responses:
+      [
+        created: {"Webhook with secret response", "application/json", WebhookSchemas.WebhookWithSecretResponse},
+        unprocessable_entity: @unprocessable
+      ] ++ @auth_error_responses
+  )
+
+  def create(%{assigns: %{current_scope: scope}} = conn, params) do
+    with {:ok, webhook} <- Webhooks.create_webhook(scope, params) do
+      conn
+      |> put_status(:created)
+      |> render(:with_secret, webhook: webhook)
+    end
+  end
+
+  operation(:update,
+    summary: "Update a Webhook",
+    description:
+      "Changes a webhook's URL, description, events, products, or whether it is on. The signing secret is not changed.",
+    parameters: @webhook_path_parameters,
+    request_body:
+      {"Webhook update request body", "application/json", WebhookSchemas.WebhookUpdateRequest, required: true},
+    responses:
+      [
+        ok: {"Webhook response", "application/json", WebhookSchemas.WebhookResponse},
+        not_found: @not_found,
+        unprocessable_entity: @unprocessable
+      ] ++ @auth_error_responses
+  )
+
+  def update(%{assigns: %{current_scope: scope}} = conn, %{"id" => id} = params) do
+    with {:ok, webhook} <- Webhooks.fetch_webhook(scope.org, id),
+         {:ok, webhook} <- Webhooks.update_webhook(scope, webhook, params) do
+      render(conn, :show, webhook: webhook)
+    end
+  end
+
+  operation(:delete,
+    summary: "Delete a Webhook",
+    description: "Removes the webhook. Deliveries already queued for it are dropped.",
+    parameters: @webhook_path_parameters,
+    responses: [no_content: "Empty response", not_found: @not_found] ++ @auth_error_responses
+  )
+
+  def delete(%{assigns: %{current_scope: scope}} = conn, %{"id" => id}) do
+    with {:ok, webhook} <- Webhooks.fetch_webhook(scope.org, id),
+         {:ok, _webhook} <- Webhooks.delete_webhook(scope, webhook) do
+      send_resp(conn, :no_content, "")
+    end
+  end
+
+  operation(:regenerate_secret,
+    summary: "Regenerate a Webhook's Signing Secret",
+    description:
+      "Replaces the signing secret and returns the new one, once, in this response. The old secret stops working at once, retries of earlier events included.",
+    parameters: @webhook_path_parameters,
+    responses:
+      [
+        ok: {"Webhook with secret response", "application/json", WebhookSchemas.WebhookWithSecretResponse},
+        not_found: @not_found
+      ] ++ @auth_error_responses
+  )
+
+  def regenerate_secret(%{assigns: %{current_scope: scope}} = conn, %{"id" => id}) do
+    with {:ok, webhook} <- Webhooks.fetch_webhook(scope.org, id),
+         {:ok, webhook} <- Webhooks.regenerate_secret(scope, webhook) do
+      render(conn, :with_secret, webhook: webhook)
+    end
+  end
+
+  operation(:send_test,
+    summary: "Send a Test Event to a Webhook",
+    description:
+      "Sends a `webhook.test` event to the webhook straight away, whether or not it is on, and reports how the endpoint answered. Responds 200 either way: `delivered` says whether the endpoint accepted it. Takes up to 20 seconds when the endpoint is slow. The result is not recorded against the webhook.",
+    parameters: @webhook_path_parameters,
+    responses:
+      [
+        ok: {"Webhook test response", "application/json", WebhookSchemas.WebhookTestResponse},
+        not_found: @not_found
+      ] ++ @auth_error_responses
+  )
+
+  def send_test(%{assigns: %{current_scope: scope}} = conn, %{"id" => id}) do
+    with {:ok, webhook} <- Webhooks.fetch_webhook(scope.org, id) do
+      render(conn, :test_result, result: Webhooks.send_test_event(scope, webhook))
+    end
+  end
+end
diff --git a/lib/nerves_hub_web/controllers/api/webhook_json.ex b/lib/nerves_hub_web/controllers/api/webhook_json.ex
new file mode 100644
index 000000000..ea395906e
--- /dev/null
+++ b/lib/nerves_hub_web/controllers/api/webhook_json.ex
@@ -0,0 +1,47 @@
+defmodule NervesHubWeb.API.WebhookJSON do
+  @moduledoc """
+  Renders an organization's webhooks.
+
+  Webhooks are built field by field so the signing secret cannot slip in.
+  `with_secret/1` is the one view that includes it, and only the actions that
+  make a secret (create, regenerate) render it.
+  """
+
+  def index(%{webhooks: webhooks}) do
+    %{data: for(webhook <- webhooks, do: webhook(webhook))}
+  end
+
+  def show(%{webhook: webhook}) do
+    %{data: webhook(webhook)}
+  end
+
+  def with_secret(%{webhook: webhook}) do
+    %{data: webhook |> webhook() |> Map.put(:secret, webhook.secret)}
+  end
+
+  def test_result(%{result: {:ok, status}}) do
+    %{data: %{delivered: true, status: status, error: nil}}
+  end
+
+  def test_result(%{result: {:error, status, message}}) do
+    %{data: %{delivered: false, status: status, error: message}}
+  end
+
+  defp webhook(webhook) do
+    %{
+      id: webhook.id,
+      url: webhook.url,
+      description: webhook.description,
+      events: webhook.events,
+      all_products: webhook.all_products,
+      products: Enum.map(webhook.products, & &1.name),
+      enabled: webhook.enabled,
+      disabled_reason: webhook.disabled_reason,
+      failing_since: webhook.failing_since,
+      last_error: webhook.last_error,
+      last_error_at: webhook.last_error_at,
+      inserted_at: webhook.inserted_at,
+      updated_at: webhook.updated_at
+    }
+  end
+end
