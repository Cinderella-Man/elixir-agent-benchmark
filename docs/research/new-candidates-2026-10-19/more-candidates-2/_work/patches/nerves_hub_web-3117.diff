diff --git a/lib/nerves_hub/webhooks.ex b/lib/nerves_hub/webhooks.ex
new file mode 100644
index 000000000..010b8f7b6
--- /dev/null
+++ b/lib/nerves_hub/webhooks.ex
@@ -0,0 +1,538 @@
+defmodule NervesHub.Webhooks do
+  @moduledoc """
+  Webhooks: HTTP endpoints an organization sends device events to.
+
+  An organization has up to twenty webhooks, each with a URL, a signing
+  secret, the event types it subscribes to (`NervesHub.Webhooks.Events`), and
+  the products whose events it sends: every product in the organization, or
+  the ones it lists. They are configured on the organization's Integrations
+  settings page. `docs/webhooks.md` is the receiver's documentation: payloads,
+  headers, signing and retries.
+
+  ## Raising events
+
+  Code where something happens to a device calls `dispatch/3` with the product,
+  the event type and a function that builds the event's `data`. When none of
+  the enabled webhooks that hear the product subscribe to the type, which is
+  nearly every call, that is one ETS read (`NervesHub.Webhooks.Cache`) and
+  nothing else: the function is not run, and nothing touches the database.
+  Otherwise the event is encoded once and one
+  `NervesHub.Workers.DeliverWebhook` job is inserted per subscribed webhook.
+
+  Events are raised on whichever node the device is connected to. Device nodes
+  run no Oban queues but can insert jobs, so deliveries go out from web nodes,
+  off the device's connection.
+
+  Called inside a transaction, the jobs are part of it: an outcome that rolls
+  back takes its webhook with it.
+
+  ## Delivery
+
+  At least once, unordered. Each event has an id, sent as `webhook-id`, that
+  stays the same across retries so a receiver can discard a repeat. See
+  `NervesHub.Workers.DeliverWebhook` for retries, and `record_failure/3` for
+  how a failing endpoint is backed off and eventually turned off.
+  """
+
+  import Ecto.Query
+
+  alias Ecto.Changeset
+  alias NervesHub.Accounts.Org
+  alias NervesHub.Accounts.Scope
+  alias NervesHub.AuditLogs.OrgTemplates
+  alias NervesHub.ProductNotifications
+  alias NervesHub.Products.Product
+  alias NervesHub.Repo
+  alias NervesHub.Webhooks.Cache
+  alias NervesHub.Webhooks.Delivery
+  alias NervesHub.Webhooks.Events
+  alias NervesHub.Webhooks.Webhook
+  alias NervesHub.Workers.DeliverWebhook
+
+  require Logger
+
+  @max_webhooks_per_org 20
+
+  # An encoded event larger than this is dropped rather than queued. The
+  # biggest legitimate payload, a full metrics batch, is a few tens of
+  # kilobytes; anything near this is a device sending something it should not,
+  # and every delivery attempt would carry it again.
+  @max_body_bytes 256 * 1024
+
+  # Failures are written to the webhook at most this often. A dead endpoint
+  # fails every delivery queued for it, and each one writing the same row
+  # would turn one broken receiver into contention on that row.
+  @failure_write_interval_seconds 30
+
+  # While an endpoint is failing, deliveries in this window after a failure
+  # skip the request and count as failed attempts themselves. See
+  # `cooling_down?/2`.
+  @cooldown_seconds 30
+
+  # An endpoint that has not accepted a single delivery for this long is
+  # turned off, and the members of the products it served are told.
+  @disable_after_hours 24
+
+  @doc "How many webhooks an organization may have."
+  def max_webhooks_per_org(), do: @max_webhooks_per_org
+
+  @doc "The organization's webhooks, oldest first, with the products each lists."
+  @spec list_webhooks(Org.t()) :: [Webhook.t()]
+  def list_webhooks(%Org{id: org_id}) do
+    Webhook
+    |> where(org_id: ^org_id)
+    |> order_by(asc: :inserted_at, asc: :id)
+    |> preload(:products)
+    |> Repo.all()
+  end
+
+  @doc """
+  One of the organization's webhooks, with the products it lists. Raises if
+  the organization has no webhook with that id.
+  """
+  @spec get_webhook!(Org.t(), pos_integer() | String.t()) :: Webhook.t()
+  def get_webhook!(%Org{id: org_id}, id) do
+    Webhook
+    |> where(id: ^id, org_id: ^org_id)
+    |> preload(:products)
+    |> Repo.one!()
+  end
+
+  @doc """
+  One of the organization's webhooks, with the products it lists, or
+  `{:error, :not_found}`, including for an id that is not a number (it
+  arrives from a URL).
+  """
+  @spec fetch_webhook(Org.t(), pos_integer() | String.t()) :: {:ok, Webhook.t()} | {:error, :not_found}
+  def fetch_webhook(%Org{id: org_id}, id) do
+    case Ecto.Type.cast(:id, id) do
+      {:ok, id} ->
+        Webhook
+        |> where(id: ^id, org_id: ^org_id)
+        |> preload(:products)
+        |> Repo.fetch()
+
+      :error ->
+        {:error, :not_found}
+    end
+  end
+
+  @doc """
+  A changeset for the webhook form. `attrs` names products by name, and they
+  are looked up in `org`.
+  """
+  @spec change_webhook(Org.t(), Webhook.t(), map()) :: Changeset.t()
+  def change_webhook(%Org{} = org, %Webhook{} = webhook, attrs \\ %{}) do
+    attrs = scope_attrs(attrs)
+
+    webhook
+    |> Repo.preload(:products)
+    |> Webhook.changeset(attrs, find_products(org, attrs))
+  end
+
+  @doc """
+  Adds a webhook to the scope's organization, with a newly generated signing
+  secret.
+
+  `attrs` may limit it to some of the organization's products, by name, with
+  `"all_products" => false` and `"products"`. Naming products without saying
+  `"all_products"` limits it to them. Otherwise it sends every product's
+  events, including products added later.
+
+  Returns `{:error, :too_many_webhooks}` when the organization already has
+  `max_webhooks_per_org/0`. The limit bounds how many deliveries a single
+  device event can fan out into.
+  """
+  @spec create_webhook(Scope.t(), map()) :: {:ok, Webhook.t()} | {:error, Changeset.t() | :too_many_webhooks}
+  def create_webhook(%Scope{org: org, user: user}, attrs) do
+    attrs = scope_attrs(attrs)
+
+    Repo.transact(fn ->
+      count = Webhook |> where(org_id: ^org.id) |> Repo.aggregate(:count)
+
+      with true <- count < @max_webhooks_per_org || {:error, :too_many_webhooks},
+           {:ok, webhook} <- org |> Webhook.create_changeset(attrs, find_products(org, attrs)) |> Repo.insert() do
+        :ok = OrgTemplates.audit_webhook_created(user, org, webhook)
+        {:ok, webhook}
+      end
+    end)
+    |> tap(&invalidate_on_success(&1, org))
+  end
+
+  @doc """
+  Changes a webhook's URL, description, events, products, or whether it is on.
+  Products are named and limited as `create_webhook/2` describes; a change
+  that names none leaves them as they are.
+  """
+  @spec update_webhook(Scope.t(), Webhook.t(), map()) :: {:ok, Webhook.t()} | {:error, Changeset.t()}
+  def update_webhook(%Scope{org: org, user: user}, %Webhook{} = webhook, attrs) do
+    attrs = scope_attrs(attrs)
+
+    Repo.transact(fn ->
+      changeset =
+        webhook
+        |> Repo.preload(:products)
+        |> Webhook.changeset(attrs, find_products(org, attrs))
+
+      with {:ok, updated} <- Repo.update(changeset) do
+        :ok = OrgTemplates.audit_webhook_updated(user, org, updated)
+        {:ok, updated}
+      end
+    end)
+    |> tap(&invalidate_on_success(&1, org))
+  end
+
+  @doc """
+  Removes a webhook. Deliveries already queued for it are dropped when they
+  come up.
+  """
+  @spec delete_webhook(Scope.t(), Webhook.t()) :: {:ok, Webhook.t()} | {:error, Changeset.t()}
+  def delete_webhook(%Scope{org: org, user: user}, %Webhook{} = webhook) do
+    Repo.transact(fn ->
+      with {:ok, deleted} <- Repo.delete(webhook) do
+        :ok = OrgTemplates.audit_webhook_deleted(user, org, deleted)
+        {:ok, deleted}
+      end
+    end)
+    |> tap(&invalidate_on_success(&1, org))
+  end
+
+  @doc """
+  Replaces the webhook's signing secret. Deliveries signed from now on, retries
+  included, use the new one.
+  """
+  @spec regenerate_secret(Scope.t(), Webhook.t()) :: {:ok, Webhook.t()} | {:error, Changeset.t()}
+  def regenerate_secret(%Scope{org: org, user: user}, %Webhook{} = webhook) do
+    Repo.transact(fn ->
+      with {:ok, updated} <- webhook |> Webhook.regenerate_secret_changeset() |> Repo.update() do
+        :ok = OrgTemplates.audit_webhook_secret_regenerated(user, org, updated)
+        {:ok, updated}
+      end
+    end)
+  end
+
+  # Naming products is asking for those products, so a change that lists
+  # them without saying `all_products` means `all_products: false`. Only
+  # string-keyed attributes name products: they come from a form or the API.
+  defp scope_attrs(%{"products" => _} = attrs) when not is_map_key(attrs, "all_products") do
+    Map.put(attrs, "all_products", false)
+  end
+
+  defp scope_attrs(attrs), do: attrs
+
+  # The products a change names, looked up among the organization's own, by
+  # name because the API knows products by name. Looking them up here, not
+  # anywhere a caller could pass a product in, is what keeps a webhook from
+  # hearing another organization's devices.
+  defp find_products(%Org{id: org_id}, %{"products" => names}) when is_list(names) do
+    if Enum.all?(names, &is_binary/1) do
+      names = Enum.uniq(names)
+
+      products =
+        Product
+        |> where([p], p.org_id == ^org_id and p.name in ^names)
+        |> Repo.exclude_deleted()
+        |> order_by(:name)
+        |> Repo.all()
+
+      found = MapSet.new(products, & &1.name)
+      {products, Enum.reject(names, &MapSet.member?(found, &1))}
+    else
+      :invalid
+    end
+  end
+
+  defp find_products(_org, %{"products" => _not_a_list}), do: :invalid
+  defp find_products(_org, _attrs), do: nil
+
+  @doc """
+  Sends a `webhook.test` event to the webhook straight away, and returns how
+  it went.
+
+  Runs in the caller's process and makes the request itself, rather than
+  queueing a job: the person who pressed the button is waiting to see the
+  answer. Sent whether or not the webhook is on, and recorded nowhere, so
+  testing an endpoint never changes what the webhook says about its
+  deliveries.
+  """
+  @spec send_test_event(Scope.t(), Webhook.t()) :: Delivery.result()
+  def send_test_event(%Scope{org: org, user: user}, %Webhook{} = webhook) do
+    data = %{
+      org: %{name: org.name},
+      message: "A test event sent by #{user.name} from NervesHub."
+    }
+
+    Delivery.deliver(webhook, new_event_id(), encode(Events.test_type(), data))
+  end
+
+  @doc """
+  Queues `type` for delivery to every enabled webhook that hears the product
+  and subscribes to the type.
+
+  `build_data` returns the event's `data`, without the `org` and `product`
+  this adds, and is only called when there is somebody to send it to. Strings
+  in it are made safe to store and encode, since much of what an event carries
+  is whatever a device chose to send.
+  """
+  @spec dispatch(pos_integer(), String.t(), (-> map())) :: :ok
+  def dispatch(product_id, type, build_data) when is_function(build_data, 0) do
+    case subscribers(product_id, type) do
+      {_names, []} ->
+        :ok
+
+      {names, webhook_ids} ->
+        body = encode(type, Map.merge(build_data.(), names))
+        enqueue(product_id, type, webhook_ids, body)
+    end
+  end
+
+  @doc """
+  Whether any enabled webhook that hears the product subscribes to `type`.
+
+  For callers that would have to do work just to find out which devices an
+  event is about, such as the stale connection sweep. Everyone else can call
+  `dispatch/3`, which checks the same thing.
+  """
+  @spec subscribed?(pos_integer(), String.t()) :: boolean()
+  def subscribed?(product_id, type) do
+    match?({_names, [_ | _]}, subscribers(product_id, type))
+  end
+
+  # A connection's `product_id` is nullable (it is cleared when the product
+  # goes), and a connection without one has no product's webhooks to tell.
+  defp subscribers(nil, _type), do: {%{}, []}
+
+  defp subscribers(product_id, type) do
+    case Cache.fetch(product_id, fn -> load_subscriptions(product_id) end) do
+      nil ->
+        {%{}, []}
+
+      %{names: names, webhooks: webhooks} ->
+        {names, for({id, events} <- webhooks, type in events, do: id)}
+    end
+  end
+
+  # What dispatching needs to know about a product, in one query: the
+  # product's organization (the cache drops entries by it), the enabled
+  # webhooks that hear the product and their events, and the names every event
+  # carries. The value is `nil` when no webhook hears the product, which is
+  # what the cache holds for nearly every product.
+  #
+  # The webhooks are left-joined so that a product no webhook hears still
+  # comes back, with its organization, as a single row without one.
+  defp load_subscriptions(product_id) do
+    from(p in Product,
+      join: o in Org,
+      on: o.id == p.org_id,
+      left_join: w in subquery(hearing(product_id)),
+      on: w.org_id == o.id,
+      where: p.id == ^product_id and is_nil(p.deleted_at) and is_nil(o.deleted_at),
+      select: {o.id, o.name, p.name, w.id, w.events}
+    )
+    |> Repo.all()
+    |> subscriptions()
+  end
+
+  # The enabled webhooks that hear the product, of any organization: the join
+  # above keeps the product's own. A webhook lists a product at most once (a
+  # unique index), so this is one row per webhook.
+  defp hearing(product_id) do
+    from(w in Webhook,
+      left_join: wp in "webhook_products",
+      on: wp.webhook_id == w.id and wp.product_id == ^product_id,
+      where: w.enabled and (w.all_products or not is_nil(wp.webhook_id)),
+      select: %{id: w.id, org_id: w.org_id, events: w.events}
+    )
+  end
+
+  defp subscriptions([]), do: {nil, nil}
+  defp subscriptions([{org_id, _org_name, _product_name, nil, _events}]), do: {org_id, nil}
+
+  defp subscriptions([{org_id, org_name, product_name, _id, _events} | _] = rows) do
+    {org_id,
+     %{
+       names: %{org: %{name: org_name}, product: %{name: product_name}},
+       webhooks: for({_, _, _, id, events} <- rows, do: {id, events})
+     }}
+  end
+
+  defp enqueue(product_id, type, _webhook_ids, body) when byte_size(body) > @max_body_bytes do
+    Logger.warning("Dropped a #{type} webhook event for product #{product_id}: #{byte_size(body)} bytes encoded")
+    :ok
+  end
+
+  defp enqueue(_product_id, type, webhook_ids, body) do
+    event_id = new_event_id()
+
+    _jobs =
+      webhook_ids
+      |> Enum.map(&DeliverWebhook.new(%{webhook_id: &1, event_id: event_id, type: type, body: body}))
+      |> Oban.insert_all()
+
+    :ok
+  end
+
+  # The specification asks only that ids are unique and contain no full stop.
+  # UUIDv7s sort by time, which makes them easier to read in a receiver's logs.
+  defp new_event_id(), do: "msg_" <> UUIDv7.generate()
+
+  defp encode(type, data) do
+    Jason.encode!(%{
+      type: type,
+      timestamp: DateTime.utc_now(),
+      data: scrub(data)
+    })
+  end
+
+  # Event data includes text devices sent: failure reasons, alarm descriptions,
+  # metadata. Invalid UTF-8 would fail to encode, and a NUL is valid JSON that
+  # PostgreSQL refuses to store in the job's arguments. Either would take the
+  # event, and anything else in the transaction raising it, down with it.
+  defp scrub(%_{} = struct), do: struct
+  defp scrub(map) when is_map(map), do: Map.new(map, fn {key, value} -> {scrub(key), scrub(value)} end)
+  defp scrub(list) when is_list(list), do: Enum.map(list, &scrub/1)
+
+  defp scrub(binary) when is_binary(binary) do
+    binary
+    |> String.replace_invalid()
+    |> String.replace(<<0>>, "")
+  end
+
+  defp scrub(other), do: other
+
+  @doc """
+  The webhook, if deliveries to it should still go out: it exists, it is on,
+  and its organization has not been deleted.
+  """
+  @spec deliverable_webhook(pos_integer()) :: Webhook.t() | nil
+  def deliverable_webhook(id) do
+    Webhook
+    |> join(:inner, [w], o in Org, on: o.id == w.org_id)
+    |> where([w, o], w.id == ^id and w.enabled and is_nil(o.deleted_at))
+    |> Repo.one()
+  end
+
+  @doc """
+  Whether deliveries to the webhook should skip the request for now, because
+  its endpoint failed moments ago.
+
+  An endpoint that times out holds a delivery worker for the whole timeout,
+  and every webhook on the instance shares those workers. Without this, one
+  product's unreachable endpoint, fed by a busy fleet, could fill the queue
+  and hold up everybody else's deliveries. With it, a failing endpoint costs
+  one real request every `#{@cooldown_seconds}` seconds, and the deliveries in
+  between fail without waiting.
+  """
+  @spec cooling_down?(Webhook.t(), DateTime.t()) :: boolean()
+  def cooling_down?(%Webhook{failing_since: nil}, _now), do: false
+  def cooling_down?(%Webhook{last_error_at: nil}, _now), do: false
+
+  def cooling_down?(%Webhook{last_error_at: last_error_at}, now) do
+    DateTime.diff(now, last_error_at) < @cooldown_seconds
+  end
+
+  @doc """
+  The endpoint accepted a delivery, so it is no longer failing.
+
+  Writes only when it was: a healthy webhook's successes cost nothing.
+  """
+  @spec record_success(Webhook.t()) :: :ok
+  def record_success(%Webhook{failing_since: nil}), do: :ok
+
+  def record_success(%Webhook{id: id}) do
+    _ =
+      Webhook
+      |> where([w], w.id == ^id and not is_nil(w.failing_since))
+      |> Repo.update_all(set: [failing_since: nil])
+
+    :ok
+  end
+
+  @doc """
+  The endpoint refused a delivery, or could not be reached.
+
+  Records when the endpoint started failing and the latest error, throttled to
+  one write every `#{@failure_write_interval_seconds}` seconds per webhook.
+
+  Turns the webhook off when the endpoint answered `410 Gone`, which the
+  Standard Webhooks specification reserves for a receiver saying it wants no
+  more deliveries, or when it has been failing for `#{@disable_after_hours}`
+  hours. Either way, each product it was sending events for gets a
+  notification saying so.
+
+  Returns `:disabled` when the webhook was turned off.
+  """
+  @spec record_failure(Webhook.t(), pos_integer() | nil, String.t()) :: :ok | :disabled
+  def record_failure(%Webhook{} = webhook, 410, _message) do
+    disable(webhook, "the endpoint answered 410 Gone, asking for no more deliveries")
+  end
+
+  def record_failure(%Webhook{id: id} = webhook, _status, message) do
+    now = DateTime.utc_now(:second)
+    throttle = DateTime.add(now, -@failure_write_interval_seconds)
+
+    Webhook
+    |> where([w], w.id == ^id)
+    |> where([w], is_nil(w.failing_since) or is_nil(w.last_error_at) or w.last_error_at < ^throttle)
+    |> select([w], w.failing_since)
+    |> update([w],
+      set: [
+        failing_since: fragment("COALESCE(?, ?)", w.failing_since, type(^now, :utc_datetime)),
+        last_error: ^String.slice(message, 0, 500),
+        last_error_at: ^now
+      ]
+    )
+    |> Repo.update_all([])
+    |> case do
+      {1, [failing_since]} ->
+        if DateTime.diff(now, failing_since, :hour) >= @disable_after_hours do
+          disable(webhook, "its endpoint has not accepted a delivery for #{@disable_after_hours} hours")
+        else
+          :ok
+        end
+
+      {0, _} ->
+        :ok
+    end
+  end
+
+  defp disable(%Webhook{id: id, org_id: org_id} = webhook, reason) do
+    {count, _} =
+      Webhook
+      |> where([w], w.id == ^id and w.enabled)
+      |> Repo.update_all(set: [enabled: false, disabled_reason: "Turned off because #{reason}."])
+
+    # Only the delivery that actually turned it off says so. Others failing at
+    # the same moment find it already off.
+    _ =
+      if count == 1 do
+        :ok = Cache.invalidate(org_id)
+        ProductNotifications.create_webhook_disabled_notifications!(webhook, heard_product_ids(webhook), reason)
+      end
+
+    :disabled
+  end
+
+  # The products whose events the webhook was sending, which are the ones
+  # whose members need to hear that it stopped.
+  defp heard_product_ids(%Webhook{all_products: true, org_id: org_id}) do
+    Product
+    |> where(org_id: ^org_id)
+    |> Repo.exclude_deleted()
+    |> select([p], p.id)
+    |> Repo.all()
+  end
+
+  defp heard_product_ids(%Webhook{id: id}) do
+    from(wp in "webhook_products",
+      join: p in Product,
+      on: p.id == wp.product_id,
+      where: wp.webhook_id == ^id and is_nil(p.deleted_at),
+      select: p.id
+    )
+    |> Repo.all()
+  end
+
+  defp invalidate_on_success({:ok, _webhook}, %Org{id: org_id}), do: Cache.invalidate(org_id)
+  defp invalidate_on_success(_error, _org), do: :ok
+end
diff --git a/lib/nerves_hub/webhooks/cache.ex b/lib/nerves_hub/webhooks/cache.ex
new file mode 100644
index 000000000..9e96205a2
--- /dev/null
+++ b/lib/nerves_hub/webhooks/cache.ex
@@ -0,0 +1,126 @@
+defmodule NervesHub.Webhooks.Cache do
+  @moduledoc """
+  Caches which webhooks hear a product's events and what each subscribes to,
+  keyed by product id.
+
+  Every device event asks this: each connect, disconnect, health report and
+  metrics batch, on whichever node holds the device's connection. Nearly every
+  product has no webhooks at all, so asking the database each time would add a
+  query to the hottest paths in the platform to learn nothing. Entries are read
+  straight out of ETS by the calling process, so a read costs no message and
+  serialises against nothing.
+
+  Webhooks belong to the organization, so each entry also records the
+  product's organization, and a change to any of an organization's webhooks
+  drops the entries of all its products, on the spot here and by message on
+  the other nodes. The TTL is the backstop for a node that was not there to
+  hear it.
+
+  Only ids and event types are cached. URLs and secrets are read by the
+  delivery worker when it sends, so a stale entry can at worst send one
+  delivery for an event the webhook has just stopped subscribing to, and the
+  worker drops deliveries for webhooks that have been disabled or deleted.
+
+  Modelled on `NervesHub.Products.HealthProfiles.Cache`.
+  """
+
+  use GenServer
+
+  @table __MODULE__
+  @topic "webhooks:changed"
+  @default_ttl_ms to_timeout(second: 30)
+
+  @doc """
+  The cached value for `product_id`, or the value from `fun.()`, stored under
+  it and returned.
+
+  `fun` returns `{org_id, value}`: the product's organization, so the entry
+  can be dropped when the organization's webhooks change, and the value.
+  `org_id` is `nil` for a product that no longer exists.
+
+  `nil` is cached like any other value: it is what a product no webhook hears
+  stores, and that is the case that would otherwise cost a query per event.
+  """
+  @spec fetch(pos_integer(), (-> {pos_integer() | nil, value})) :: value when value: term()
+  def fetch(product_id, fun) do
+    now = System.monotonic_time(:millisecond)
+
+    case :ets.lookup(@table, product_id) do
+      [{^product_id, _org_id, value, expires_at}] when expires_at > now ->
+        value
+
+      _miss_or_expired ->
+        {org_id, value} = fun.()
+        true = :ets.insert(@table, {product_id, org_id, value, now + ttl_ms()})
+        value
+    end
+  rescue
+    # The table exists only once the cache has started. Without it every read
+    # is a miss, which is a slower answer rather than a wrong one.
+    ArgumentError -> fun.() |> elem(1)
+  end
+
+  @doc """
+  Forget what is cached for every product of the organization, here and on
+  every other node.
+
+  The local drop is synchronous, so an event raised by the process that just
+  changed a webhook already sees the change.
+  """
+  @spec invalidate(pos_integer()) :: :ok
+  def invalidate(org_id) do
+    :ok = drop(org_id)
+    _ = Phoenix.PubSub.broadcast(NervesHub.PubSub, @topic, {:webhooks_changed, org_id})
+    :ok
+  end
+
+  @doc "Empty the cache. For tests, where the database is rolled back beneath it."
+  @spec reset() :: :ok
+  def reset() do
+    true = :ets.delete_all_objects(@table)
+    :ok
+  rescue
+    ArgumentError -> :ok
+  end
+
+  def start_link(opts), do: GenServer.start_link(__MODULE__, opts, name: __MODULE__)
+
+  @impl GenServer
+  def init(_opts) do
+    _ =
+      :ets.new(@table, [
+        :named_table,
+        :public,
+        :set,
+        read_concurrency: true,
+        write_concurrency: true
+      ])
+
+    :ok = Phoenix.PubSub.subscribe(NervesHub.PubSub, @topic)
+
+    {:ok, %{}}
+  end
+
+  @impl GenServer
+  def handle_info({:webhooks_changed, org_id}, state) do
+    :ok = drop(org_id)
+
+    {:noreply, state}
+  end
+
+  # This process owns a table and a subscription and nothing else; an
+  # unrecognised message is not a reason to drop either.
+  def handle_info(_message, state), do: {:noreply, state}
+
+  # A scan of the table, which holds one entry per product with devices on
+  # this node: cheap enough for something that happens when a person edits a
+  # webhook.
+  defp drop(org_id) do
+    true = :ets.match_delete(@table, {:_, org_id, :_, :_})
+    :ok
+  rescue
+    ArgumentError -> :ok
+  end
+
+  defp ttl_ms(), do: Application.get_env(:nerves_hub, :webhooks_cache_ttl_ms, @default_ttl_ms)
+end
diff --git a/lib/nerves_hub/webhooks/delivery.ex b/lib/nerves_hub/webhooks/delivery.ex
new file mode 100644
index 000000000..8b3aaa606
--- /dev/null
+++ b/lib/nerves_hub/webhooks/delivery.ex
@@ -0,0 +1,77 @@
+defmodule NervesHub.Webhooks.Delivery do
+  @moduledoc """
+  Sends one delivery attempt to a webhook's endpoint, and reports how it went.
+
+  A delivery is a signed `POST` of the event's JSON (see
+  `NervesHub.Webhooks.Signature`). Any 2xx response is success. Redirects are
+  not followed, because the address a redirect points at has not been checked
+  (`NervesHub.Webhooks.Destination`), so a 3xx counts as a failure and the
+  message says why.
+
+  Requests go through `NervesHub.Webhooks.Delivery.Adapter`, which opens one
+  connection per delivery to the address `Destination.resolve/2` checked.
+  """
+
+  alias NervesHub.Webhooks.Delivery.Adapter
+  alias NervesHub.Webhooks.Destination
+  alias NervesHub.Webhooks.Signature
+  alias NervesHub.Webhooks.Webhook
+
+  @typedoc """
+  How an attempt went: the response status for a 2xx, otherwise the status
+  (when there was a response) and a message for the person reading the
+  webhook's settings.
+  """
+  @type result() :: {:ok, pos_integer()} | {:error, pos_integer() | nil, String.t()}
+
+  @user_agent "NervesHub-Webhooks/1.0"
+
+  @doc """
+  Send `body`, the encoded event, to `webhook`, signed as event `event_id`.
+  """
+  @spec deliver(Webhook.t(), String.t(), binary()) :: result()
+  def deliver(%Webhook{} = webhook, event_id, body) do
+    timestamp = System.os_time(:second)
+
+    headers = [
+      {"content-type", "application/json"},
+      {"user-agent", @user_agent},
+      {"webhook-id", event_id},
+      {"webhook-timestamp", Integer.to_string(timestamp)},
+      {"webhook-signature", Signature.sign(webhook.secret, event_id, timestamp, body)}
+    ]
+
+    case Destination.resolve(webhook.url) do
+      {:ok, address} ->
+        [method: :post, url: webhook.url, headers: headers, body: body, adapter: Adapter, retry: false, redirect: false]
+        |> Keyword.merge(req_options())
+        |> Req.new()
+        |> Req.Request.put_private(:webhook_address, address)
+        |> Req.request()
+        |> result()
+
+      {:error, message} ->
+        {:error, nil, message}
+    end
+  end
+
+  defp result({:ok, %Req.Response{status: status}}) when status in 200..299, do: {:ok, status}
+
+  defp result({:ok, %Req.Response{status: status} = response}) when status in 300..399 do
+    location = response |> Req.Response.get_header("location") |> List.first()
+
+    {:error, status, "HTTP #{status}: redirected to #{location || "another address"}, which is not followed"}
+  end
+
+  defp result({:ok, %Req.Response{status: status}}), do: {:error, status, "HTTP #{status}"}
+
+  defp result({:error, exception}), do: {:error, nil, Exception.message(exception)}
+
+  # Tests stub the endpoint with `plug: {Req.Test, ...}`, which takes the place
+  # of the adapter.
+  defp req_options() do
+    :nerves_hub
+    |> Application.get_env(NervesHub.Webhooks, [])
+    |> Keyword.get(:req_options, [])
+  end
+end
diff --git a/lib/nerves_hub/webhooks/delivery/adapter.ex b/lib/nerves_hub/webhooks/delivery/adapter.ex
new file mode 100644
index 000000000..3faf5989e
--- /dev/null
+++ b/lib/nerves_hub/webhooks/delivery/adapter.ex
@@ -0,0 +1,111 @@
+defmodule NervesHub.Webhooks.Delivery.Adapter do
+  @moduledoc """
+  The Req adapter webhook deliveries are sent with: one Mint connection per
+  request, to the address `NervesHub.Webhooks.Destination` checked.
+
+  Req's own adapter cannot pin an address cheaply. Doing it means passing
+  `connect_options: [hostname: ...]`, and Req starts a separate Finch instance
+  for every distinct set of connect options. Each instance is named with a new
+  atom and is never stopped, so every host name somebody typed into a webhook
+  would cost the node an atom and a supervision tree for the rest of its life.
+  A webhook sends to one endpoint at a modest rate, so a fresh connection per
+  delivery costs little and leaves nothing behind.
+
+  The address arrives as the request's `:webhook_address` private field. `nil`
+  means private destinations are allowed and the host is connected to by name,
+  as any HTTP client would.
+
+  Only the status matters, so the response is read up to its headers and the
+  connection closed. A receiver cannot make a delivery buffer a body, or hold a
+  worker by streaming one.
+  """
+
+  @connect_timeout to_timeout(second: 5)
+  @receive_timeout to_timeout(second: 15)
+
+  @doc false
+  @spec run(Req.Request.t()) :: {Req.Request.t(), Req.Response.t() | Exception.t()}
+  def run(%Req.Request{url: uri} = request) do
+    deadline = System.monotonic_time(:millisecond) + @receive_timeout
+    method = request.method |> Atom.to_string() |> String.upcase()
+
+    with {:ok, conn} <- connect(uri, Req.Request.get_private(request, :webhook_address)),
+         {:ok, conn, ref} <- Mint.HTTP.request(conn, method, path(uri), headers(request), request.body),
+         {:ok, conn, response} <- receive_response(conn, ref, %{status: nil, headers: []}, deadline) do
+      _ = Mint.HTTP.close(conn)
+
+      {request, Req.Response.new(status: response.status, headers: response.headers)}
+    else
+      {:error, %Mint.TransportError{} = error} ->
+        {request, error}
+
+      {:error, %Mint.HTTPError{} = error} ->
+        {request, error}
+
+      {:error, conn, error} ->
+        _ = Mint.HTTP.close(conn)
+        {request, error}
+    end
+  end
+
+  defp connect(uri, address) do
+    scheme = if uri.scheme == "https", do: :https, else: :http
+    opts = [mode: :passive, protocols: [:http1]]
+
+    case address do
+      nil ->
+        Mint.HTTP.connect(scheme, uri.host, uri.port, [transport_opts: [timeout: @connect_timeout]] ++ opts)
+
+      address ->
+        # `hostname` keeps the name for SNI, certificate verification and the
+        # Host header, while the socket goes to the address that was checked.
+        transport_opts = [timeout: @connect_timeout, inet6: tuple_size(address) == 8]
+        Mint.HTTP.connect(scheme, address, uri.port, [hostname: uri.host, transport_opts: transport_opts] ++ opts)
+    end
+  end
+
+  defp path(%URI{path: path, query: query}) do
+    path = if path in [nil, ""], do: "/", else: path
+
+    if query, do: path <> "?" <> query, else: path
+  end
+
+  defp headers(%Req.Request{headers: headers}) do
+    for {name, values} <- headers, value <- values, do: {name, value}
+  end
+
+  defp receive_response(conn, ref, response, deadline) do
+    timeout = deadline - System.monotonic_time(:millisecond)
+
+    with true <- timeout > 0,
+         {:ok, conn, messages} <- Mint.HTTP.recv(conn, 0, timeout) do
+      case Enum.reduce(messages, response, &collect(&1, ref, &2)) do
+        %{error: error} -> {:error, conn, error}
+        %{status: status, done: true} = response when not is_nil(status) -> {:ok, conn, response}
+        response -> receive_response(conn, ref, response, deadline)
+      end
+    else
+      false -> {:error, conn, %Mint.TransportError{reason: :timeout}}
+      {:error, conn, error, _messages} -> {:error, conn, error}
+    end
+  end
+
+  # A 1xx is an interim response, such as 103 Early Hints or a 100 Continue
+  # nobody asked for, and the real one follows on the same request. Mint
+  # reports each as a status and its headers, so both are passed over. 101
+  # is the exception: Mint ends the request on it.
+  defp collect({:status, ref, status}, ref, response) when status in 100..199 and status != 101,
+    do: Map.put(response, :interim, true)
+
+  # The response is complete enough at its headers: the status is all a
+  # delivery is judged on, and `Location` is in them for a redirect.
+  defp collect({:status, ref, status}, ref, response), do: Map.merge(response, %{status: status, interim: false})
+
+  defp collect({:headers, ref, _headers}, ref, %{interim: true} = response), do: %{response | interim: false}
+
+  defp collect({:headers, ref, headers}, ref, response),
+    do: Map.merge(response, %{headers: response.headers ++ headers, done: true})
+
+  defp collect({:error, ref, error}, ref, response), do: Map.put(response, :error, error)
+  defp collect(_data_or_done, _ref, response), do: response
+end
diff --git a/lib/nerves_hub/webhooks/destination.ex b/lib/nerves_hub/webhooks/destination.ex
new file mode 100644
index 000000000..ea0136e0b
--- /dev/null
+++ b/lib/nerves_hub/webhooks/destination.ex
@@ -0,0 +1,209 @@
+defmodule NervesHub.Webhooks.Destination do
+  @moduledoc """
+  Where a webhook is allowed to send to.
+
+  A webhook makes NervesHub send a request to an address somebody typed in,
+  from inside NervesHub's own network. Left unchecked, that address could be
+  the cloud provider's metadata service, a database, or anything else that
+  trusts requests from its own subnet (server-side request forgery). So unless
+  the instance allows private destinations, a webhook may only reach public
+  addresses.
+
+  The check happens twice. When a webhook is saved, a URL whose host is a
+  literal private address is refused, so the mistake is reported where it is
+  made. When a delivery is sent, the host is resolved and every address it
+  resolves to is checked, and the request then goes to the address that was
+  checked rather than resolving the name again. Resolving twice would let a DNS
+  server answer the check with a public address and the connection with a
+  private one.
+
+  Self-hosted instances often deliver to receivers on their own network, which
+  is what `WEBHOOKS_ALLOW_PRIVATE_DESTINATIONS` is for. With it set, nothing is
+  resolved here and the HTTP client connects as it normally would.
+  """
+
+  import Bitwise
+
+  # Networks a webhook may not reach unless private destinations are allowed:
+  # loopback, private, link-local (which includes cloud metadata services),
+  # carrier-grade NAT, and the reserved, documentation and multicast ranges no
+  # webhook receiver legitimately lives in.
+  @blocked_ipv4 [
+    {{0, 0, 0, 0}, 8},
+    {{10, 0, 0, 0}, 8},
+    {{100, 64, 0, 0}, 10},
+    {{127, 0, 0, 0}, 8},
+    {{169, 254, 0, 0}, 16},
+    {{172, 16, 0, 0}, 12},
+    {{192, 0, 0, 0}, 24},
+    {{192, 0, 2, 0}, 24},
+    {{192, 168, 0, 0}, 16},
+    {{198, 18, 0, 0}, 15},
+    {{198, 51, 100, 0}, 24},
+    {{203, 0, 113, 0}, 24},
+    {{224, 0, 0, 0}, 4},
+    {{240, 0, 0, 0}, 4}
+  ]
+
+  # `::/96` covers the unspecified and loopback addresses as well as the
+  # deprecated IPv4-compatible form. IPv6 forms that carry an IPv4 address
+  # (mapped, NAT64, 6to4) are checked by the address they carry instead; see
+  # `embedded_ipv4/1`.
+  @blocked_ipv6 [
+    {{0, 0, 0, 0, 0, 0, 0, 0}, 96},
+    {{0x100, 0, 0, 0, 0, 0, 0, 0}, 64},
+    {{0x2001, 0, 0, 0, 0, 0, 0, 0}, 32},
+    {{0x2001, 0xDB8, 0, 0, 0, 0, 0, 0}, 32},
+    {{0xFC00, 0, 0, 0, 0, 0, 0, 0}, 7},
+    {{0xFE80, 0, 0, 0, 0, 0, 0, 0}, 10},
+    {{0xFF00, 0, 0, 0, 0, 0, 0, 0}, 8}
+  ]
+
+  @resolve_timeout to_timeout(second: 5)
+
+  @doc """
+  Whether `url` is somewhere a webhook may be pointed, checking what can be
+  checked without the network.
+
+  Returns a message for the settings form when it is not.
+  """
+  @spec validate_url(String.t(), keyword()) :: :ok | {:error, String.t()}
+  def validate_url(url, opts \\ []) do
+    case URI.new(url) do
+      {:ok, %URI{scheme: scheme}} when scheme not in ["http", "https"] ->
+        {:error, "must start with https:// or http://"}
+
+      {:ok, %URI{host: host}} when host in [nil, ""] ->
+        {:error, "must include a host"}
+
+      {:ok, %URI{userinfo: userinfo}} when not is_nil(userinfo) ->
+        {:error, "must not include a username or password"}
+
+      {:ok, %URI{host: host}} ->
+        validate_host(host, opts)
+
+      {:error, _part} ->
+        {:error, "is not a valid URL"}
+    end
+  end
+
+  defp validate_host(host, opts) do
+    case :inet.parse_address(String.to_charlist(host)) do
+      {:ok, address} ->
+        if allowed?(address, opts), do: :ok, else: {:error, "must not be a private or reserved address"}
+
+      {:error, :einval} ->
+        :ok
+    end
+  end
+
+  @doc """
+  The address a delivery to `url` should connect to.
+
+  `{:ok, nil}` means connect however the HTTP client normally would, which is
+  what happens when private destinations are allowed. Otherwise the host is
+  resolved and `{:ok, address}` is a public address it resolved to; the
+  delivery must connect to that address while keeping the host name for TLS
+  and the `Host` header.
+
+  ## Options
+
+    * `:allow_private` — overrides the instance setting, for tests.
+  """
+  @spec resolve(String.t(), keyword()) :: {:ok, :inet.ip_address() | nil} | {:error, String.t()}
+  def resolve(url, opts \\ []) do
+    if allow_private?(opts) do
+      {:ok, nil}
+    else
+      url |> URI.parse() |> Map.fetch!(:host) |> resolve_host(opts)
+    end
+  end
+
+  defp resolve_host(host, opts) do
+    case addresses(host) do
+      [] ->
+        {:error, "could not resolve #{host}"}
+
+      addresses ->
+        # Every address, not just the one connected to: a host that resolves
+        # to a mix of public and private addresses is somebody probing.
+        if Enum.all?(addresses, &allowed?(&1, opts)) do
+          {:ok, preferred(addresses)}
+        else
+          {:error, "#{host} resolves to a private or reserved address"}
+        end
+    end
+  end
+
+  defp addresses(host) do
+    charlist = String.to_charlist(host)
+
+    case :inet.parse_address(charlist) do
+      {:ok, address} ->
+        [address]
+
+      {:error, :einval} ->
+        for family <- [:inet, :inet6],
+            {:ok, found} <- [:inet.getaddrs(charlist, family, @resolve_timeout)],
+            address <- found,
+            uniq: true,
+            do: address
+    end
+  end
+
+  # IPv4 first: an instance without IPv6 egress is the more common way for a
+  # dual-stack receiver to be unreachable.
+  defp preferred(addresses) do
+    Enum.find(addresses, &(tuple_size(&1) == 4)) || hd(addresses)
+  end
+
+  @doc """
+  Whether a delivery may connect to `address`.
+  """
+  @spec allowed?(:inet.ip_address(), keyword()) :: boolean()
+  def allowed?(address, opts \\ []) do
+    allow_private?(opts) or not blocked?(address)
+  end
+
+  defp blocked?({_, _, _, _} = address) do
+    Enum.any?(@blocked_ipv4, fn {network, prefix} -> in_network?(address, network, prefix, 8) end)
+  end
+
+  defp blocked?({_, _, _, _, _, _, _, _} = address) do
+    case embedded_ipv4(address) do
+      nil -> Enum.any?(@blocked_ipv6, fn {network, prefix} -> in_network?(address, network, prefix, 16) end)
+      ipv4 -> blocked?(ipv4)
+    end
+  end
+
+  # IPv6 addresses that stand for an IPv4 one, and would reach it: IPv4-mapped
+  # (::ffff:a.b.c.d), NAT64 (64:ff9b::a.b.c.d) and 6to4 (2002::/16, with the
+  # IPv4 address in the 32 bits after the prefix).
+  defp embedded_ipv4({0, 0, 0, 0, 0, 0xFFFF, high, low}), do: ipv4(high, low)
+  defp embedded_ipv4({0x64, 0xFF9B, 0, 0, 0, 0, high, low}), do: ipv4(high, low)
+  defp embedded_ipv4({0x2002, high, low, _, _, _, _, _}), do: ipv4(high, low)
+  defp embedded_ipv4(_address), do: nil
+
+  defp ipv4(high, low), do: {high >>> 8, high &&& 0xFF, low >>> 8, low &&& 0xFF}
+
+  defp in_network?(address, network, prefix, bits_per_part) do
+    size = tuple_size(address) * bits_per_part
+    shift = size - prefix
+
+    to_integer(address, bits_per_part) >>> shift == to_integer(network, bits_per_part) >>> shift
+  end
+
+  defp to_integer(address, bits_per_part) do
+    address
+    |> Tuple.to_list()
+    |> Enum.reduce(0, fn part, acc -> (acc <<< bits_per_part) + part end)
+  end
+
+  defp allow_private?(opts) do
+    Keyword.get_lazy(opts, :allow_private, fn ->
+      :nerves_hub
+      |> Application.get_env(NervesHub.Webhooks, [])
+      |> Keyword.get(:allow_private_destinations, false)
+    end)
+  end
+end
diff --git a/lib/nerves_hub/webhooks/events.ex b/lib/nerves_hub/webhooks/events.ex
new file mode 100644
index 000000000..a69505db6
--- /dev/null
+++ b/lib/nerves_hub/webhooks/events.ex
@@ -0,0 +1,123 @@
+defmodule NervesHub.Webhooks.Events do
+  @moduledoc """
+  The events a product webhook can subscribe to.
+
+  Each type is the `type` field of the delivered payload, and the name a
+  receiver switches on. Types follow the Standard Webhooks convention:
+  dot-separated, with each part made of letters, digits and underscores.
+
+  **The type names and the shape of each event's `data` are a published
+  contract.** Receivers are written against them in code this repository
+  cannot see. Adding a type, or a key to an event's `data`, is safe; renaming
+  or removing either breaks somebody's integration. `docs/webhooks.md`
+  documents each payload and must be kept in step with the builders in
+  `NervesHub.Webhooks`.
+  """
+
+  @typedoc "One subscribable event, as the settings page describes it."
+  @type event() :: %{type: String.t(), group: String.t(), label: String.t(), description: String.t()}
+
+  @events [
+    %{
+      type: "device.connected",
+      group: "Connection",
+      label: "Device connected",
+      description: "A device finished connecting and is online."
+    },
+    %{
+      type: "device.disconnected",
+      group: "Connection",
+      label: "Device disconnected",
+      description:
+        "A device's connection closed, or was closed by NervesHub after the device stopped sending heartbeats."
+    },
+    %{
+      type: "device.health_reported",
+      group: "Health",
+      label: "Health report received",
+      description:
+        "A device sent a health report: its metrics, alarms and metadata. Devices report every hour, and every minute while somebody has the device's page open."
+    },
+    %{
+      type: "device.metrics_reported",
+      group: "Health",
+      label: "Metrics received",
+      description:
+        "A device sent a batch of metrics readings. Only devices using the metrics extension send these; others include their metrics in health reports."
+    },
+    %{
+      type: "device.health_status_changed",
+      group: "Health",
+      label: "Health status changed",
+      description:
+        "A device's health status moved, such as from healthy to warning, judged against the product's health profile."
+    },
+    %{
+      type: "device.firmware_update.scheduled",
+      group: "Firmware",
+      label: "Update sent",
+      description:
+        "A firmware update was sent to a device, by a deployment group, by a user, or because the device asked."
+    },
+    %{
+      type: "device.firmware_update.progress",
+      group: "Firmware",
+      label: "Update progress",
+      description:
+        "A device reported how its update is going: received, started, downloading, updating or completed. Progress percentages are sent at most every 15 seconds."
+    },
+    %{
+      type: "device.firmware_update.finished",
+      group: "Firmware",
+      label: "Update finished",
+      description:
+        "A device's update attempt ended. The outcome is one of succeeded, failed, ignored, rescheduled, expired or abandoned."
+    },
+    %{
+      type: "device.firmware_validated",
+      group: "Firmware",
+      label: "Firmware validated",
+      description: "A device confirmed that the firmware it is running is good."
+    }
+  ]
+
+  @types Enum.map(@events, & &1.type)
+
+  @test_type "webhook.test"
+
+  @doc "Every subscribable event, in the order the settings page lists them."
+  @spec all() :: [event(), ...]
+  def all(), do: @events
+
+  @doc "Every subscribable event type."
+  @spec types() :: [String.t(), ...]
+  def types(), do: @types
+
+  @doc """
+  The events grouped for display, as `{group, events}` in their listed order.
+  """
+  @spec grouped() :: [{String.t(), [event()]}]
+  def grouped() do
+    @events
+    |> Enum.chunk_by(& &1.group)
+    |> Enum.map(fn [%{group: group} | _] = events -> {group, events} end)
+  end
+
+  @doc "The human name of an event type, falling back to the type itself."
+  @spec label(String.t()) :: String.t()
+  def label(type) do
+    case Enum.find(@events, &(&1.type == type)) do
+      %{label: label} -> label
+      nil -> type
+    end
+  end
+
+  @doc """
+  The type of the event sent by "Send test event".
+
+  Not subscribable: it is only ever sent on request, to the one webhook being
+  tested, whatever that webhook subscribes to.
+  """
+  @spec test_type() :: String.t()
+  def test_type(), do: @test_type
+end
diff --git a/lib/nerves_hub/webhooks/payloads.ex b/lib/nerves_hub/webhooks/payloads.ex
new file mode 100644
index 000000000..a9ebf1d60
--- /dev/null
+++ b/lib/nerves_hub/webhooks/payloads.ex
@@ -0,0 +1,222 @@
+defmodule NervesHub.Webhooks.Payloads do
+  @moduledoc """
+  The `data` of each webhook event, built from whatever the code raising the
+  event has in hand.
+
+  These shapes are what receivers are written against, so they live together
+  here, and `docs/webhooks.md` shows each one. Adding a key is safe; renaming
+  or removing one breaks an integration this repository cannot see.
+
+  Every event about a device carries `device`: its identifier and the firmware
+  it is running as far as NervesHub knows. `NervesHub.Webhooks.dispatch/3`
+  adds `org` and `product`.
+
+  Each function runs only when a webhook subscribes to its event (it is the
+  function passed to `dispatch/3`), so the queries some of them make cost
+  nothing for products without webhooks.
+  """
+
+  import Ecto.Query
+
+  alias NervesHub.DeviceLink.DeviceInfo
+  alias NervesHub.Devices.Device
+  alias NervesHub.Devices.DeviceConnection
+  alias NervesHub.Devices.DeviceHealth
+  alias NervesHub.Firmwares.Firmware
+  alias NervesHub.ManagedDeployments.DeploymentGroup
+  alias NervesHub.Repo
+
+  @doc "`device.connected`"
+  @spec device_connected(DeviceConnection.t()) :: map()
+  def device_connected(%DeviceConnection{} = connection) do
+    %{
+      device: device(connection.device_id),
+      connection: %{id: connection.id, established_at: connection.established_at}
+    }
+  end
+
+  @doc """
+  `device.disconnected`
+
+  `devices` is the device summaries for a batch of connections, by device id,
+  for the stale connection sweep, which closes many at once.
+  """
+  @spec device_disconnected(DeviceConnection.t(), %{optional(pos_integer()) => map()}) :: map()
+  def device_disconnected(%DeviceConnection{} = connection, devices \\ %{}) do
+    %{
+      device: Map.get_lazy(devices, connection.device_id, fn -> device(connection.device_id) end),
+      connection: %{
+        id: connection.id,
+        established_at: connection.established_at,
+        disconnected_at: connection.disconnected_at,
+        reason: connection.disconnected_reason
+      }
+    }
+  end
+
+  @doc """
+  `device.health_reported`
+
+  `metrics` is the readings as stored (`NervesHub.Devices.Metrics.storable/1`);
+  alarms and metadata are passed on as the device sent them.
+  """
+  @spec health_reported(DeviceInfo.t(), map(), map()) :: map()
+  def health_reported(%DeviceInfo{} = device_info, metrics, report) do
+    %{
+      device: device(device_info),
+      metrics: metrics,
+      alarms: map_or_empty(report["alarms"]),
+      metadata: map_or_empty(report["metadata"])
+    }
+  end
+
+  @doc """
+  `device.metrics_reported`
+
+  `reports` is the batch's readings with their timestamps, one entry per
+  report the device sent and NervesHub stored.
+  """
+  @spec metrics_reported(DeviceInfo.t(), [%{timestamp: DateTime.t(), metrics: map()}]) :: map()
+  def metrics_reported(%DeviceInfo{} = device_info, reports) do
+    %{device: device(device_info), reports: reports}
+  end
+
+  @doc """
+  `device.health_status_changed`
+
+  `previous_status` is `nil` for a device's first verdict. `reasons` names
+  each metric holding the device at warning or unhealthy, as stored.
+  """
+  @spec health_status_changed(DeviceInfo.t(), atom() | nil, DeviceHealth.t()) :: map()
+  def health_status_changed(%DeviceInfo{} = device_info, previous_status, %DeviceHealth{} = health) do
+    %{
+      device: device(device_info),
+      status: Atom.to_string(health.status),
+      previous_status: previous_status && Atom.to_string(previous_status),
+      reasons: health.status_reasons
+    }
+  end
+
+  @doc """
+  `device.firmware_update.scheduled`
+
+  `initiated_by` is `"deployment_group"`, `"user"` or `"device"`.
+  """
+  @spec firmware_update_scheduled(Device.t(), Firmware.t(), String.t(), DeploymentGroup.t() | nil) :: map()
+  def firmware_update_scheduled(%Device{} = device, %Firmware{} = firmware, initiated_by, deployment_group) do
+    %{
+      device: device(device),
+      firmware: %{uuid: firmware.uuid, version: firmware.version},
+      initiated_by: initiated_by,
+      deployment_group: deployment_group && %{name: deployment_group.name}
+    }
+  end
+
+  @doc """
+  `device.firmware_update.progress`
+
+  `progress` is a percentage, for the stages that report one.
+  """
+  @spec firmware_update_progress(map(), String.t(), integer() | nil, String.t() | nil) :: map()
+  def firmware_update_progress(device, status, progress, target_firmware_uuid) do
+    %{
+      device: device(device),
+      status: status,
+      progress: progress,
+      firmware: firmware(device.product_id, target_firmware_uuid)
+    }
+  end
+
+  @doc """
+  `device.firmware_update.finished`
+
+  `opts` are those of `NervesHub.Devices.UpdateHistory.record/3`.
+  """
+  @spec firmware_update_finished(map(), atom(), keyword()) :: map()
+  def firmware_update_finished(device, outcome, opts) do
+    %{
+      device: device(device),
+      outcome: Atom.to_string(outcome),
+      reason: opts[:reason],
+      source_firmware: firmware(device.product_id, opts[:source_firmware_uuid]),
+      target_firmware: firmware(device.product_id, opts[:target_firmware_uuid]),
+      deployment_group: deployment_group(opts[:deployment_id])
+    }
+  end
+
+  @doc "`device.firmware_validated`"
+  @spec firmware_validated(DeviceInfo.t()) :: map()
+  def firmware_validated(%DeviceInfo{} = device_info) do
+    %{device: device(device_info)}
+  end
+
+  @doc """
+  Device summaries for a batch of device ids, by id, in one query.
+  """
+  @spec devices([pos_integer()]) :: %{optional(pos_integer()) => map()}
+  def devices(device_ids) do
+    Device
+    |> where([d], d.id in ^device_ids)
+    |> select([d], {d.id, d.identifier, d.firmware_metadata})
+    |> Repo.all()
+    |> Map.new(fn {id, identifier, firmware_metadata} -> {id, summary(identifier, firmware_metadata)} end)
+  end
+
+  # Whatever the caller has: a connection's `DeviceInfo`, a device or the
+  # partial device `NervesHub.FirmwareUpdates` carries, or only an id (or a
+  # map with only an id), which costs a query.
+  defp device(%DeviceInfo{} = device_info) do
+    summary(device_info.device_identifier, device_info.firmware_metadata)
+  end
+
+  defp device(%{identifier: identifier, firmware_metadata: firmware_metadata}) do
+    summary(identifier, firmware_metadata)
+  end
+
+  defp device(%{id: id}), do: device(id)
+
+  defp device(id) when is_integer(id) do
+    Map.get(devices([id]), id, %{identifier: nil, firmware: nil})
+  end
+
+  defp summary(identifier, firmware_metadata) do
+    %{identifier: identifier, firmware: firmware_metadata(firmware_metadata)}
+  end
+
+  defp firmware_metadata(nil), do: nil
+
+  defp firmware_metadata(metadata) do
+    %{
+      uuid: Map.get(metadata, :uuid),
+      version: Map.get(metadata, :version),
+      platform: Map.get(metadata, :platform),
+      architecture: Map.get(metadata, :architecture)
+    }
+  end
+
+  # The version is what a person reads; the uuid is what identifies it. Firmware
+  # deleted since is still named by its uuid.
+  defp firmware(_product_id, nil), do: nil
+
+  defp firmware(product_id, uuid) do
+    version =
+      Firmware
+      |> where([f], f.product_id == ^product_id and f.uuid == ^uuid)
+      |> select([f], f.version)
+      |> Repo.one()
+
+    %{uuid: uuid, version: version}
+  end
+
+  defp deployment_group(nil), do: nil
+
+  defp deployment_group(id) do
+    DeploymentGroup
+    |> where([dg], dg.id == ^id)
+    |> select([dg], %{name: dg.name})
+    |> Repo.one()
+  end
+
+  defp map_or_empty(map) when is_map(map), do: map
+  defp map_or_empty(_other), do: %{}
+end
diff --git a/lib/nerves_hub/webhooks/signature.ex b/lib/nerves_hub/webhooks/signature.ex
new file mode 100644
index 000000000..32a3ef4de
--- /dev/null
+++ b/lib/nerves_hub/webhooks/signature.ex
@@ -0,0 +1,61 @@
+defmodule NervesHub.Webhooks.Signature do
+  @moduledoc """
+  Signs webhook deliveries the way the Standard Webhooks specification
+  describes (https://www.standardwebhooks.com).
+
+  Following an existing specification rather than inventing a scheme means a
+  receiver can verify deliveries with an off-the-shelf library in most
+  languages, instead of reimplementing ours from documentation.
+
+  A delivery carries three headers:
+
+    * `webhook-id` — the event's id, the same on every retry, so a receiver can
+      use it to ignore a delivery it has already processed.
+    * `webhook-timestamp` — when this attempt was sent, in Unix seconds, so a
+      receiver can refuse a replayed request.
+    * `webhook-signature` — `v1,` and the base64 HMAC-SHA256 of
+      `"<webhook-id>.<webhook-timestamp>.<body>"`, keyed with the secret.
+
+  The secret is `whsec_` followed by 32 random bytes in base64. The HMAC key is
+  the decoded bytes, not the string, which is what the specification's
+  libraries expect.
+  """
+
+  @prefix "whsec_"
+  @secret_bytes 32
+
+  @doc "A new signing secret."
+  @spec generate_secret() :: String.t()
+  def generate_secret() do
+    @prefix <> Base.encode64(:crypto.strong_rand_bytes(@secret_bytes))
+  end
+
+  @doc """
+  The `webhook-signature` header value for one delivery attempt.
+  """
+  @spec sign(secret :: String.t(), id :: String.t(), timestamp :: integer(), body :: binary()) :: String.t()
+  def sign(secret, id, timestamp, body) do
+    mac = :crypto.mac(:hmac, :sha256, key(secret), "#{id}.#{timestamp}.#{body}")
+
+    "v1," <> Base.encode64(mac)
+  end
+
+  @doc """
+  Whether `signature_header` holds a valid signature for the delivery.
+
+  The header may list several space-separated signatures, as the
+  specification allows during a secret rotation; any one matching is enough.
+  This is what a receiver does, and lives here so the tests check signing
+  against verification rather than against a copy of `sign/4`.
+  """
+  @spec verify(String.t(), String.t(), integer() | String.t(), binary(), String.t()) :: boolean()
+  def verify(secret, id, timestamp, body, signature_header) do
+    expected = sign(secret, id, timestamp, body)
+
+    signature_header
+    |> String.split(" ", trim: true)
+    |> Enum.any?(&Plug.Crypto.secure_compare(&1, expected))
+  end
+
+  defp key(@prefix <> encoded), do: Base.decode64!(encoded)
+end
diff --git a/lib/nerves_hub/webhooks/webhook.ex b/lib/nerves_hub/webhooks/webhook.ex
new file mode 100644
index 000000000..20acdf038
--- /dev/null
+++ b/lib/nerves_hub/webhooks/webhook.ex
@@ -0,0 +1,171 @@
+defmodule NervesHub.Webhooks.Webhook do
+  @moduledoc """
+  An HTTP endpoint an organization sends a chosen set of device events to.
+
+  A webhook hears from every product in the organization (`all_products`), or
+  only from the products it lists in `products`. Products added later are
+  covered by the first and not the second.
+
+  `secret` signs every delivery (see `NervesHub.Webhooks.Signature`). It is
+  generated here rather than chosen by the user, so it always has the length
+  and format the Standard Webhooks libraries a receiver verifies with expect.
+
+  `failing_since`, `last_error` and `last_error_at` describe the endpoint as
+  deliveries have found it, and are written by the delivery worker rather than
+  by anyone editing the webhook. `disabled_reason` is set when deliveries
+  turned the webhook off, and cleared when a person turns it back on.
+  """
+  use Ecto.Schema
+
+  import Ecto.Changeset
+
+  alias NervesHub.Accounts.Org
+  alias NervesHub.Products.Product
+  alias NervesHub.Webhooks.Destination
+  alias NervesHub.Webhooks.Events
+  alias NervesHub.Webhooks.Signature
+
+  @type t :: %__MODULE__{}
+
+  @max_url_length 2048
+
+  schema "webhooks" do
+    belongs_to(:org, Org)
+
+    many_to_many(:products, Product,
+      join_through: "webhook_products",
+      on_replace: :delete,
+      where: [deleted_at: nil],
+      preload_order: [asc: :name]
+    )
+
+    field(:url, :string)
+    field(:description, :string)
+    field(:secret, :string, redact: true)
+    field(:events, {:array, :string}, default: [])
+    field(:all_products, :boolean, default: true)
+    field(:enabled, :boolean, default: true)
+    field(:disabled_reason, :string)
+    field(:failing_since, :utc_datetime)
+    field(:last_error, :string)
+    field(:last_error_at, :utc_datetime)
+
+    timestamps()
+  end
+
+  @typedoc """
+  The products a change names, as `NervesHub.Webhooks` found them in the
+  organization: those it found, and the names it did not. `nil` when the
+  change names no products, which leaves them as they are.
+  """
+  @type products() :: {[Product.t()], [String.t()]} | :invalid | nil
+
+  @doc """
+  A new webhook for `org`, with a freshly generated signing secret.
+  """
+  @spec create_changeset(Org.t(), map(), products()) :: Ecto.Changeset.t()
+  def create_changeset(%Org{} = org, params, products) do
+    %__MODULE__{org_id: org.id, products: [], secret: Signature.generate_secret()}
+    |> changeset(params, products)
+  end
+
+  @doc """
+  The fields a person edits: where deliveries go, what they are for, which
+  events they carry, and which products they come from.
+
+  `products` is what `params` named, already looked up in the organization
+  (see `t:products/0`), since a changeset cannot query. The webhook's
+  `products` must be loaded.
+
+  Turning a webhook on clears what deliveries recorded about it, so it starts
+  from a clean slate rather than looking broken because of failures that were
+  the reason somebody fixed and re-enabled it.
+  """
+  @spec changeset(t(), map(), products()) :: Ecto.Changeset.t()
+  def changeset(%__MODULE__{} = webhook, params, products \\ nil) do
+    webhook
+    |> cast(params, [:url, :description, :events, :all_products, :enabled])
+    |> update_change(:url, &String.trim/1)
+    |> update_change(:description, &String.trim/1)
+    |> validate_required([:url, :all_products])
+    |> validate_length(:url, max: @max_url_length)
+    |> validate_length(:description, max: 255)
+    |> validate_url()
+    |> validate_events()
+    |> put_product_scope(products)
+    |> clear_delivery_state_on_enable()
+    |> foreign_key_constraint(:org_id)
+  end
+
+  @doc """
+  Replaces the signing secret. The old one stops working at once.
+  """
+  @spec regenerate_secret_changeset(t()) :: Ecto.Changeset.t()
+  def regenerate_secret_changeset(%__MODULE__{} = webhook) do
+    change(webhook, secret: Signature.generate_secret())
+  end
+
+  defp validate_url(changeset) do
+    validate_change(changeset, :url, fn :url, url ->
+      case Destination.validate_url(url) do
+        :ok -> []
+        {:error, message} -> [url: message]
+      end
+    end)
+  end
+
+  defp validate_events(changeset) do
+    changeset
+    |> update_change(:events, &Enum.uniq/1)
+    |> validate_subset(:events, Events.types(), message: "contains an event that does not exist")
+    |> validate_some_events()
+  end
+
+  # The field rather than the change: a new webhook's events default to `[]`,
+  # so submitting none is no change at all, and `validate_length/3` would let
+  # it through.
+  defp validate_some_events(changeset) do
+    if get_field(changeset, :events) == [] do
+      add_error(changeset, :events, "choose at least one event")
+    else
+      changeset
+    end
+  end
+
+  # A webhook for every product keeps no list, so that limiting it later
+  # starts from an empty choice rather than a forgotten one, and names the
+  # change carries are not looked at.
+  defp put_product_scope(changeset, products) do
+    if get_field(changeset, :all_products) do
+      put_assoc(changeset, :products, [])
+    else
+      changeset
+      |> put_products(products)
+      |> require_products()
+    end
+  end
+
+  defp put_products(changeset, nil), do: changeset
+  defp put_products(changeset, :invalid), do: add_error(changeset, :products, "must be a list of product names")
+  defp put_products(changeset, {products, []}), do: put_assoc(changeset, :products, products)
+
+  defp put_products(changeset, {_products, unknown}) do
+    add_error(changeset, :products, "has no product named #{Enum.join(unknown, ", ")}")
+  end
+
+  defp require_products(changeset) do
+    if is_nil(changeset.errors[:products]) and get_field(changeset, :products) == [] do
+      add_error(changeset, :products, "choose at least one product")
+    else
+      changeset
+    end
+  end
+
+  defp clear_delivery_state_on_enable(changeset) do
+    if get_change(changeset, :enabled) == true do
+      change(changeset, disabled_reason: nil, failing_since: nil, last_error: nil, last_error_at: nil)
+    else
+      changeset
+    end
+  end
+end
diff --git a/lib/nerves_hub/workers/deliver_webhook.ex b/lib/nerves_hub/workers/deliver_webhook.ex
new file mode 100644
index 000000000..de20b9dee
--- /dev/null
+++ b/lib/nerves_hub/workers/deliver_webhook.ex
@@ -0,0 +1,73 @@
+defmodule NervesHub.Workers.DeliverWebhook do
+  @moduledoc """
+  Delivers one event to one webhook. Queued by `NervesHub.Webhooks.dispatch/3`.
+
+  The webhook is read when the job runs, not when it was queued, so a delivery
+  goes to the current URL, is signed with the current secret, and is dropped
+  if the webhook has since been deleted or turned off.
+
+  ## Retries
+
+  A failed attempt is retried after 5 seconds, 1 minute, 5 minutes, 30 minutes
+  and 2 hours, each with up to a tenth more as jitter: six attempts over about
+  two and a half hours, after which the delivery is given up and the job
+  cancelled with the last error.
+
+  The retries are snoozes rather than errors. A receiver refusing a delivery
+  is not a fault in NervesHub, and Sentry's Oban integration reports every job
+  that returns an error, so one broken receiver would bury real faults. Faults
+  in this code still raise, are still reported, and still use Oban's own
+  attempts. Delivery attempts are counted from the snooze count Oban keeps in
+  the job's meta.
+
+  The schedule is shorter than the days the Standard Webhooks specification
+  suggests, because most of these events are telemetry a fleet sends
+  constantly. Days of retries for an endpoint that is down would mean days of
+  its deliveries piling up in the jobs table, for readings that are stale long
+  before they arrive.
+  """
+
+  use Oban.Worker, queue: :webhooks, max_attempts: 3
+
+  alias NervesHub.Webhooks
+  alias NervesHub.Webhooks.Delivery
+
+  @retry_delays_seconds [5, 60, 300, 1800, 7200]
+
+  @impl Oban.Worker
+  def perform(%Oban.Job{args: %{"webhook_id" => webhook_id, "event_id" => event_id, "body" => body}} = job) do
+    case Webhooks.deliverable_webhook(webhook_id) do
+      nil -> {:cancel, "the webhook was deleted or turned off"}
+      webhook -> attempt(webhook, event_id, body, failed_attempts(job))
+    end
+  end
+
+  defp attempt(webhook, event_id, body, failed_attempts) do
+    if Webhooks.cooling_down?(webhook, DateTime.utc_now()) do
+      retry(failed_attempts, "not sent, because the endpoint failed moments ago: #{webhook.last_error}")
+    else
+      case Delivery.deliver(webhook, event_id, body) do
+        {:ok, _status} ->
+          Webhooks.record_success(webhook)
+
+        {:error, status, message} ->
+          case Webhooks.record_failure(webhook, status, message) do
+            :ok -> retry(failed_attempts, message)
+            :disabled -> {:cancel, "the webhook was turned off: #{message}"}
+          end
+      end
+    end
+  end
+
+  defp retry(failed_attempts, _message) when failed_attempts < length(@retry_delays_seconds) do
+    delay = Enum.at(@retry_delays_seconds, failed_attempts)
+
+    {:snooze, delay + :rand.uniform(max(div(delay, 10), 1))}
+  end
+
+  defp retry(failed_attempts, message) do
+    {:cancel, "gave up after #{failed_attempts + 1} attempts: #{message}"}
+  end
+
+  defp failed_attempts(%Oban.Job{meta: meta}), do: Map.get(meta, "snoozed", 0)
+end
