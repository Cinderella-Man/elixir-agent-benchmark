+          section(step_heading(event, data, :mrkdwn)),
+          context([product_name(data), release(data)]),
+          step_actions(event, data)
+        ]
+      end)
+
+    blocks =
+      if more > 0 do
+        blocks ++ [context(["And #{more} more on the deployment groups' pages."])]
+      else
+        blocks
