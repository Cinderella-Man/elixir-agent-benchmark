+      item = media_item_fixture()
+
+      assert {:cancel, "no webhook_url configured"} = Delivery.perform(job(added_payload(item)))
+    end
+  end
+
   test "AE2: a webhook host that is not on the grant is blocked by the gate", %{bypass: bypass} do
