From 4fe8aa97e93576e6266eb6cbcd6f56065f7aae69 Mon Sep 17 00:00:00 2001
From: Jakob Lichterfeld <jakob-lichterfeld@gmx.de>
Date: Fri, 25 Sep 2026 09:40:36 +0200
Subject: [PATCH 4/4] fix(api): fail closed when a URL cannot be redacted, and
 pin that a malformed token response stays out of the log

Error.redact_url/1 returned the raw URL when redacting raised; it now returns "[redacted]". No input raises today.

The auth client's logger sits next to the adapter, after the JSON middleware, so a token response that fails to decode never reaches the log line. A test pins this: with the logger outside the JSON middleware, the decode error would print the tokens.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 elixir/lib/tesla_api/error.ex               |  3 ++-
 elixir/test/tesla_api/auth/refresh_test.exs | 17 +++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/elixir/lib/tesla_api/error.ex b/elixir/lib/tesla_api/error.ex
index c4f8cf9c0b..e65a33f4cd 100644
--- a/elixir/lib/tesla_api/error.ex
+++ b/elixir/lib/tesla_api/error.ex
@@ -84,7 +84,8 @@ defmodule TeslaApi.Error do
         })
     end
   rescue
-    _ -> url
+    # Fails closed: a URL that cannot be redacted is not shown at all.
+    _ -> @redacted
   end
 
   def redact_url(url), do: url
diff --git a/elixir/test/tesla_api/auth/refresh_test.exs b/elixir/test/tesla_api/auth/refresh_test.exs
index cf9d3a73da..3004b1ddab 100644
--- a/elixir/test/tesla_api/auth/refresh_test.exs
+++ b/elixir/test/tesla_api/auth/refresh_test.exs
@@ -171,4 +171,21 @@ defmodule TeslaApi.Auth.RefreshTest do
     assert log =~ "POST https://[redacted]@auth.example"
     assert env.url =~ "https://[redacted]@auth.example"
   end
+
+  # The logger sits next to the adapter, after the JSON middleware, so a body
+  # that fails to decode never reaches the log line.
+  test "keeps the tokens of a malformed token response out of the log and the error" do
+    level = Logger.level()
+    Logger.configure(level: :debug)
+    on_exit(fn -> Logger.configure(level: level) end)
+
+    body = ~s({"access_token":"secret-access","refresh_token":"secret-refresh")
+
+    assert {{:error, %Error{message: "invalid token response"} = error}, log} =
+             refresh(status: 200, headers: [{"content-type", "application/json"}], body: body)
+
+    assert log =~ "-> 200"
+    refute log =~ "secret"
+    refute inspect(error) =~ "secret"
+  end
 end
