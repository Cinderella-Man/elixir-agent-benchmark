From 33e91ff210af0170360e2cb3c69356e49de4718c Mon Sep 17 00:00:00 2001
From: Jakob Lichterfeld <jakob-lichterfeld@gmx.de>
Date: Thu, 24 Sep 2026 18:12:43 +0200
Subject: [PATCH 1/4] fix(auth): keep the tokens out of the log, even on the
 debug level

The auth client's logger printed request and response details on the debug level: the refresh token in the request body, the new access and refresh tokens in the response, and in fleet mode the fleet token in the Authorization header. It now logs only the request line and status.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 elixir/lib/tesla_api/auth.ex                |  4 +++-
 elixir/test/tesla_api/auth/refresh_test.exs | 16 ++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/elixir/lib/tesla_api/auth.ex b/elixir/lib/tesla_api/auth.ex
index 207ccd9bcd..8fc676b046 100644
--- a/elixir/lib/tesla_api/auth.ex
+++ b/elixir/lib/tesla_api/auth.ex
@@ -18,7 +18,9 @@ defmodule TeslaApi.Auth do
         {Tesla.Middleware.Headers, @default_headers},
         Tesla.Middleware.JSON,
         TeslaApi.Middleware.FleetAuth,
-        {Tesla.Middleware.Logger, debug: true, level: &log_level/1}
+        # No request and response details, not even on the debug level: the
+        # request carries the refresh token, the response the new tokens.
+        {Tesla.Middleware.Logger, debug: false, level: &log_level/1}
       ],
       {Tesla.Adapter.Finch, name: TeslaMate.HTTP, receive_timeout: 60_000}
     )
diff --git a/elixir/test/tesla_api/auth/refresh_test.exs b/elixir/test/tesla_api/auth/refresh_test.exs
index 7e094b57dd..de8656d02f 100644
--- a/elixir/test/tesla_api/auth/refresh_test.exs
+++ b/elixir/test/tesla_api/auth/refresh_test.exs
@@ -138,4 +138,20 @@ defmodule TeslaApi.Auth.RefreshTest do
                refresh({:error, %Mint.TransportError{reason: :timeout}})
     end
   end
+
+  test "keeps the tokens out of the log, even on the debug level" do
+    level = Logger.level()
+    Logger.configure(level: :debug)
+    on_exit(fn -> Logger.configure(level: level) end)
+
+    body = %{"access_token" => "new-access", "refresh_token" => "new-refresh", "expires_in" => 1}
+
+    assert {{:ok, %Auth{}}, log} = refresh(status: 200, body: body)
+
+    assert log =~ "-> 200"
+
+    for token <- ["refresh-token", "new-access", "new-refresh"] do
+      refute log =~ token
+    end
+  end
 end

