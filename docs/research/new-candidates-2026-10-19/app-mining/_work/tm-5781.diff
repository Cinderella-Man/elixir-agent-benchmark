-          type: body["token_type"],
-          expires_in: body["expires_in"],
-          refresh_token: body["refresh_token"],
-          created_at: body["created_at"]
-        }
+    "#{issuer_url}/token"
+    |> post(data)
+    |> handle_response(auth)
+  end
+
+  defp handle_response(
+         {:ok,
+          %Tesla.Env{
+            status: 200,
+            body: %{"access_token" => token, "expires_in" => expires_in} = body
+          }},
