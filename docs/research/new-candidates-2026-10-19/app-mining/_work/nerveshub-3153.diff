diff --git a/docs/device_authentication.md b/docs/device_authentication.md
index 71a7c25ee..6d150029a 100644
--- a/docs/device_authentication.md
+++ b/docs/device_authentication.md
@@ -107,3 +107,12 @@ Product keys work differently. Their secrets stay visible on the product's
 settings page to members with the `manage` or `admin` role. Deactivating one
 refuses new connections with it, but devices already connected with it stay
 connected until they reconnect.
+
+## Deleted devices
+
+Deleting a device closes the connection it has open and takes it out of its
+deployment group. It cannot connect again while it is deleted: certificate
+authentication rejects it as described above, its device keys stop
+authenticating, and a product key cannot create a new device under its
+identifier. A restored device is matched to a deployment group again the next
+time it connects.
diff --git a/lib/nerves_hub/devices.ex b/lib/nerves_hub/devices.ex
index 491b0160e..d6d8c3dda 100644
--- a/lib/nerves_hub/devices.ex
+++ b/lib/nerves_hub/devices.ex
@@ -574,6 +574,16 @@ defmodule NervesHub.Devices do
     |> Repo.update!()
   end
 
+  @doc """
+  Soft delete a device, which `restore_device/1` can undo.
+
+  The device leaves its deployment group in the same transaction, and a
+  connection it has open is closed once that commits. Left in the group and
+  connected, it would still be picked by the orchestrator, which cannot penalty
+  box a deleted device and so would pick it again on every run. A restored device
+  is matched to a deployment group again when it next connects, as any device
+  without one is.
+  """
   def delete_device(%Device{} = device) do
     device_certificates_query = from(dc in DeviceCertificate, where: dc.device_id == ^device.id)
     pinned_devices_query = from(p in PinnedDevice, where: p.device_id == ^device.id)
@@ -583,7 +593,10 @@ defmodule NervesHub.Devices do
     # the same hardware collides with the identity of the device just deleted.
     network_identities_query = from(ei in NetworkIdentity, where: ei.device_id == ^device.id)
 
-    changeset = Repo.soft_delete_changeset(device)
+    changeset =
+      device
+      |> Device.clear_deployment_group()
+      |> Repo.soft_delete_changeset()
 
     Multi.new()
     |> Multi.delete_all(:device_certificates, device_certificates_query)
@@ -592,8 +605,12 @@ defmodule NervesHub.Devices do
     |> Multi.update(:device, changeset)
     |> Repo.transact()
     |> case do
-      {:ok, %{device: device}} -> {:ok, device}
-      error -> error
+      {:ok, %{device: device}} ->
+        DeviceEvents.deleted(device)
+        {:ok, %{device | deployment_group: nil}}
+
+      error ->
+        error
     end
   end
 
diff --git a/lib/nerves_hub/events/device_events.ex b/lib/nerves_hub/events/device_events.ex
index d8138a472..5e5c9781e 100644
--- a/lib/nerves_hub/events/device_events.ex
+++ b/lib/nerves_hub/events/device_events.ex
@@ -31,6 +31,21 @@ defmodule NervesHub.DeviceEvents do
   end
 
   def moved_product(device) do
+    disconnect(device)
+  end
+
+  @doc """
+  Closes the connection of a device that has just been deleted.
+
+  It is refused when it tries again: certificate authentication rejects a
+  deleted device, a device key stops authenticating with it, and a product key
+  cannot create a new device under its identifier.
+  """
+  def deleted(device) do
+    disconnect(device)
+  end
+
+  defp disconnect(device) do
     :ok =
       ChannelServer.broadcast(NervesHub.PubSub, "device_socket:#{device.id}", "disconnect", %{})
   end
