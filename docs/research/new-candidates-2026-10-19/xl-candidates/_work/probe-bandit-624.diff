+             ]
+             ~> in_any_order([
+               {:ok, :window_update, term(), 0, term()},
+               {:ok, :headers, term(), 1, term()},
+               {:ok, :data, term(), 1, term()}
+             ])
+    end
+
+    def expect_continue_body_unread(conn), do: send_resp(conn, 200, "")
+  end
