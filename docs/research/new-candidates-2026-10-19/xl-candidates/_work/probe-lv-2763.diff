+  end
+
+  def update(%{action: :renew_canceled}, socket) do
+    {:ok,
+     assign_async(socket, :lc_data, fn ->
+       Process.sleep(100)
+       {:ok, %{lc_data: 123}}
+     end)}
+  end
+end
