diff --git a/priv/eab_prepare_native.sh b/priv/eab_prepare_native.sh
new file mode 100644
--- /dev/null
+++ b/priv/eab_prepare_native.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+set -eu
+# The historical dependency enables an unnecessary, unpinned publishing plugin.
+# Its current package resolver is incompatible with this pinned Rebar release.
+# Keep the C build plugin, pinned to the version verified with OTP 22.3.3.
+config=deps/fast_yaml/rebar.config.script
+sed -i 's/AppendList(\[rebar3_hex, pc\])/AppendList([{pc, "1.15.0"}])/' "$config"
+grep -F 'AppendList([{pc, "1.15.0"}])' "$config" >/dev/null
+# Elixir 1.12 adds Kernel.tap/2. Retain the dependency's original helper
+# binding instead of letting its existing unqualified calls become ambiguous.
+compiler=deps/ex_minimatch/lib/ex_minimatch/compiler.ex
+sed -i 's/|> tap(/|> ExMinimatch.Helper.tap(/g' "$compiler"
+[ "$(grep -c '|> ExMinimatch.Helper.tap(' "$compiler")" = 6 ]
+# These legacy packages list a Markdown documentation renderer without an
+# environment restriction. Their Hex metadata never supplies it at runtime.
+# Restrict that unused declaration so newer Mix does not infer a missing app.
+for manifest in deps/ex_minimatch/mix.exs deps/ex_brace_expansion/mix.exs; do
+  sed -i 's/{:markdown, github: "devinus\/markdown"}/{:markdown, github: "devinus\/markdown", only: :dev}/' "$manifest"
+  grep -F '{:markdown, github: "devinus/markdown", only: :dev}' "$manifest" >/dev/null
+done
+if [ ! -f _build/native/lib/libyaml.a ]; then
+  native_tmp=$(mktemp -d /tmp/eab-yaml.XXXXXX)
+  trap 'rm -rf "$native_tmp"' EXIT
+  git clone --quiet https://github.com/yaml/libyaml.git "$native_tmp/source"
+  git -C "$native_tmp/source" checkout --quiet 2c891fc7a770e8ba2fec34fc6b545c672beb37e6
+  cmake -S "$native_tmp/source" -B "$native_tmp/build" \
+    -DCMAKE_INSTALL_PREFIX=/workspace/_build/native \
+    -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_TESTING=OFF
+  cmake --build "$native_tmp/build" --parallel 2
+  cmake --install "$native_tmp/build"
+fi
